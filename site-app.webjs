const query = (selector, root = document) => root.querySelector(selector);
const queryAll = (selector, root = document) => [...root.querySelectorAll(selector)];
const money = amount => `₹ ${Number(amount || 0).toLocaleString("en-IN", { maximumFractionDigits: 2 })}`;
const safeText = value => String(value ?? "").replace(/[&<>"']/g, char => ({
  "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
})[char]);
const dateText = value => {
  const date = value ? new Date(value) : null;
  return date && !Number.isNaN(date.getTime()) ? date.toLocaleString("en-IN", { dateStyle: "medium", timeStyle: "short" }) : "—";
};
const phonePath = phone => encodeURIComponent(phone);

function dbUrl(path = "") {
  const clean = path.split("/").filter(Boolean).map(encodeURIComponent).join("/");
  return `${firebaseConfig.databaseURL.replace(/\/+$/, "")}/${clean}.json`;
}

function userHistoryRecords(data, bidRecords) {
  const decoded = decodeFirebaseObject(data);
  if (!decoded || typeof decoded !== "object") return [];
  const detailsByKey = new Map();
  const decodedBidRecords = decodeFirebaseObject(bidRecords);
  for (const [date, records] of Object.entries(decodedBidRecords || {})) {
    if (date === "x" || !records || typeof records !== "object") continue;
    for (const [tag, rawValue] of Object.entries(records)) {
      const detail = decodeFirebaseValue(rawValue);
      let payload = detail;
      if (typeof detail === "string") {
        try {
          payload = JSON.parse(detail);
        } catch {
          payload = detail;
        }
      }

      const parts = tag.split("&");
      if (parts.length >= 4) {
        detailsByKey.set(`${date}|${parts[1]}|${parts[2]}`, {
          market: parts[parts.length - 1].split(" : ")[0],
          payload
        });
      }
    }
  }
  const records = [];
  for (const [date, entries] of Object.entries(decoded)) {
    if (date === "x" || !entries || typeof entries !== "object") continue;
    for (const [historyTag, rawValue] of Object.entries(entries)) {
      if (historyTag === "x") continue;
      const value = decodeFirebaseValue(rawValue);
      const parsed = parseLegacyHistoryTag(String(value)) || parseLegacyHistoryTag(historyTag);
      if (!parsed) continue;
      const details = parsed ? detailsByKey.get(`${date}|${parsed.time}|${parsed.selection}`) : null;
      const payload = details?.payload;
      records.push({
        id: `${date}/${historyTag}`,
        date,
        tag: historyTag,
        value,
        payload,
        title: details?.market || "Bid",
        market: details?.market || "",
        gameType: Array.isArray(payload) ? payload[0] : "",
        selection: parsed?.selection || "",
        createdAt: parseLegacyDate(`${date}&${parsed?.time || "00:00:00"}`, date),
        amount: parsed?.amount,
        status: "Recorded"
      });
    }
  }
  return records.sort((left, right) => right.id.localeCompare(left.id));
}

function parseLegacyHistoryTag(tag) {
  const match = tag.match(/^(\d{2}-\d{2}-\d{4}) (\d{1,2}:\d{2}:\d{2}(?:\s+[AP]M)?):([^:]+):"([^"]*)"$/i);
  if (!match) return null;
  const amount = Number(match[3]);
  return {
    time: match[2],
    amount: Number.isFinite(amount) ? amount : undefined,
    selection: match[4]
  };
}

function parseLegacyDate(tag, date) {
  const match = tag.match(/^(\d{2})-(\d{2})-(\d{4})&(\d{1,2}):(\d{2}):(\d{2})(?:\s*(AM|PM))?/i);
  if (match) {
    let hour = Number(match[4]);
    if (match[7]) {
      hour %= 12;
      if (match[7].toUpperCase() === "PM") hour += 12;
    }
    return `${match[3]}-${match[2]}-${match[1]}T${String(hour).padStart(2, "0")}:${match[5]}:${match[6]}`;
  }
  const day = date.match(/^(\d{2})-(\d{2})-(\d{4})$/);
  return day ? `${day[3]}-${day[2]}-${day[1]}` : date;
}

async function dbRequest(method, path, body) {
  const options = { method, headers: {} };
  const controller = new AbortController();
  const timeout = window.setTimeout(() => controller.abort(), 12_000);
  options.signal = controller.signal;
  if (body !== undefined) {
    options.headers["Content-Type"] = "application/json";
    options.body = JSON.stringify(body);
  }
  try {
    const response = await fetch(dbUrl(path), options);
    const raw = await response.text();
    let data = null;
    if (raw) {
      try {
        data = JSON.parse(raw);
      } catch {
        throw new Error("The server returned an unreadable response.");
      }
    }
    if (!response.ok) {
      const reason = data && (data.error || data.message);
      const message = reason ? String(reason) : `HTTP ${response.status}`;
      throw new Error(`Request failed (${response.status}): ${message}`);
    }
    return data;
  } catch (error) {
    if (error?.name === "AbortError") {
      throw new Error(`Request timed out after 12 seconds. Check your connection and try again.`);
    }
    if (error instanceof Error && /^(The server|Request )/.test(error.message)) throw error;
    const reason = error instanceof Error ? error.message : String(error);
    throw new Error(`Could not connect: ${reason}`);
  } finally {
    window.clearTimeout(timeout);
  }
}

const dbGet = path => dbRequest("GET", path);
const dbPut = (path, data) => dbRequest("PUT", path, data);
const dbPatch = (path, data) => dbRequest("PATCH", path, data);
const dbPost = (path, data) => dbRequest("POST", path, data);

function paymentApiRequest(parameters) {
  let endpoint;
  try {
    endpoint = new URL(state.paymentApiUrl);
  } catch {
    return Promise.reject(new Error("The payment service URL is not configured."));
  }
  const isAppsScriptUrl = endpoint.hostname === "script.google.com"
    && /^\/macros\/s\/[^/]+\/exec$/.test(endpoint.pathname);
  const isCloudFunctionUrl = (
    endpoint.hostname.endsWith(".cloudfunctions.net")
    || endpoint.hostname.endsWith(".a.run.app")
  ) && /^\/[A-Za-z][A-Za-z0-9_-]*$/.test(endpoint.pathname);
  const isPhpGatewayUrl = /(?:^|\/)(?:a2-)?payment-api\.php$/i.test(endpoint.pathname);
  if (endpoint.protocol !== "https:" || endpoint.search || endpoint.hash
      || (!isAppsScriptUrl && !isCloudFunctionUrl && !isPhpGatewayUrl)) {
    return Promise.reject(new Error("The configured payment service URL is invalid."));
  }
  return new Promise((resolve, reject) => {
    const callbackName = `__dpboss60Payment_${Date.now()}_${Math.random().toString(36).slice(2)}`;
    const script = document.createElement("script");
    const timeout = window.setTimeout(() => finish(new Error("The payment service did not respond in time.")), 25000);
    const finish = error => {
      window.clearTimeout(timeout);
      delete window[callbackName];
      script.remove();
      if (error) reject(error);
    };
    window[callbackName] = result => {
      finish();
      if (!result || result.ok !== true) {
        reject(new Error(result?.message || "The payment service request failed."));
        return;
      }
      resolve(result);
    };
    endpoint.search = new URLSearchParams({ ...parameters, callback: callbackName }).toString();
    script.src = endpoint.href;
    script.onerror = () => finish(new Error("Could not connect to the payment service."));
    document.head.append(script);
  });
}

function openPaymentViewer(order) {
  const viewer = query("#payment-viewer");
  const frame = query("#payment-viewer-frame");
  if (!viewer || !frame || !/^https:\/\//i.test(order.checkoutUrl)) {
    throw new Error("The secure payment window could not be opened.");
  }
  viewer.dataset.orderId = order.orderId;
  viewer.classList.remove("hidden");
  viewer.setAttribute("aria-hidden", "false");
  document.body.classList.add("payment-viewer-open");
  frame.src = order.checkoutUrl;
  query("[data-action='close-payment-viewer']", viewer)?.focus();
}

function paymentHostMessage(message) {
  const payload = JSON.stringify(message);
  if (window.ReactNativeWebView) {
    window.ReactNativeWebView.postMessage(payload);
  } else if (window.parent !== window) {
    window.parent.postMessage(payload, "*");
  }
}

function hidePaymentViewer(orderId) {
  const viewer = query("#payment-viewer");
  if (!viewer || (orderId && viewer.dataset.orderId !== orderId)) return;
  viewer.classList.add("hidden");
  viewer.setAttribute("aria-hidden", "true");
  document.body.classList.remove("payment-viewer-open");
  query("#payment-viewer-frame")?.removeAttribute("src");
  delete viewer.dataset.orderId;
}

function pendingPaymentKey(phone) {
  return `dpboss60.pendingPayment:${phone}`;
}

function readPendingPayment(phone) {
  const orders = readPendingPayments(phone);
  return orders[orders.length - 1] || null;
}

function readPendingPayments(phone) {
  try {
    const saved = JSON.parse(localStorage.getItem(pendingPaymentKey(phone)) || "null");
    const orders = Array.isArray(saved) ? saved : saved ? [saved] : [];
    return orders.filter(order => order && order.phone === phone && order.orderId && order.pollToken);
  } catch (error) {
    throw new Error(`Could not restore payment status: ${error.message || "Invalid saved order."}`);
  }
}

function savePendingPayment(order) {
  const orders = readPendingPayments(order.phone).filter(item => item.orderId !== order.orderId);
  orders.push(order);
  orders.sort((a, b) => Date.parse(a.createdAt || "") - Date.parse(b.createdAt || ""));
  localStorage.setItem(pendingPaymentKey(order.phone), JSON.stringify(orders));
}

function paymentRetrySeconds(order) {
  const createdAt = Date.parse(order?.createdAt || "");
  if (!Number.isFinite(createdAt)) return 0;
  return Math.max(0, Math.ceil((createdAt + 5_000 - Date.now()) / 1000));
}

function updatePaymentRetryCountdown() {
  queryAll("[data-payment-retry-countdown]").forEach(element => {
    const seconds = paymentRetrySeconds({ createdAt: element.dataset.createdAt });
    element.textContent = seconds ? `00:${String(seconds).padStart(2, "0")}` : "Ready";
    const card = element.closest(".payment-pending-card");
    const button = query("[data-action='retry-pending-payment']", card);
    const form = query("#deposit-form");
    if (button && form) {
      button.disabled = seconds > 0;
      button.textContent = seconds ? `Retry payment in 00:${String(seconds).padStart(2, "0")}` : "Start another payment";
      queryAll("#deposit-form input[name='amount'], #deposit-form [data-amount], #deposit-form button[type='submit']")
        .forEach(control => { control.disabled = seconds > 0; });
    }
  });
}

function clearPendingPayment(order) {
  if (!order?.phone) return;
  const remaining = readPendingPayments(order.phone).filter(item => item.orderId !== order.orderId);
  if (remaining.length) localStorage.setItem(pendingPaymentKey(order.phone), JSON.stringify(remaining));
  else localStorage.removeItem(pendingPaymentKey(order.phone));
}

function closePaymentViewer(check) {
  if (check?.checkoutOpened) hidePaymentViewer(check.orderId);
}

function resumePendingPayment() {
  if (!state.user) return;
  try {
    readPendingPayments(state.user.phone).forEach(order => startPaymentStatusPolling(order, false));
  } catch (error) {
    notify(error.message || "Could not resume payment status.", "error");
  }
}

function startPaymentStatusPolling(order, checkoutOpened) {
  const existingCheck = activePaymentChecks.get(order.orderId);
  if (existingCheck) {
    if (checkoutOpened) {
      existingCheck.checkoutOpened = true;
      openPaymentViewer(order);
    }
    existingCheck.poll?.();
    return;
  }
  const check = {
    orderId: order.orderId,
    startedAt: Date.now(),
    order,
    timer: 0,
    failureNotified: false,
    inFlight: false,
    pollOnCompletion: false,
    creditPendingNotified: false,
    checkoutOpened,
    poll: null
  };
  activePaymentChecks.set(order.orderId, check);
  const poll = async () => {
    if (activePaymentChecks.get(order.orderId) !== check) return;
    if (check.inFlight) {
      check.pollOnCompletion = true;
      return;
    }
    if (Date.now() - check.startedAt >= 30 * 60 * 1000) {
      activePaymentChecks.delete(order.orderId);
      closePaymentViewer(check);
      notify("Payment status could not be confirmed before timeout. No points were added; you can check this payment again later.", "error");
      return;
    }
    check.inFlight = true;
    try {
      const result = await paymentApiRequest({
        action: "status",
        orderId: order.orderId,
        pollToken: order.pollToken
      });
      if (activePaymentChecks.get(order.orderId) !== check) return;
      const status = String(result.status || "PENDING").toUpperCase();
      if (status === "COMPLETED" && result.credited === true) {
        activePaymentChecks.delete(order.orderId);
        clearPendingPayment(order);
        closePaymentViewer(check);
        if (state.user?.phone === order.phone) {
          try {
            await refreshUserData();
            await renderPage();
          } catch (error) {
            notify("Payment was confirmed and credited, but the balance could not refresh. Reopen Wallet or refresh your balance.", "error");
          }
        }
        notify(`Payment successful. ${money(result.amount)} points added successfully.`);
        return;
      }
      if (status === "COMPLETED") {
        order.lastStatus = status;
        order.lastCheckedAt = new Date().toISOString();
        savePendingPayment(order);
        if (!check.creditPendingNotified) {
          check.creditPendingNotified = true;
          notify("The gateway confirmed payment. Verifying the wallet credit now; please keep the app open.", "error");
        }
      }
      if (["FAILED", "FAILURE", "CANCELLED", "CANCELED"].includes(status)) {
        activePaymentChecks.delete(order.orderId);
        clearPendingPayment(order);
        closePaymentViewer(check);
        notify("Payment failed or was cancelled. No points were added.", "error");
        return;
      }
      order.lastStatus = status;
      order.lastCheckedAt = new Date().toISOString();
      savePendingPayment(order);
    } catch (error) {
      if (activePaymentChecks.get(order.orderId) !== check) return;
      if (!check.failureNotified) {
        check.failureNotified = true;
        notify(error.message || "Could not check payment status. Retrying automatically.", "error");
      }
      if (Date.now() - check.startedAt >= 30 * 60 * 1000) {
        activePaymentChecks.delete(order.orderId);
        closePaymentViewer(check);
        notify("Payment status could not be confirmed before timeout. No points were added; you can check this payment again later.", "error");
        return;
      }
    } finally {
      check.inFlight = false;
    }
    if (activePaymentChecks.get(order.orderId) !== check) return;
    const pollImmediately = check.pollOnCompletion;
    check.pollOnCompletion = false;
    check.timer = window.setTimeout(poll, pollImmediately ? 0 : 5000);
  };
  check.poll = poll;
  if (checkoutOpened) {
    try {
      openPaymentViewer(order);
    } catch (error) {
      activePaymentChecks.delete(order.orderId);
      throw error;
    }
  }
  check.timer = window.setTimeout(poll, 1000);
}

function comparableFirebaseValue(value) {
  value = decodeFirebaseValue(value);
  if (Array.isArray(value)) return value.map(comparableFirebaseValue);
  if (value && typeof value === "object") {
    return Object.fromEntries(Object.keys(value).sort().map(key => [key, comparableFirebaseValue(value[key])]));
  }
  return value;
}

async function dbPutAndVerify(path, value) {
  await dbPut(path, value);
  const saved = await dbGet(path);
  if (JSON.stringify(comparableFirebaseValue(saved)) !== JSON.stringify(comparableFirebaseValue(value))) {
    throw new Error(`Could not save the expected value at ${path}. Check the data path and write permission.`);
  }
}

async function dbPatchAndVerify(updates) {
  try {
    await dbPatch("", updates);
  } catch (error) {
    if (/permission denied|unauthorized|forbidden/i.test(error.message)) {
      const paths = Object.keys(updates).map(path => path.replace(/\/\d{10}(?=\/|$)/g, "/<phone>"));
      throw new Error(`The update was denied. Write permission is required for: ${paths.join(", ")}. Check the access rules.`);
    }
    throw error;
  }
  const verification = await Promise.all(Object.entries(updates).map(async ([path, expected]) => {
    const saved = await dbGet(path);
    const matches = JSON.stringify(comparableFirebaseValue(saved)) === JSON.stringify(comparableFirebaseValue(expected));
    return { path, matches };
  }));
  const failed = verification.filter(item => !item.matches);
  if (failed.length) {
    throw new Error(`Could not confirm saving: ${failed.map(item => item.path).join(", ")}. Check data paths and write permissions.`);
  }
}

function notify(message, kind = "success") {
  if (String(message).trim() === "The payment service URL is not configured.") return;
  const toast = document.createElement("div");
  toast.className = `toast ${kind === "error" ? "error" : ""}`;
  toast.textContent = message;
  query("#toast-region").append(toast);
  window.setTimeout(() => toast.remove(), 4300);
}

function showAppDialog(message, options = {}) {
  const kind = String(options.kind || "notice").toLowerCase();
  const title = options.title
    || (kind === "failed" ? "Payment failed"
      : kind === "success" ? "Payment successful"
      : "Please check your entry");
  const kicker = options.kicker
    || (kind === "failed" ? "Sridevi Matka · PAYMENT"
      : kind === "success" ? "Sridevi Matka · WALLET"
      : "Sridevi Matka · NOTICE");
  const icon = options.icon
    || (kind === "failed" ? "✕" : kind === "success" ? "✓" : "!");
  const dialogClass = kind === "failed"
    ? "app-message-dialog payment-result-dialog payment-failed-dialog"
    : kind === "success"
      ? "app-message-dialog payment-result-dialog payment-success-dialog"
      : "app-message-dialog";
  query(".app-message-backdrop")?.remove();
  document.body.insertAdjacentHTML("beforeend", `
    <div class="app-message-backdrop">
      <section class="${dialogClass}" role="alertdialog" aria-modal="true"
        aria-labelledby="app-message-title" aria-describedby="app-message-copy">
        <span class="app-message-icon" aria-hidden="true">${icon}</span>
        <div class="app-message-content">
          <p class="app-message-kicker">${safeText(kicker)}</p>
          <h2 id="app-message-title">${safeText(title)}</h2>
          <p id="app-message-copy">${safeText(message)}</p>
          <button class="button button-primary" type="button" data-action="dismiss-app-message">OK</button>
        </div>
      </section>
    </div>`);
  query(".app-message-dialog button")?.focus({ preventScroll: true });
}

function showBetConfirmation() {
  if (!state.betDraft.length) {
    notify("Add at least one valid number before submitting.", "error");
    return;
  }
  query(".aia-bet-confirm-backdrop")?.remove();
  const total = state.betDraft.reduce((sum, item) => sum + item.amount, 0);
  const market = state.markets.find(item => item.name === state.selectedMarket);
  document.body.insertAdjacentHTML("beforeend", `
    <div class="app-message-backdrop aia-bet-confirm-backdrop">
      <section class="aia-bet-confirm-dialog" role="alertdialog" aria-modal="true"
        aria-labelledby="aia-bet-confirm-title">
        <button class="aia-bet-confirm-close" type="button" data-action="cancel-bet-submit" aria-label="Close">×</button>
        <p class="aia-bet-confirm-kicker">${safeText(market?.name || state.selectedMarket)} · ${safeText(gameDisplayName(state.selectedGame))} · Review your bid details before continuing.</p>
        <h2 id="aia-bet-confirm-title">Please check your entry</h2>
        <div class="aia-bet-confirm-table">
          <div class="aia-bet-confirm-head"><span>${/pana|panel/i.test(state.selectedGame) ? "PANNA" : "DIGIT"}</span><span>TYPE</span><span>POINTS</span></div>
          ${state.betDraft.map(item => `<div class="aia-bet-confirm-row"><strong>${safeText(item.selection)}</strong><span>${safeText(item.session || state.selectedSession).toUpperCase()}</span><strong>${money(item.amount)}</strong></div>`).join("")}
        </div>
        <div class="aia-bet-confirm-total"><span>Total Number of Bids <strong>${state.betDraft.length}</strong></span><span>Grand Total Amount <strong>${money(total)}</strong></span></div>
        <div class="aia-bet-confirm-actions">
          <button class="button-secondary" type="button" data-action="cancel-bet-submit">EDIT BIDS</button>
          <button class="button-primary" type="button" data-action="confirm-bet-submit">CONFIRM &amp; SUBMIT</button>
        </div>
      </section>
    </div>`);
  query(".aia-bet-confirm-dialog [data-action='cancel-bet-submit']")?.focus({ preventScroll: true });
}

function setInlineMessage(id, message, success = false) {
  const element = query(`#${id}`);
  if (!element) return;
  element.textContent = message;
  element.classList.toggle("success", success);
}

function setBusy(button, busy, busyText = "Please wait…") {
  if (!button) return;
  if (busy) {
    button.dataset.originalText = button.innerHTML;
    button.disabled = true;
    button.textContent = busyText;
  } else {
    button.disabled = false;
    if (button.dataset.originalText) button.innerHTML = button.dataset.originalText;
  }
}

function decodeFirebaseValue(value) {
  let decoded = value;
  for (let depth = 0; depth < 2 && typeof decoded === "string"; depth += 1) {
    try {
      const parsed = JSON.parse(decoded);
      if (parsed === decoded) break;
      decoded = parsed;
    } catch {
      break;
    }
  }
  return decoded;
}

function decodeFirebaseObject(value) {
  const decoded = decodeFirebaseValue(value);
  if (!decoded || typeof decoded !== "object" || Array.isArray(decoded)) return decoded;
  return Object.fromEntries(Object.entries(decoded).map(([key, item]) => [key, decodeFirebaseValue(item)]));
}

function showAuth(mode = "login") {
  state.authMode = mode;
  query("#auth-view").classList.remove("hidden");
  query("#language-view").classList.add("hidden");
  query("#auth-screen").classList.remove("hidden");
  query("#app-view").classList.add("hidden");
  query("#auth-form").reset();
  const signingUp = mode === "signup";
  query("#auth-phone").required = true;
  query("#auth-password").required = true;
  query("#auth-password").autocomplete = signingUp ? "new-password" : "current-password";
  query("#auth-name").required = signingUp;
  query("#name-field").classList.toggle("hidden", !signingUp);
  query("#forgot-password-button").classList.toggle("hidden", signingUp);
  queryAll(".auth-tab").forEach(tab => tab.classList.toggle("active", tab.dataset.authMode === mode));
  query("#auth-submit").innerHTML = signingUp
    ? "Create account <span aria-hidden=\"true\">→</span>"
    : "Sign in <span aria-hidden=\"true\">→</span>";
  query("#auth-consent-checkbox").checked = true;
  applyAuthCopy();
}

function currentAuthCopy() {
  return AUTH_COPY[state.language] || AUTH_COPY.en;
}

function applyAuthCopy() {
  const copy = currentAuthCopy();
  const signingUp = state.authMode === "signup";
  query("#language-title").textContent = copy.choose;
  query("#language-description").textContent = copy.chooseHint;
  query("#language-continue").innerHTML = `${copy.continue} <span aria-hidden="true">→</span>`;
  query("#auth-title").textContent = signingUp
    ? "Create your account"
    : WELCOME_BACK_COPY[state.language] || WELCOME_BACK_COPY.en;
  query("#auth-subtitle").textContent = signingUp
    ? "Enter your details to set up your Sridevi Matka account."
    : "Sign in with your phone number and password.";
  query("#auth-phone-label").textContent = copy.phone;
  query("#auth-phone").placeholder = copy.phonePlaceholder;
  query("#auth-name-label").textContent = copy.name;
  query("#auth-name").placeholder = copy.namePlaceholder;
  query("#auth-password").placeholder = "At least 8 characters";
  query("#auth-consent-prefix").textContent = copy.agreeBefore;
  query("#auth-consent-suffix").textContent = copy.agreeAfter;
  query(".inline-policy-link").textContent = copy.policy;
  query(".auth-help-link").textContent = copy.help;
  query("#auth-security-copy").textContent = copy.security;
  query("#auth-footer-copy").textContent = "Trusted by thousands of players";
}

function renderLanguageOptions() {
  const selected = SUPPORTED_LANGUAGES.some(([code]) => code === state.language) ? state.language : "en";
  query("#language-options").innerHTML = SUPPORTED_LANGUAGES.map(([code, nativeName, englishName]) => `
    <button class="language-option ${code === selected ? "selected" : ""}" type="button"
      role="radio" aria-checked="${code === selected}" data-language-select="${code}">
      <span class="language-radio" aria-hidden="true"></span>
      <span class="language-option-copy"><strong lang="${code}">${safeText(nativeName)}</strong><small>${safeText(englishName)}</small></span>
    </button>`).join("");
}

function showLanguagePicker() {
  const saved = localStorage.getItem("madhur555Language");
  state.language = SUPPORTED_LANGUAGES.some(([code]) => code === saved) ? saved : "en";
  query("#auth-view").classList.remove("hidden");
  query("#app-view").classList.add("hidden");
  query("#language-view").classList.remove("hidden");
  query("#auth-screen").classList.add("hidden");
  applyAuthCopy();
  renderLanguageOptions();
}

function applyLanguage(language) {
  state.language = SUPPORTED_LANGUAGES.some(([code]) => code === language) ? language : "en";
  document.documentElement.lang = state.language;
  document.documentElement.dir = ["ks", "sd", "ur"].includes(state.language) ? "rtl" : "ltr";
  applyAuthCopy();
  renderLanguageOptions();
}

async function completeLanguageSetup() {
  localStorage.setItem("madhur555Language", state.language);
  query("#language-view").classList.add("hidden");
  if (sharedUserSession) {
    try {
      const ensured = await ensureDeepLinkUserProfile(sharedUserSession);
      state.user = { phone: ensured.phone, name: ensured.name };
      localStorage.setItem("madhur555User", JSON.stringify(state.user));
      await enterApp(true);
    } catch (error) {
      notify(error.message || "Could not open the shared account.", "error");
      showAuth("login");
    }
    return;
  }
  if (restoreSession()) {
    await enterApp(true);
    return;
  }
  showAuth("login");
}

function openAuthPolicy() {
  query(".auth-policy-backdrop")?.remove();
  const copy = currentAuthCopy();
  document.body.insertAdjacentHTML("beforeend", `
    <div class="auth-policy-backdrop" role="presentation">
      <section class="auth-policy-dialog" role="dialog" aria-modal="true" aria-labelledby="auth-policy-title">
        <header><h2 id="auth-policy-title">${safeText(copy.policy)}</h2><button type="button" data-action="close-auth-policy" aria-label="Close">×</button></header>
        <div class="auth-policy-content" tabindex="0">
          <h3>1. Eligibility and responsible access</h3>
          <p>This service is intended only for adults aged 18 or older. You are responsible for confirming that access and use are permitted where you live. Do not use the service where prohibited by local law.</p>
          <h3>2. Information and account security</h3>
          <p>We use the mobile number and account details you provide to verify access, maintain your account, respond to support requests, and protect the service. Tell us if you believe someone has accessed your account.</p>
          <h3>3. Data handling</h3>
          <p>Account information is stored and processed to operate the service. Infrastructure and communications providers may process information on our behalf. We do not publish your phone number. Information may be retained when needed for security, legal, or operational purposes.</p>
          <h3>4. Service and account use</h3>
          <p>Use the application lawfully and provide accurate information. We may restrict access to protect users, comply with legal requirements, or address misuse. Published information may change and should be checked in the application.</p>
          <h3>5. Questions and updates</h3>
          <p>This notice may be updated as the service changes. For questions about your account or personal information, contact Sridevi Matka support through the contact option in the application.</p>
        </div>
        <button class="auth-policy-agree" type="button" data-action="close-auth-policy">${safeText(copy.continue)}</button>
      </section>
    </div>`);
  query(".auth-policy-agree")?.focus({ preventScroll: true });
}

function openWhatsApp(message = "") {
  const configured = String(decodeFirebaseValue(state.contactUrl) || "").trim();
  if (!configured) throw new Error("A WhatsApp contact link has not been configured.");
  let contact;
  try {
    contact = new URL(configured);
  } catch {
    throw new Error("The configured WhatsApp contact link is invalid.");
  }
  if (!["https:", "http:"].includes(contact.protocol)) {
    throw new Error("The configured WhatsApp contact link is not valid.");
  }
  const number = whatsappNumberFromUrl(contact);
  if (!number) throw new Error("The configured WhatsApp contact link does not contain a phone number.");
  const whatsappNumber = number.length === 10 ? `91${number}` : number;
  const url = new URL(`https://wa.me/${whatsappNumber}`);
  if (message) url.searchParams.set("text", message);
  openExternalUrl(url.href, "WhatsApp");
}

function whatsappNumberFromUrl(url) {
  return url.pathname.match(/(?:send\/)?(\d{8,15})/)?.[1] ||
    url.searchParams.get("phone")?.replace(/\D/g, "") || "";
}

function formatContactNumber(number) {
  const digits = String(number || "").replace(/\D/g, "");
  if (digits.length === 10) {
    return { local: digits, international: `+91 ${digits}`, tel: `+91${digits}` };
  }
  if (digits.length === 12 && digits.startsWith("91")) {
    return { local: digits.slice(2), international: `+91 ${digits.slice(2)}`, tel: `+${digits}` };
  }
  return { local: digits, international: `+${digits}`, tel: `+${digits}` };
}

function configuredSupportContact() {
  const configured = String(decodeFirebaseValue(state.contactUrl) || "").trim();
  if (!configured) return null;
  let url;
  try {
    url = new URL(configured);
  } catch {
    return null;
  }
  if (!["https:", "http:"].includes(url.protocol)) return null;
  const number = whatsappNumberFromUrl(url);
  return number ? formatContactNumber(number) : null;
}

function safeExternalUrl(value, label) {
  let raw = String(decodeFirebaseValue(value) || "").trim();
  if (!raw) throw new Error(`A ${label} link has not been configured.`);
  if (!/^[a-z][a-z\d+.-]*:/i.test(raw)) raw = `https://${raw.replace(/^\/+/, "")}`;
  let url;
  try {
    url = new URL(raw);
  } catch {
    throw new Error(`The configured ${label} link is invalid.`);
  }
  if (!["https:", "http:"].includes(url.protocol)) {
    throw new Error(`The configured ${label} link is not valid.`);
  }
  return url.href;
}

function isConfiguredExternalUrl(value) {
  try {
    safeExternalUrl(value, "support");
    return true;
  } catch {
    return false;
  }
}

function paymentQrSource() {
  const raw = state.paymentQrCode;
  if (/^data:image\/(?:png|jpeg|webp);base64,/i.test(raw)) return raw;
  return safeExternalUrl(raw, "payment QR code");
}

function openResultsWebsite() {
  state.webViewerTitle = "Results";
  state.webViewerUrl = safeExternalUrl(state.websiteUrl || DEFAULT_WEBSITE_URL, "website");
  setPage("webviewer");
}

function openMatkaViewer(name, configuredUrl) {
  const phone = String(state.user?.phone || "").replace(/\D/g, "");
  if (!phone) throw new Error(`Sign in with your phone number to open ${name}.`);
  const url = new URL(safeExternalUrl(configuredUrl, `${name} website`));
  url.searchParams.set("phone", phone);
  state.webViewerTitle = name;
  state.webViewerUrl = url.href;
  setPage("webviewer");
}

function openMarketResult(marketName) {
  state.selectedPanelMarket = marketName;
  state.panelResults = {};
  state.panelResultsError = "";
  setPage("panel-chart");
  void loadPanelChartResults(marketName);
}

async function loadPanelChartResults(marketName) {
  state.panelResultsLoading = true;
  state.panelResultsError = "";
  await renderPage();
  try {
    const marketKey = dbKey(marketName);
    const response = await fetch(`${EXPERT_GUESSING_DATABASE_URL}/results/${encodeURIComponent(marketKey)}.json`);
    if (!response.ok) {
      if (response.status === 401 || response.status === 403) {
        throw new Error(`Firebase denied read access to this panel chart (HTTP ${response.status}). Allow reads for /results/${marketKey} in the web-result database rules.`);
      }
      throw new Error(`Firebase returned HTTP ${response.status}.`);
    }
    const results = await response.json();
    if (results !== null && (typeof results !== "object" || Array.isArray(results))) {
      throw new Error("The Firebase result data has an unexpected format.");
    }
    if (state.page !== "panel-chart" || state.selectedPanelMarket !== marketName) return;
    state.panelResults = results || {};
  } catch (error) {
    if (state.page !== "panel-chart" || state.selectedPanelMarket !== marketName) return;
    state.panelResultsError = error.message || "Could not load panel results.";
    notify(state.panelResultsError, "error");
  } finally {
    if (state.page === "panel-chart" && state.selectedPanelMarket === marketName) {
      state.panelResultsLoading = false;
      await renderPage();
    }
  }
}

function openExternalUrl(value, label) {
  const url = safeExternalUrl(value, label);
  const opened = window.open(url, "_blank");
  if (!opened) throw new Error(`The ${label} link was blocked by your browser.`);
  opened.opener = null;
}

function applyAdminSettings(value) {
  const settings = decodeFirebaseObject(value) || {};
  state.signUpBonus = Number(decodeFirebaseValue(settings["Sign Up Bonus"]) || 0);
  state.paymentQrCode = String(decodeFirebaseValue(settings["Qr Code"] ?? settings.qr_code) || "").trim();
  state.paymentUpiTemplate = String(decodeFirebaseValue(settings["Admin Upi"] ?? settings.admin_upi) || "").trim();
  state.paymentUpiId = String(decodeFirebaseValue(settings.upi_id) || "").trim();
  if (!state.paymentUpiId && state.paymentUpiTemplate) {
    try {
      state.paymentUpiId = new URL(state.paymentUpiTemplate.replace(/###/g, "1")).searchParams.get("pa") || "";
    } catch {
      state.paymentUpiId = "";
    }
  }
  state.paymentApiUrl = String(decodeFirebaseValue(settings.payment_api_url) || "").trim();
  const settingEnabled = (value, fallback) => value === undefined || value === null
    ? fallback
    : /^(true|1|yes|on)$/i.test(String(decodeFirebaseValue(value)));
  // Prefer explicit DirectPaymentEnabled; fall back to legacy "pay request or direct" (1 = direct UPI).
  const payModeRaw = decodeFirebaseValue(settings["pay request or direct"] ?? settings.pay_request_or_direct);
  const legacyDirect = payModeRaw !== undefined && payModeRaw !== null
    && /^(1|direct|upi)$/i.test(String(payModeRaw).trim());
  state.paymentDirectEnabled = settingEnabled(settings.DirectPaymentEnabled, legacyDirect);
  state.paymentGatewayEnabled = settingEnabled(settings.PaymentGatewayEnabled, Boolean(state.paymentApiUrl));
  state.paymentQrEnabled = settingEnabled(settings.QrCodeEnabled, !state.paymentDirectEnabled);
  const minimumDeposit = Number(decodeFirebaseValue(settings.MD) || 0);
  state.paymentMinimumDeposit = Number.isFinite(minimumDeposit) ? Math.max(0, minimumDeposit) : 0;
  state.paymentMessage = String(decodeFirebaseValue(settings["Upi Msg"]) || "").trim();
  const minimumEntry = Number(decodeFirebaseValue(settings["Min Entry"]) || 0);
  const maximumEntry = Number(decodeFirebaseValue(settings["Max Entry"]) || 0);
  state.minimumEntry = Number.isFinite(minimumEntry) ? Math.max(0, minimumEntry) : 0;
  state.maximumEntry = Number.isFinite(maximumEntry) ? Math.max(0, maximumEntry) : 0;
  const minimumWithdrawal = Number(decodeFirebaseValue(settings.MW) || 0);
  state.minimumWithdrawal = Number.isFinite(minimumWithdrawal) ? Math.max(0, minimumWithdrawal) : 0;
  state.withdrawTiming = String(decodeFirebaseValue(settings["Withdraw Timing"]) || "").trim();
  state.withdrawalWindows = normalizeWithdrawalWindows(settings.WRTiming);
  state.maintenance = /^(true|1|yes|on)$/i.test(String(decodeFirebaseValue(settings.Maintanance) || ""));
  state.newRegistrations = settings.EnableNewRegistrations === undefined
    ? true : /^(true|1|yes|on)$/i.test(String(decodeFirebaseValue(settings.EnableNewRegistrations)));
  state.openBets = settings.EnableOpenBets === undefined
    ? true : /^(true|1|yes|on)$/i.test(String(decodeFirebaseValue(settings.EnableOpenBets)));
  state.closeBets = settings.EnableCloseBets === undefined
    ? true : /^(true|1|yes|on)$/i.test(String(decodeFirebaseValue(settings.EnableCloseBets)));
  const policy = decodeFirebaseValue(settings.Policy);
  state.policy = Array.isArray(policy) ? policy.join("\n\n") : String(policy || "");
  state.websiteUrl = String(decodeFirebaseValue(settings.Website) || "").trim() || DEFAULT_WEBSITE_URL;
  state.matka60Url = String(decodeFirebaseValue(settings.matka60url) || "").trim();
  state.matka30Url = String(decodeFirebaseValue(settings.matka30url) || "").trim();
  state.contactUrl = String(decodeFirebaseValue(settings.Contact) || "").trim();
  state.telegramUrl = String(
    decodeFirebaseValue(settings.Telegram) ||
    decodeFirebaseValue(settings.TG) ||
    ""
  ).trim();
  state.whatsappGroupUrl = String(
    decodeFirebaseValue(settings["WhatsApp Group"]) ||
    decodeFirebaseValue(settings.WhatsAppGroup) ||
    ""
  ).trim();
}

function normalizeWithdrawalWindows(value) {
  const decoded = decodeFirebaseObject(value) || {};
  const normalizeTime = time => {
    const match = String(decodeFirebaseValue(time) || "").trim()
      .match(/^(\d{1,2}):(\d{2})(?::\d{2})?\s*(AM|PM)?$/i);
    if (!match) return "";
    let hour = Number(match[1]);
    const minute = Number(match[2]);
    if (minute > 59) return "";
    if (match[3]) {
      if (hour < 1 || hour > 12) return "";
      hour %= 12;
      if (match[3].toUpperCase() === "PM") hour += 12;
    } else if (hour > 23) return "";
    return `${String(hour).padStart(2, "0")}:${String(minute).padStart(2, "0")}`;
  };
  const normalizeWindow = (period, openKey, closeKey) => {
    const item = decodeFirebaseObject(decoded[period]) || {};
    return {
      open: normalizeTime(item.open ?? decoded[openKey]),
      close: normalizeTime(item.close ?? decoded[closeKey])
    };
  };
  const windows = {
    morning: normalizeWindow("morning", "morningOpen", "morningClose"),
    evening: normalizeWindow("evening", "eveningOpen", "eveningClose")
  };
  return Object.values(windows).some(window => !window.open || !window.close)
    ? DEFAULT_WITHDRAWAL_WINDOWS : windows;
}

function normalizeExpertGuessing(value) {
  const decoded = decodeFirebaseValue(value);
  if (!decoded || typeof decoded !== "object" || Array.isArray(decoded)) return {};
  return Object.fromEntries(Object.entries(decoded).map(([market, rawGuess]) => {
    const guess = decodeFirebaseValue(rawGuess);
    if (!guess || typeof guess !== "object" || Array.isArray(guess)) return [market, null];
    const displayValue = raw => {
      const value = decodeFirebaseValue(raw);
      if (Array.isArray(value)) return value.map(item => String(decodeFirebaseValue(item) ?? "").trim()).filter(Boolean).join(" - ");
      if (value && typeof value === "object" && Object.keys(value).every(key => /^\d+$/.test(key))) {
        return Object.entries(value).sort(([left], [right]) => Number(left) - Number(right))
          .map(([, item]) => String(decodeFirebaseValue(item) ?? "").trim()).filter(Boolean).join(" - ");
      }
      return String(value || "").trim();
    };
    return [market, {
      marketName: String(decodeFirebaseValue(guess.marketName) || market),
      ank: displayValue(guess.ANK ?? guess.ank),
      jodi: displayValue(guess.JODI ?? guess.jodi),
      panna: displayValue(guess.PANNA ?? guess.panna)
    }];
  }).filter(([, guess]) => guess));
}

async function loadExpertGuessing(force = false) {
  if (!force && state.expertGuessingLoadedAt && Date.now() - state.expertGuessingLoadedAt < 30_000) return;
  state.expertGuessingLoading = true;
  state.expertGuessingError = "";
  try {
    const response = await fetch(`${EXPERT_GUESSING_DATABASE_URL}/ExpertGuessing.json`, {
      cache: "no-store"
    });
    if (!response.ok) throw new Error(`Expert numbers could not be loaded (HTTP ${response.status}).`);
    state.expertGuessing = normalizeExpertGuessing(await response.json());
    state.expertGuessingLoadedAt = Date.now();
  } catch (error) {
    state.expertGuessingError = error.message || "Expert numbers could not be loaded.";
    throw error;
  } finally {
    state.expertGuessingLoading = false;
  }
}

function isBlockedValue(value) {
  const decoded = decodeFirebaseValue(value);
  return decoded !== null && decoded !== undefined && decoded !== false && decoded !== 0
    && !/^(false|0|no|off|x)?$/i.test(String(decoded).trim());
}

async function loadAdminSettings() {
  applyAdminSettings(await dbGet(DATABASE_ROOTS.settings));
  await renderPage();
}

async function configuredSignUpBonus() {
  const settings = decodeFirebaseObject(await dbGet(DATABASE_ROOTS.settings)) || {};
  const rawBonus = settings.bonus ?? settings.Bonus ?? settings["Sign Up Bonus"] ?? 0;
  const bonus = Number(decodeFirebaseValue(rawBonus));
  if (!Number.isFinite(bonus) || bonus < 0) {
    throw new Error("The configured signup bonus is not a valid non-negative amount.");
  }
  return bonus;
}

async function ensureUserBalance(profilePath) {
  if (!window.firebase?.database) {
    throw new Error("The account balance could not be initialized because the service is unavailable.");
  }
  const balanceRef = firebase.database().ref(`${profilePath}/bal`);
  const existingBalance = await balanceRef.once("value");
  if (existingBalance.exists()) return decodeFirebaseValue(existingBalance.val());

  const bonus = await configuredSignUpBonus();
  const result = await balanceRef.transaction(current => current === null ? bonus : undefined);
  return decodeFirebaseValue(result.snapshot.val());
}

async function changePassword(event) {
  event.preventDefault();
  if (!state.user) {
    notify("Sign in before changing your password.", "error");
    return;
  }
  const form = event.currentTarget;
  const values = new FormData(form);
  const currentPassword = String(values.get("currentPassword") || "");
  const newPassword = String(values.get("newPassword") || "");
  const confirmPassword = String(values.get("confirmPassword") || "");
  if (newPassword.length < 8) {
    notify("New password must be at least 8 characters.", "error");
    return;
  }
  if (newPassword !== confirmPassword) {
    notify("The new passwords do not match.", "error");
    return;
  }
  const button = form.querySelector('button[type="submit"]');
  setBusy(button, true, "Updating…");
  try {
    const passwordPath = `${DATABASE_ROOTS.users}/${phonePath(state.user.phone)}/password`;
    const record = decodeFirebaseObject(await dbGet(`${DATABASE_ROOTS.users}/${phonePath(state.user.phone)}`));
    if (!record || String(record.password ?? "") !== currentPassword) {
      throw new Error("Current password is incorrect.");
    }
    await dbPutAndVerify(passwordPath, JSON.stringify(newPassword));
    form.reset();
    notify("Password updated.");
  } catch (error) {
    notify(error.message || "Unable to update your password.", "error");
  } finally {
    setBusy(button, false);
  }
}

async function submitAuth(event) {
  event.preventDefault();
  const button = query("#auth-submit");
  const phone = query("#auth-phone").value.replace(/\D/g, "");
  const password = query("#auth-password").value;
  const name = query("#auth-name").value.trim();
  const signingUp = state.authMode === "signup";
  if (!query("#auth-consent-checkbox").checked) {
    notify("Please confirm that you agree to the policy and are 18 or older.", "error");
    return;
  }
  if (!/^\d{10}$/.test(phone)) {
    notify("Enter a valid 10-digit phone number.", "error");
    return;
  }
  if (password.length < 8) {
    notify("Password must be at least 8 characters.", "error");
    return;
  }
  if (signingUp && name.length < 2) {
    notify("Enter your name to create an account.", "error");
    return;
  }
  setBusy(button, true, signingUp ? "Creating account…" : "Signing in…");
  try {
    if (signingUp) {
      await loadAdminSettings();
      if (state.maintenance) throw new Error("New accounts and bidding are unavailable during maintenance.");
      if (!state.newRegistrations) throw new Error("New player registrations are currently closed.");
    }
    const recordPath = `${DATABASE_ROOTS.users}/${phone}`;
    const record = decodeFirebaseObject(await dbGet(recordPath));
    const blocked = isBlockedValue(record?.blocked)
      || isBlockedValue(await dbGet(`Blocked/${phone}`));
    if (blocked) throw new Error("This account has been blocked. Contact support for help.");
    if (signingUp) {
      if (record) throw new Error("An account with this phone number already exists. Sign in instead.");
      const bonus = await dbGet(`${DATABASE_ROOTS.settings}/Sign Up Bonus`);
      state.signUpBonus = Number(decodeFirebaseValue(bonus) || 0);
      const joinedAt = marketNow();
      const joinedDate = `${String(joinedAt.getDate()).padStart(2, "0")}-${String(joinedAt.getMonth() + 1).padStart(2, "0")}-${joinedAt.getFullYear()}`;
      await dbPatchAndVerify({
        [recordPath]: {
          name: JSON.stringify(name),
          password: JSON.stringify(password),
          bal: state.signUpBonus,
          B2: "0",
          TD: "0",
          TW: "0",
          "Last Seen": new Date().toISOString(),
          push: "",
          blocked: "no"
        },
        [`${DATABASE_ROOTS.newUsers}/${joinedDate}/${phone}`]: name
      });
      state.user = { phone, name };
      localStorage.setItem("madhur555User", JSON.stringify(state.user));
      await enterApp();
      notify("Your account is ready.");
      return;
    }
    if (!record || typeof record !== "object" || String(record.password ?? "") !== password) {
      throw new Error("Phone number or password is incorrect.");
    }
    state.user = { phone, name: String(record.name || "Player") };
    localStorage.setItem("madhur555User", JSON.stringify(state.user));
    await enterApp();
    notify(`Welcome back, ${state.user.name}.`);
  } catch (error) {
    notify(error.message || "Unable to access your account.", "error");
  } finally {
    setBusy(button, false);
  }
}

function restoreSession() {
  try {
    const user = JSON.parse(localStorage.getItem("madhur555User") || "null");
    if (user && /^\d{10}$/.test(user.phone) && typeof user.name === "string") {
      state.user = user;
      return true;
    }
  } catch {
    localStorage.removeItem("madhur555User");
  }
  return false;
}

function getSharedSessionFromUrl() {
  const params = new URLSearchParams(window.location.search);
  const name = String(params.get("name") || params.get("fullname") || params.get("user") || "").trim();
  const rawPhone = params.get("phone") || params.get("mobile") || params.get("number") || "";
  const phone = String(rawPhone).replace(/\D/g, "");
  const coins = String(params.get("coins") || "").trim();
  const ls = String(params.get("ls") || "").trim();
  const push = String(params.get("push") || "").trim();
  if (!/^\d{10}$/.test(phone) || !/^\d+$/.test(coins)) {
    return null;
  }
  return { phone, name, coins, ls, push };
}

/** Ensure DATA/{phone} exists — create Sridevi profile shape if missing. */
async function ensureDeepLinkUserProfile(session) {
  const phone = session.phone;
  const profilePath = `${DATABASE_ROOTS.users}/${phonePath(phone)}`;
  const existing = decodeFirebaseObject(await dbGet(profilePath));
  if (existing && typeof existing === "object") {
    const blocked = isBlockedValue(existing.blocked)
      || isBlockedValue(await dbGet(`Blocked/${phonePath(phone)}`));
    if (blocked) throw new Error("This account has been blocked. Contact support for help.");
    const updates = {};
    const currentName = String(decodeFirebaseValue(existing.name) || "").trim();
    if (session.name && currentName !== session.name) {
      updates[`${profilePath}/name`] = JSON.stringify(session.name);
    }
    if (existing.COINS === undefined) {
      updates[`${profilePath}/COINS`] = session.coins;
    }
    if (session.ls && existing.LS === undefined) {
      updates[`${profilePath}/LS`] = session.ls;
    }
    if (session.push && existing.push === undefined) {
      updates[`${profilePath}/push`] = session.push;
    }
    if (Object.keys(updates).length) await dbPatchAndVerify(updates);
    return { phone, name: session.name || currentName || phone, created: false };
  }

  const profileName = session.name || phone;
  let bonus = 10;
  try {
    const raw = await dbGet(`${DATABASE_ROOTS.settings}/Sign Up Bonus`);
    const n = Number(decodeFirebaseValue(raw) || 0);
    if (Number.isFinite(n) && n >= 0) bonus = n;
  } catch { /* keep 10 */ }

  const profile = {
    B2: "0",
    COINS: session.coins,
    LS: session.ls,
    TD: "0",
    TW: "0",
    bal: bonus,
    name: JSON.stringify(profileName),
    password: JSON.stringify("11111111"),
    push: session.push,
    blocked: "no",
    "Last Seen": new Date().toISOString()
  };
  const now = new Date();
  const joinedDate = `${String(now.getDate()).padStart(2, "0")}-${String(now.getMonth() + 1).padStart(2, "0")}-${now.getFullYear()}`;
  await dbPatchAndVerify({
    [profilePath]: profile,
    [`${DATABASE_ROOTS.newUsers}/${joinedDate}/${phone}`]: profileName
  });
  return { phone, name: profileName, created: true };
}

function logout() {
  activePaymentChecks.forEach(check => {
    window.clearTimeout(check.timer);
    closePaymentViewer(check);
  });
  activePaymentChecks.clear();
  pageHistory.length = 0;
  if (state.user?.phone) {
    void dbPut(`${DATABASE_ROOTS.users}/${phonePath(state.user.phone)}/push`, null)
      .catch(error => console.error("Could not clear the signed-out device's push subscription.", error));
  }
  window.ReactNativeWebView?.postMessage(JSON.stringify({ type: "onesignal-logout" }));
  stopRealtimeSubscriptions();
  state.user = null;
  state.page = "home";
  state.balance = 0;
  state.balancePath = "";
  state.demoBalance = 0;
  state.demoTransactions = [];
  state.demoPaymentInFlight = false;
  state.accountBlocked = false;
  state.accountBlocked = false;
  state.bids = [];
  state.accountTransactions = [];
  state.pointsHistory = [];
  state.depositHistory = [];
  state.withdrawalHistory = [];
  localStorage.removeItem("madhur555User");
  showAuth("login");
  query("#sidebar").classList.remove("open");
}

async function enterApp(verifyRestoredAccount = false) {
  if (!state.user) return;
  if (verifyRestoredAccount) {
    const phone = state.user.phone;
    try {
      const profile = decodeFirebaseObject(await dbGet(`${DATABASE_ROOTS.users}/${phonePath(phone)}`)) || {};
      const blocked = isBlockedValue(profile.blocked)
        || isBlockedValue(await dbGet(`Blocked/${phonePath(phone)}`));
      if (!state.user || state.user.phone !== phone) return;
      if (blocked) {
        state.accountBlocked = true;
        logout();
        notify("This account has been blocked. Contact support for help.", "error");
        return;
      }
    } catch (error) {
      logout();
      notify(error.message || "Could not verify account access.", "error");
      return;
    }
  }
  window.ReactNativeWebView?.postMessage(JSON.stringify({
    type: "onesignal-login",
    phone: state.user.phone
  }));
  stopRealtimeSubscriptions();
  state.page = "home";
  pageHistory.length = 0;
  state.balance = 0;
  state.balancePath = "";
  state.demoBalance = 0;
  state.demoTransactions = [];
  state.demoPaymentInFlight = false;
  state.accountBlocked = false;
  state.bids = [];
  state.accountTransactions = [];
  state.pointsHistory = [];
  state.depositHistory = [];
  state.withdrawalHistory = [];
  query("#auth-view").classList.add("hidden");
  query("#app-view").classList.remove("hidden");
  query("#sidebar").classList.remove("open");
  query("#drawer-scrim").classList.remove("visible");
  query("#exit-dialog")?.classList.add("hidden");
  query("#current-year").textContent = new Date().getFullYear();
  query("#header-name").textContent = state.user.name;
  query("#header-avatar").textContent = state.user.name.trim().charAt(0).toUpperCase() || "K";
  void recordLastSeen().catch(error => notify(error.message || "Could not update your last seen time.", "error"));
  resumePendingPayment();
  await renderPage();
  startRealtimeSubscriptions();
  const phone = state.user.phone;
  void Promise.allSettled([refreshUserData(), loadGlobalData()]).then(async outcomes => {
    if (!state.user || state.user.phone !== phone) return;
    for (const outcome of outcomes) {
      if (outcome.status === "rejected") {
        notify(outcome.reason?.message || "Could not load app data.", "error");
      }
    }
    syncMarketBucketSubscription();
    await renderPage();
  });
}

window.__madhur555NativePushId = async (phoneValue, subscriptionValue) => {
  const phone = String(phoneValue || "").replace(/\D/g, "");
  const subscriptionId = String(subscriptionValue || "").trim();
  if (
    !/^\d{10}$/.test(phone)
    || state.user?.phone !== phone
    || (subscriptionId && !/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i.test(subscriptionId))
  ) return;
  try {
    await dbPut(`${DATABASE_ROOTS.users}/${phonePath(phone)}/push`, subscriptionId || null);
  } catch (error) {
    notify(error.message || "Could not save this device's push notification subscription.", "error");
  }
};

async function recordLastSeen() {
  if (!state.user) return;
  await dbPut(`${DATABASE_ROOTS.users}/${phonePath(state.user.phone)}/Last Seen`, new Date().toISOString());
}

async function refreshUserData() {
  if (!state.user) return;
  const phoneNumber = state.user.phone;
  const phone = phonePath(phoneNumber);
  const profilePath = `${DATABASE_ROOTS.users}/${phone}`;
  const profile = decodeFirebaseObject(await dbGet(profilePath));
  if (!state.user || state.user.phone !== phoneNumber) return;
  if (profile && profile.name && profile.name !== state.user.name) {
    state.user.name = profile.name;
    localStorage.setItem("madhur555User", JSON.stringify(state.user));
    query("#header-name").textContent = profile.name;
    query("#header-avatar").textContent = profile.name.trim().charAt(0).toUpperCase() || "K";
  }
  state.balancePath = `${profilePath}/bal`;
  const balance = await ensureUserBalance(profilePath);
  if (!state.user || state.user.phone !== phoneNumber) return;
  state.balance = Number(decodeFirebaseValue(balance) ?? 0) || 0;
  const demoWallet = decodeFirebaseObject(profile?.demoWallet) || {};
  state.demoBalance = Number(decodeFirebaseValue(demoWallet.balance) ?? 0) || 0;
  state.demoTransactions = normalizeDemoTransactions(demoWallet.transactions);
  const [bids, bidRecords, transactions] = await Promise.all([
    dbGet(`${DATABASE_ROOTS.bidHistory}/${phone}`),
    dbGet(`${DATABASE_ROOTS.bidRecords}/${phone}`),
    dbGet(`${DATABASE_ROOTS.users}/${phone}/transactions`)
  ]);
  if (!state.user || state.user.phone !== phoneNumber) return;
  state.bids = userHistoryRecords(bids, bidRecords);
  state.accountTransactions = normalizeAccountTransactions(transactions);
  updatePointsHistory();
}

function normalizeAccountTransactions(value) {
  const records = decodeFirebaseObject(value);
  if (!records || typeof records !== "object") return [];
  return Object.entries(records)
    .filter(([, record]) => record && typeof record === "object" && !Array.isArray(record))
    .map(([key, record]) => ({
      ...record,
      id: String(record.id || key),
      type: String(record.type || "Wallet"),
      amount: Number(record.amount) || 0,
      title: String(record.title || record.note || record.type || "Wallet activity"),
      date: String(record.date || record.createdAt || ""),
      status: String(record.status || "Recorded")
    }));
}

function normalizeDemoTransactions(value) {
  const records = decodeFirebaseObject(value);
  if (!records || typeof records !== "object") return [];
  return Object.entries(records)
    .filter(([, record]) => record && typeof record === "object" && !Array.isArray(record))
    .map(([key, record]) => ({
      ...record,
      id: String(record.id || key),
      type: "Demo test",
      amount: Number(record.amount) || 0,
      title: "DEMO deposit test",
      date: String(record.date || record.createdAt || ""),
      status: "DEMO ONLY"
    }));
}

function updatePointsHistory() {
  state.pointsHistory = [
    ...state.bids.map(item => ({ ...item, title: `${item.gameType || "Bid"} · ${item.market}`, type: "Bid" })),
    ...state.depositHistory,
    ...state.withdrawalHistory,
    ...state.accountTransactions,
    ...state.demoTransactions
  ];
}

async function loadWalletRequests(page) {
  if (!state.user) return;
  const phone = state.user.phone;
  const loadDeposits = page === "points" || page === "deposit";
  const loadWithdrawals = page === "points" || page === "withdraw";
  const loads = [];
  if (loadDeposits) {
    loads.push(dbGet(DATABASE_ROOTS.deposits).then(data => {
      if (!state.user || state.user.phone !== phone) return;
      state.depositHistory = requestRecordsForPhone(data, phone, "deposit");
    }));
  }
  if (loadWithdrawals) {
    loads.push(dbGet(DATABASE_ROOTS.withdrawals).then(data => {
      if (!state.user || state.user.phone !== phone) return;
      state.withdrawalHistory = requestRecordsForPhone(data, phone, "withdrawal");
    }));
  }
  await Promise.all(loads);
  if (state.user?.phone === phone) updatePointsHistory();
}

function requestRecordsForPhone(data, phone, kind) {
  const decoded = decodeFirebaseObject(data);
  if (!decoded || typeof decoded !== "object") return [];
  return Object.entries(decoded)
    .filter(([key]) => key.endsWith(` ${phone}`))
    .map(([key, rawValue]) => {
      const value = decodeFirebaseValue(rawValue);
      let fields = value;
      if (typeof fields === "string") {
        try {
          fields = JSON.parse(fields);
        } catch {
          fields = [];
        }
      }
      if (!Array.isArray(fields)) fields = [];
      const isWithdrawal = kind === "withdrawal";
      return {
        id: key,
        title: isWithdrawal ? "Withdrawal request" : "Deposit request",
        date: key.slice(0, -phone.length).trim(),
        createdAt: key.slice(0, -phone.length).trim().replace(" ", "T"),
        destination: isWithdrawal ? fields[5] || fields[6] || fields[2] || "" : fields[1] || "",
        reference: isWithdrawal ? "" : String(fields[2] || "").trim(),
        upiAppStatus: isWithdrawal || !String(fields[5] || "").startsWith("UPI app reported")
          ? "" : String(fields[5]).trim(),
        amount: isWithdrawal ? fields[7] : fields[3],
        status: fields[fields.length - 1] || "Pending",
        raw: fields
      };
    });
}

async function loadGlobalData() {
  const dateRequest = dbGet("Date").then(decodeFirebaseObject).catch(error => {
    notify(`Unable to load market date: ${error.message || "Request failed."}`, "error");
    return null;
  });
  const optionalRequests = Promise.allSettled([
    dbGet(DATABASE_ROOTS.notices),
    dbGet(DATABASE_ROOTS.rates),
    dbGet(DATABASE_ROOTS.settings)
  ]);
  let dateTimeout;
  const dateInfo = await Promise.race([
    dateRequest,
    new Promise(resolve => {
      dateTimeout = window.setTimeout(() => resolve(null), 2500);
    })
  ]);
  window.clearTimeout(dateTimeout);
  state.marketDay = String(dateInfo?.day || "").replace(/^"|"$/g, "");
  state.marketTimestamp = parseFirebaseMarketDate(dateInfo?.date);
  state.marketTimestampReceivedAt = state.marketTimestamp ? Date.now() : 0;
  const marketBucket = marketBucketForDayName(state.marketDay) || marketBucketForToday();
  state.marketBucket = marketBucket;
  const [gamesResult, optionalResults] = await Promise.all([
    dbGet(marketBucket).then(value => ({ status: "fulfilled", value }), reason => ({ status: "rejected", reason })),
    optionalRequests
  ]);
  const [noticeResult, ratesResult, settingsResult] = optionalResults;
  if (gamesResult.status === "rejected") {
    state.markets = [];
    state.marketLoadError = gamesResult.reason?.message || `Could not load market data from ${marketBucket}.`;
    throw new Error(state.marketLoadError);
  }
  state.marketLoadError = "";
  const optionalData = (result, label, fallback) => {
    if (result.status === "fulfilled") return result.value;
    notify(`Unable to load ${label}: ${result.reason?.message || "Request failed."}`, "error");
    return fallback;
  };
  const notice = optionalData(noticeResult, "notices", null);
  const rates = optionalData(ratesResult, "market rates", null);
  const settings = optionalData(settingsResult, "admin settings", {});
  state.markets = normalizeMarkets(gamesResult.value);
  state.notices = notice === null || notice === undefined
    ? []
    : [{ id: "Notice", title: "Notice", message: String(decodeFirebaseValue(notice)) }];
  state.rates = decodeFirebaseObject(rates);
  applyAdminSettings(settings);
}

function stopRealtimeSubscriptions() {
  for (const subscription of realtimeSources.values()) {
    if (subscription && typeof subscription.close === "function") subscription.close();
  }
  realtimeSources.clear();
  realtimeValues.clear();
  for (const timer of realtimeTimers.values()) window.clearTimeout(timer);
  realtimeTimers.clear();
  window.clearInterval(marketDayTimer);
  marketDayTimer = 0;
  realtimeUserPhone = "";
  activeMarketBucket = "";
}

function startRealtimeSubscriptions() {
  if (!state.user || typeof firebase === "undefined" || !firebase.apps.length) return;
  stopRealtimeSubscriptions();
  realtimeUserPhone = state.user.phone;
  activeMarketBucket = state.marketBucket || marketBucketForToday();
  for (const path of [
    "Date",
    DATABASE_ROOTS.notices,
    DATABASE_ROOTS.rates,
    `${DATABASE_ROOTS.settings}`,
    ...DATABASE_ROOTS.marketBuckets
  ]) {
    watchFirebasePath(path, "global");
  }
  const phone = phonePath(state.user.phone);
  for (const path of [
    `${DATABASE_ROOTS.users}/${phone}`,
    `${DATABASE_ROOTS.bidHistory}/${phone}`,
    `${DATABASE_ROOTS.bidRecords}/${phone}`,
    `Blocked/${phone}`
  ]) {
    watchFirebasePath(path, "user");
  }
  for (const path of [DATABASE_ROOTS.deposits, DATABASE_ROOTS.withdrawals]) {
    watchFirebasePath(path, "wallet");
  }
  marketDayTimer = window.setInterval(() => {
    syncMarketBucketSubscription();
    if (["home", "markets", "game-select", "betting"].includes(state.page)) renderPage();
  }, 30_000);
}

function syncMarketBucketSubscription() {
  activeMarketBucket = state.marketBucket || marketBucketForToday();
}

function watchFirebasePath(path, refreshGroup) {
  realtimeSources.get(path)?.close();
  const databaseRef = firebase.database().ref(path);
  let refreshQueued = false;
  const handleChange = snapshot => {
    const value = snapshot.val();
    realtimeValues.set(path, value);
    applyRealtimeValue(path, value);
    if (refreshQueued) return;
    refreshQueued = true;
    window.setTimeout(() => {
      refreshQueued = false;
      scheduleRealtimeRefresh(refreshGroup);
    }, 0);
  };
  const handleError = error => {
    notify(`Live updates failed: ${error.message || "Permission denied or connection unavailable."}`, "error");
  };
  databaseRef.on("value", handleChange, handleError);
  realtimeSources.set(path, {
    close() {
      databaseRef.off("value", handleChange);
    }
  });
}

function applyRealtimeValue(path, value) {
  const decoded = decodeFirebaseValue(value);
  const blockedMatch = path.match(/^Blocked\/(\d{10,})$/);
  const profilePath = `${DATABASE_ROOTS.users}/${phonePath(state.user?.phone || "")}`;
  const profile = path === profilePath ? decodeFirebaseObject(value) : null;
  if ((blockedMatch && state.user?.phone === blockedMatch[1] && isBlockedValue(decoded))
    || (profile && isBlockedValue(profile.blocked))) {
    state.accountBlocked = true;
    logout();
    notify("This account has been blocked. Contact support for help.", "error");
    return;
  }
  if (path === "Date") {
    const dateInfo = decodeFirebaseObject(value) || {};
    state.marketDay = String(dateInfo.day || "").replace(/^"|"$/g, "");
    state.marketTimestamp = parseFirebaseMarketDate(dateInfo.date, dateInfo.time);
    state.marketTimestampReceivedAt = state.marketTimestamp ? Date.now() : 0;
    state.marketBucket = marketBucketForDayName(state.marketDay) || marketBucketForToday();
    activeMarketBucket = state.marketBucket;
    const marketData = realtimeValues.get(state.marketBucket);
    if (marketData !== undefined) {
      state.markets = normalizeMarkets(marketData);
      state.marketLoadError = "";
      redirectClosedBettingPage();
    }
    return;
  }
  if (DATABASE_ROOTS.marketBuckets.includes(path)) {
    if (path === state.marketBucket) {
      state.markets = normalizeMarkets(value);
      state.marketLoadError = "";
      redirectClosedBettingPage();
    }
    return;
  }
  if (path === DATABASE_ROOTS.notices) {
    state.notices = decoded === null || decoded === undefined
      ? []
      : [{ id: "Notice", title: "Notice", message: String(decoded) }];
    return;
  }
  if (path === DATABASE_ROOTS.rates) {
    state.rates = decodeFirebaseObject(value);
    return;
  }
  if (path === DATABASE_ROOTS.settings) {
    applyAdminSettings(value);
    if (["home", "deposit"].includes(state.page)) {
      void renderPage().catch(error => notify(error.message || "Unable to update the home page.", "error"));
    }
    return;
  }
  if (path === profilePath) {
    if (!profile || typeof profile !== "object") return;
    if (profile.name) {
      state.user.name = String(profile.name);
      localStorage.setItem("madhur555User", JSON.stringify(state.user));
      query("#header-name").textContent = state.user.name;
      query("#header-avatar").textContent = state.user.name.trim().charAt(0).toUpperCase() || "K";
    }
    state.balancePath = `${DATABASE_ROOTS.users}/${phonePath(state.user.phone)}/bal`;
    state.balance = Number(profile.bal || 0);
    state.accountBlocked = false;
  }
}

function scheduleRealtimeRefresh(group) {
  const existingTimer = realtimeTimers.get(group);
  if (existingTimer) window.clearTimeout(existingTimer);
  realtimeTimers.set(group, window.setTimeout(async () => {
    realtimeTimers.delete(group);
    if (!state.user || state.user.phone !== realtimeUserPhone) return;
    const refresh = group === "global"
      ? Promise.resolve()
      : group === "wallet"
        ? loadWalletRequests("points")
        : refreshUserData();
    try {
      await refresh;
      if (group === "global") syncMarketBucketSubscription();
      await renderPage();
    } catch (error) {
      notify(error.message || `Could not refresh ${group} data.`, "error");
    }
  }, 150));
}

function marketBucketForToday(date = new Date()) {
  const day = date.getDay();
  if (day === 6) return "GAMES2";
  if (day === 0) return "GAMES3";
  return "GAMES";
}

function marketBucketForDayName(day) {
  const normalizedDay = String(day || "").trim().toLocaleLowerCase();
  if (normalizedDay === "saturday") return "GAMES2";
  if (normalizedDay === "sunday") return "GAMES3";
  if (["monday", "tuesday", "wednesday", "thursday", "friday"].includes(normalizedDay)) return "GAMES";
  return "";
}

function parseFirebaseMarketDate(value, timeValue = "") {
  const dateMatch = String(decodeFirebaseValue(value) ?? "").trim().replace(/^"|"$/g, "")
    .match(/^(\d{2})-(\d{2})-(\d{4})(?:\s+(\d{1,2}):(\d{2}):(\d{2}))?$/);
  if (!dateMatch) return null;
  const [, day, month, year, embeddedHour, embeddedMinute, embeddedSecond] = dateMatch;
  const timeMatch = String(decodeFirebaseValue(timeValue) ?? "").trim().replace(/^"|"$/g, "")
    .match(/^(\d{1,2}):(\d{2}):(\d{2})\s*(AM|PM)?$/i);
  let hour = Number(embeddedHour || 0);
  let minute = Number(embeddedMinute || 0);
  let second = Number(embeddedSecond || 0);
  if (timeMatch) {
    hour = Number(timeMatch[1]);
    minute = Number(timeMatch[2]);
    second = Number(timeMatch[3]);
    if (timeMatch[4]) {
      if (hour < 1 || hour > 12) return null;
      hour %= 12;
      if (timeMatch[4].toUpperCase() === "PM") hour += 12;
    }
  }
  if (hour > 23 || minute > 59 || second > 59) return null;
  const date = new Date(Number(year), Number(month) - 1, Number(day), hour, minute, second);
  if (date.getFullYear() !== Number(year) || date.getMonth() !== Number(month) - 1 ||
      date.getDate() !== Number(day) || date.getHours() !== hour ||
      date.getMinutes() !== minute || date.getSeconds() !== second) return null;
  return date;
}

function marketNow() {
  if (!state.marketTimestamp || !state.marketTimestampReceivedAt) return new Date();
  return new Date(state.marketTimestamp.getTime() + Date.now() - state.marketTimestampReceivedAt);
}

function toRecords(data) {
  data = decodeFirebaseValue(data);
  if (data === null || data === undefined) return [];
  if (Array.isArray(data)) return data.map((value, index) => ({ ...asObject(value), id: String(index) }));
  if (typeof data !== "object") return [];
  return Object.entries(data)
    .filter(([id]) => id !== "x")
    .map(([id, value]) => ({ ...asObject(decodeFirebaseValue(value)), id }));
}

function asObject(value) {
  value = decodeFirebaseValue(value);
  return value && typeof value === "object" && !Array.isArray(value) ? value : { value };
}

function normalizeMarkets(bucket) {
  const marketsByName = new Map();
  if (!bucket || typeof bucket !== "object") return [];
  for (const [id, rawValue] of Object.entries(bucket)) {
    if (id === "x") continue;
    const game = decodeFirebaseValue(rawValue);
    if (!Array.isArray(game) || !game[0]) continue;
    const name = String(game[0]).trim();
    const key = name.toLocaleUpperCase();
    if (marketsByName.has(key)) continue;
    const resultValue = String(game[6] || "").trim();
    const marketMetadata = decodeFirebaseValue(game[8]);
    const metadata = marketMetadata && typeof marketMetadata === "object" && !Array.isArray(marketMetadata)
      ? marketMetadata : {};
    const category = /starline/i.test(name)
      ? "Starline"
      : /gali|disawar/i.test(name)
        ? "Gali / Disawar"
        : "Main";
    const resultParts = resultValue ? resultValue.split(/\s*-\s*/) : [];
    marketsByName.set(key, {
      id: `${category}:${id}:${key}`,
      name,
      category,
      open: resultParts[0] || "",
      close: resultParts[2] || "",
      result: resultValue,
      resultDate: String(metadata.resultDate || ""),
      openTime: String(game[1] || ""),
      closeTime: String(game[2] || ""),
      status: String(game[5] || ""),
      position: game[7] !== undefined && game[7] !== "" && Number.isFinite(Number(game[7]))
        ? Number(game[7]) : Number(id) || Number.MAX_SAFE_INTEGER,
      raw: game
    });
  }
  return [...marketsByName.values()].sort((left, right) =>
    left.position - right.position || left.name.localeCompare(right.name)
  );
}

function setPage(page, recordHistory = true) {
  state.supportDialogVisible = false;
  const previousPage = state.page;
  if (page === "home") pageHistory.length = 0;
  else if (recordHistory && state.user && previousPage !== page) pageHistory.push(previousPage);
  state.page = page;
  updateHeaderNavigation();
  if (window.ReactNativeWebView) {
    window.ReactNativeWebView.postMessage(JSON.stringify({
      type: "screen-capture",
      prevent: page === "bids" || page === "points"
    }));
  }
  if (page === "withdraw") state.withdrawalDialogVisible = !withdrawalWindowAt(marketNow()).open;
  else {
    state.withdrawalDialogVisible = false;
    state.insufficientWithdrawalAmount = null;
  }
  if (page !== "markets") state.featureMarketPage = false;
  if (page === "home") state.category = "Main";
  window.scrollTo(0, 0);
  query("#sidebar").classList.remove("open");
  query("#drawer-scrim").classList.remove("visible");
  queryAll(".nav-link").forEach(link => link.classList.toggle("active",
    link.dataset.page === page || (link.dataset.page === "markets" && ["game-select", "betting"].includes(page))));
  queryAll(".mobile-bottom-nav [data-page]").forEach(link => link.classList.toggle("active",
    link.dataset.page === page || (link.dataset.page === "home" && ["markets", "game-select", "betting"].includes(page))));
  const labels = {
    home: "Home", markets: "Markets", betting: "Place bid", charts: "Result chart", "chart-markets": "Market Result",
    "panel-chart": `${state.selectedPanelMarket || "Market"} Panel Chart`,
    "bank-details": "Bank Details", webviewer: state.webViewerTitle || "Results", bids: "Bids history",
    "expert-guessing": "Free expert guessing", "guess-scratch": "Scratch to reveal",
    support: "Support",
    "game-select": "Choose game",
    points: "Points history", deposit: "Deposit points", withdraw: "Withdraw points",
    rates: "Market rates", notices: "Notices", policy: "Privacy & policy", howto: "How to play", profile: "PROFILE",
    "time-table": "Time Table"
  };
  const pageTitle = labels[page] || "Home";
  query("#page-breadcrumb").textContent = pageTitle;
  renderPage();
  if (previousPage !== page && ["bank-details", "withdraw"].includes(page)) {
    const phone = state.user?.phone;
    if (phone) {
      void loadWithdrawalDetailsFromAccount(phone)
        .then(() => {
          if (state.user?.phone === phone && state.page === page) return renderPage();
          return undefined;
        })
        .catch(error => notify(error.message || "Could not load saved withdrawal details.", "error"));
    }
  }
  if (page === "points" || page === "deposit" || page === "withdraw") {
    void loadWalletRequests(page).then(renderPage).catch(error => {
      notify(error.message || "Could not load wallet history.", "error");
    });
  }
}

function closeExitDialog() {
  query("#exit-dialog")?.classList.add("hidden");
}

function showExitDialog() {
  query("#exit-dialog")?.classList.remove("hidden");
}

function updateHeaderNavigation() {
  const homePage = state.page === "home";
  const profilePage = state.page === "profile";
  const menuToggle = query("#menu-toggle");
  const sidebarOpen = query("#sidebar").classList.contains("open");
  menuToggle.textContent = homePage ? (sidebarOpen ? "×" : "☰") : "←";
  menuToggle.setAttribute("aria-label", homePage ? "Open menu" : "Go back");
  query(".topbar").classList.toggle("profile-page-header", profilePage);
  query(".main-column").classList.toggle("non-home-page", !homePage && !profilePage);
  query(".main-column").classList.toggle("profile-menu-active", profilePage);
}

function handleAppBack() {
  updateHeaderNavigation();
  if (state.supportDialogVisible) {
    state.supportDialogVisible = false;
    void renderPage();
    return;
  }
  const sidebar = query("#sidebar");
  if (sidebar.classList.contains("open")) {
    sidebar.classList.remove("open");
    query("#drawer-scrim").classList.remove("visible");
    updateHeaderNavigation();
    return;
  }
  if (!state.user) return;
  if (state.page === "webviewer" && ["Matka 60", "Matka 30"].includes(state.webViewerTitle)) {
    pageHistory.length = 0;
    setPage("home", false);
    return;
  }
  if (!query("#exit-dialog").classList.contains("hidden")) {
    closeExitDialog();
    return;
  }
  let previousPage = pageHistory.pop();
  while (previousPage === state.page) previousPage = pageHistory.pop();
  if (previousPage) {
    setPage(previousPage, false);
    return;
  }
  if (state.page !== "home") return setPage("home", false);
  showExitDialog();
}

function notifyApplicationBack() {
  console.log("back-application");
  if (window.ReactNativeWebView) {
    window.ReactNativeWebView.postMessage(JSON.stringify({ type: "back-application" }));
  } else if (window.parent !== window) {
    window.parent.postMessage("back-application", "*");
  }
}

function handleBackWebsiteMessage() {
  const sidebar = query("#sidebar");
  const exitDialog = query("#exit-dialog");
  if (state.supportDialogVisible || sidebar.classList.contains("open")
      || !exitDialog.classList.contains("hidden")) {
    handleAppBack();
    return;
  }
  if (state.page !== "home") {
    handleAppBack();
    return;
  }
  notifyApplicationBack();
}
window.__dpboss60HandleBack = handleBackWebsiteMessage;
window.__srideviHandleBackMessage = message => {
  if (message === "back-website") handleBackWebsiteMessage();
};
function installNativeBackMessageHandler() {
  const originalLog = console.log.bind(console);
  console.log = (...args) => {
    if (args.length === 1 && args[0] === "back-website") handleBackWebsiteMessage();
    originalLog(...args);
  };
}
installNativeBackMessageHandler();
window.__dpboss60PaymentReturned = () => {
  if (!state.user) return;
  try {
    const order = readPendingPayment(state.user.phone);
    if (order) startPaymentStatusPolling(order, false);
  } catch (error) {
    notify(error.message || "Could not resume payment confirmation.", "error");
  }
};
function parseUpiActivityResult(result) {
  const values = new Map();
  const responses = [String(result?.response || "")];
  if (result?.extras && typeof result.extras === "object") {
    for (const [key, value] of Object.entries(result.extras)) {
      if (value === undefined || value === null) continue;
      const text = String(value);
      values.set(key.toLowerCase(), text);
      responses.push(text);
    }
  }
  for (const response of responses) {
    const query = response.includes("?") ? response.slice(response.indexOf("?") + 1) : response;
    for (const [key, value] of new URLSearchParams(query.replace(/^[?&]/, ""))) {
      values.set(key.toLowerCase(), value);
    }
  }
  const rawStatus = String(values.get("status") || "").trim().toUpperCase();
  const responseText = responses.join(" ").toUpperCase();
  const status = ["SUCCESS", "SUCCESSFUL", "COMPLETED"].includes(rawStatus)
    || (!rawStatus && /\b(?:SUCCESS|SUCCESSFUL|COMPLETED)\b/.test(responseText)) ? "SUCCESS"
    : ["FAILURE", "FAILED"].includes(rawStatus) ? "FAILED"
      : ["CANCELLED", "CANCELED"].includes(rawStatus) ? "CANCELLED"
        : ["SUBMITTED", "PENDING"].includes(rawStatus) ? "PENDING" : "UNKNOWN";
  const reference = ["txnref", "approvalrefno", "txnid", "transactionid", "upitxnid"]
    .map(key => values.get(key) || "")
    .find(value => value.trim()) || "";
  return { status, reference: reference.trim() };
}

async function saveDirectPaymentFailureHistory(result) {
  if (!state.user || !state.directPaymentAmount || state.directPaymentFailureRecorded) return;
  const now = new Date();
  const timestamp = now.toISOString().replace("T", " ").slice(0, 19);
  const key = `${timestamp} ${state.user.phone}`;
  const amount = Number(state.directPaymentAmount);
  const value = JSON.stringify([
    state.user.phone,
    "UPI Direct",
    result.reference,
    amount,
    state.balance,
    result.status === "CANCELLED" ? "Cancelled" : "Failed"
  ]);
  await dbPatchAndVerify({ [`${DATABASE_ROOTS.deposits}/${key}`]: value });
  const entry = {
    id: key,
    title: "Direct UPI payment",
    type: "Deposit",
    amount,
    method: "UPI Direct",
    destination: result.reference,
    reference: result.reference,
    status: result.status === "CANCELLED" ? "Cancelled" : "Failed",
    createdAt: now.toISOString()
  };
  state.depositHistory.push(entry);
  updatePointsHistory();
  state.directPaymentFailureRecorded = true;
}

function createDemoOrderId(reference = "") {
  const safeReference = String(reference).replace(/[^A-Za-z0-9_-]/g, "").slice(0, 80);
  if (safeReference.length >= 8) return `DEMO-${safeReference}`;
  const random = new Uint32Array(3);
  if (window.crypto?.getRandomValues) window.crypto.getRandomValues(random);
  else random.forEach((_, index) => { random[index] = Math.floor(Math.random() * 0x100000000); });
  return `DEMO-${Date.now()}-${Array.from(random, value => value.toString(36)).join("")}`;
}

async function recordDemoUpiPayment(result) {
  if (!state.user || state.demoPaymentInFlight) return;
  if (result?.status !== "SUCCESS") throw new Error("A successful UPI activity result is required.");
  const amountText = String(state.directPaymentAmount || "").trim();
  const amount = Number(amountText);
  if (!/^\d+(?:\.\d{1,2})?$/.test(amountText) || !Number.isFinite(amount) || amount < 1 || amount > 1000000) {
    throw new Error("The demo payment amount is invalid. No demo points were added.");
  }

  const orderId = createDemoOrderId(result.reference);
  const completedAt = new Date().toISOString();
  const record = {
    id: orderId,
    orderId,
    type: "Demo test",
    title: "DEMO deposit test",
    amount,
    date: completedAt,
    createdAt: completedAt,
    status: "DEMO ONLY",
    demo: true,
    note: "TEST ONLY — UPI app reported success; payment is not bank-verified."
  };
  state.demoPaymentInFlight = true;
  let demoSaved = false;
  try {
    if (!window.firebase?.database) throw new Error("Firebase is unavailable; no demo points were added.");
    const demoWalletRef = firebase.database().ref(
      `${DATABASE_ROOTS.users}/${phonePath(state.user.phone)}/demoWallet`
    );
    let duplicateOrder = false;
    let invalidBalance = false;
    const outcome = await demoWalletRef.transaction(current => {
      const wallet = current && typeof current === "object" && !Array.isArray(current) ? current : {};
      const transactions = wallet.transactions && typeof wallet.transactions === "object"
        && !Array.isArray(wallet.transactions) ? wallet.transactions : {};
      if (Object.prototype.hasOwnProperty.call(transactions, orderId)) {
        duplicateOrder = true;
        return;
      }
      const currentBalance = wallet.balance === undefined ? 0 : Number(wallet.balance);
      if (!Number.isFinite(currentBalance) || currentBalance < 0) {
        invalidBalance = true;
        return;
      }
      return {
        ...wallet,
        balance: currentBalance + amount,
        transactions: { ...transactions, [orderId]: record }
      };
    });
    if (!outcome.committed && !duplicateOrder) {
      throw new Error(invalidBalance
        ? "The saved demo balance is invalid; no demo points were added."
        : "Firebase did not save the demo payment.");
    }
    demoSaved = true;
    const savedWallet = decodeFirebaseObject(outcome.snapshot.val()) || {};
    state.demoBalance = Number(savedWallet.balance) || 0;
    state.demoTransactions = normalizeDemoTransactions(savedWallet.transactions);
    updatePointsHistory();
    await renderPage();
    notify(duplicateOrder
      ? "This demo payment was already recorded; it was not added twice."
      : `UPI success recorded for testing only: ${money(amount)} added to the separate demo wallet.`, "success");
  } catch (error) {
    if (demoSaved) {
      throw new Error(`Demo payment was saved, but the screen could not refresh. Reopen Points history. ${error.message || ""}`);
    }
    throw error;
  } finally {
    state.demoPaymentInFlight = false;
  }
}


async function recordDirectUpiSuccess(result) {
  if (!state.user || state.demoPaymentInFlight) return;
  if (result?.status !== "SUCCESS") throw new Error("A successful UPI activity result is required.");
  const amountText = String(state.directPaymentAmount || "").trim();
  const amount = Number(amountText);
  if (!/^\d+(?:\.\d{1,2})?$/.test(amountText) || !Number.isFinite(amount) || amount < 1 || amount > 1000000) {
    throw new Error("The payment amount is invalid. No points were added.");
  }

  const phone = state.user.phone;
  const reference = String(result.reference || state.directPaymentReference || createRandomUpiTxnId()).trim() || createRandomUpiTxnId();
  const orderId = `UPI-${reference}`.replace(/[^A-Za-z0-9_-]/g, "").slice(0, 96) || createDemoOrderId(reference);
  const marker = `upi_auto_${orderId}`;
  const now = new Date();
  const completedAt = now.toISOString();
  const timestamp = completedAt.replace("T", " ").slice(0, 19);
  const depositKey = `${timestamp} ${phone}`;
  const profilePath = `${DATABASE_ROOTS.users}/${phonePath(phone)}`;

  state.demoPaymentInFlight = true;
  let credited = false;
  let duplicate = false;
  try {
    if (!window.firebase?.database) throw new Error("Firebase is unavailable; no points were added.");

    const profileRef = firebase.database().ref(profilePath);
    let invalidBalance = false;
    const outcome = await profileRef.transaction(profile => {
      duplicate = false;
      invalidBalance = false;
      if (!profile || typeof profile !== "object" || Array.isArray(profile)) {
        invalidBalance = true;
        return;
      }
      const markers = profile.walletRequestAdjustments && typeof profile.walletRequestAdjustments === "object"
        && !Array.isArray(profile.walletRequestAdjustments) ? profile.walletRequestAdjustments : {};
      if (markers[marker]) {
        duplicate = true;
        return;
      }
      const balanceField = ["bal", "COINS", "B2"].find(field => profile[field] !== undefined && profile[field] !== null) || "bal";
      const currentBalance = Number(decodeFirebaseValue(profile[balanceField]) || 0);
      if (!Number.isFinite(currentBalance) || currentBalance < 0) {
        invalidBalance = true;
        return;
      }
      const currentTd = Number(decodeFirebaseValue(profile.TD) || 0);
      const safeTd = Number.isFinite(currentTd) && currentTd >= 0 ? currentTd : 0;
      const transactions = profile.transactions && typeof profile.transactions === "object"
        && !Array.isArray(profile.transactions) ? profile.transactions : {};
      if (Object.prototype.hasOwnProperty.call(transactions, orderId)) {
        duplicate = true;
        return;
      }
      const txnRecord = {
        amount,
        date: now.toLocaleString("en-IN"),
        id: orderId,
        mobile: phone,
        note: `Auto UPI · ${reference}`,
        player: state.user.name || phone,
        type: "Added"
      };
      return {
        ...profile,
        [balanceField]: currentBalance + amount,
        TD: safeTd + amount,
        walletRequestAdjustments: { ...markers, [marker]: true },
        transactions: { ...transactions, [orderId]: txnRecord }
      };
    });

    if (!outcome.committed && !duplicate) {
      throw new Error(invalidBalance
        ? "The saved wallet balance is invalid; no points were added."
        : "Firebase did not save the wallet credit.");
    }

    // Last array slot is the status admin panel reads (Approved / Pending / Failed / …).
    // Mirror the same shape written when an admin presses Approve on a deposit request.
    const balanceBefore = Number(decodeFirebaseValue((outcome.snapshot.val() || {}).bal) || 0) - (duplicate ? 0 : amount);
    const depositValue = JSON.stringify([
      phone,
      "UPI Direct",
      reference,
      amount,
      balanceBefore,
      duplicate ? "Approved" : "Approved"
    ]);
    await dbPatchAndVerify({
      [`${DATABASE_ROOTS.deposits}/${depositKey}`]: depositValue
    });

    credited = true;
    const saved = decodeFirebaseObject(outcome.snapshot.val()) || {};
    const balanceField = ["bal", "COINS", "B2"].find(name => saved[name] !== undefined && saved[name] !== null) || "bal";
    state.balance = Number(decodeFirebaseValue(saved[balanceField]) || state.balance);
    state.directPaymentReference = reference;

    const entry = {
      id: depositKey,
      title: "Direct UPI payment",
      type: "Deposit",
      amount,
      method: "UPI Direct",
      destination: reference,
      reference,
      status: duplicate ? "Already credited" : "Approved",
      createdAt: completedAt,
      note: duplicate ? "Duplicate UPI success ignored" : "Auto credited on UPI app success"
    };
    if (!state.depositHistory.some(item => item.id === depositKey || item.reference === reference)) {
      state.depositHistory.unshift(entry);
    }
    updatePointsHistory();

    state.directPaymentAmount = "";
    state.directPaymentLaunched = false;
    state.directPaymentReturned = false;
    state.directPaymentStatus = "";
    state.directPaymentFailureRecorded = false;

    await renderPage();
    if (duplicate) {
      showAppDialog("This UPI payment was already credited. Your wallet was not increased again.", {
        kind: "success",
        title: "Already credited"
      });
    } else {
      showAppDialog(`${money(amount)} has been added to your wallet.\nReference: ${reference}`, {
        kind: "success",
        title: "Payment successful"
      });
    }
  } catch (error) {
    if (credited) {
      throw new Error(`Wallet was updated, but the screen could not refresh. Reopen Wallet. ${error.message || ""}`);
    }
    throw error;
  } finally {
    state.demoPaymentInFlight = false;
  }
}

window.__madhur555UpiPaymentLaunchResult = (opened, reason = "") => {
  if (!state.directPaymentAmount) return;
  if (!opened) {
    state.directPaymentLaunched = false;
    notify(reason || "Could not open a UPI payment app.", "error");
    return;
  }
  state.directPaymentLaunched = true;
  void renderPage();
  notify("UPI app opened. Complete the payment; success returns you here and credits the wallet.");
};
window.__madhur555UpiPaymentResult = result => {
  if (!state.user || !state.directPaymentAmount || !state.directPaymentLaunched) return;
  if (result?.launchError) {
    state.directPaymentLaunched = false;
    notify(String(result.launchError), "error");
    void renderPage();
    return;
  }
  const paymentResult = parseUpiActivityResult(result);
  state.directPaymentReturned = true;
  state.directPaymentStatus = paymentResult.status;
  state.directPaymentReference = paymentResult.reference;
  if (["FAILED", "CANCELLED"].includes(paymentResult.status)) {
    void saveDirectPaymentFailureHistory(paymentResult)
      .then(() => {
        if (paymentResult.status === "FAILED") {
          showAppDialog("Payment failed. Please try again.", {
            kind: "failed",
            title: "Payment failed"
          });
        } else {
          showAppDialog("Payment was cancelled. No points were added. You can try again anytime.", {
            kind: "failed",
            title: "Payment cancelled"
          });
        }
      })
      .catch(error => showAppDialog(
        `Payment failed. Please try again.\n(${error.message || "History save failed."})`,
        { kind: "failed", title: "Payment failed" }
      ))
      .finally(() => void renderPage());
    return;
  }
  if (paymentResult.status === "SUCCESS") {
    // Prefer activity reference; keep the random tr we injected if the UPI app returns none.
    if (!paymentResult.reference && state.directPaymentReference) {
      paymentResult.reference = state.directPaymentReference;
    }
    void recordDirectUpiSuccess(paymentResult).catch(error => showAppDialog(
      `Payment was reported successful, but the wallet could not be updated. No points were added.\n${error.message || "Please try again."}`,
      { kind: "failed", title: "Wallet update failed" }
    ));
    return;
  }
  void renderPage();
  notify("The UPI app returned no confirmed success status. Try the payment again from Add points.", "error");
};
window.addEventListener("message", event => {
  if (event.source !== window.parent) return;
  if (event.data === "back-website" || event.data === "dpboss60:back") {
    handleBackWebsiteMessage();
    return;
  }
  if (event.data === "dpboss60:payment-returned") window.__dpboss60PaymentReturned();
});

function bumpNonHomePageText(root) {
  if (state.page === "home" || state.page === "profile") return;
  const textElements = [...root.querySelectorAll(
    "h1, h2, h3, h4, p, span, strong, small, label, button, input, select, textarea, th, td, li, a, legend, summary, time, dd, dt"
  )].filter(element =>
    (element.textContent.trim() || ["INPUT", "SELECT", "TEXTAREA"].includes(element.tagName))
    && element.getAttribute("aria-hidden") !== "true"
  );
  const sizes = textElements.map(element => Number.parseFloat(window.getComputedStyle(element).fontSize));
  textElements.forEach((element, index) => {
    if (element.dataset.fontBoosted === "true" || !Number.isFinite(sizes[index])) return;
    element.style.fontSize = `${sizes[index] + 1}px`;
    element.dataset.fontBoosted = "true";
  });
}

async function renderPage() {
  const root = query("#page-content");
  const renderers = {
    home: renderHome,
    support: renderSupportPage,
    markets: renderMarkets,
    "chart-markets": renderChartMarketList,
    "time-table": renderTimeTable,
    "game-select": renderGameSelect,
    betting: renderBetting,
    charts: renderCharts,
    "panel-chart": renderPanelChart,
    webviewer: renderWebViewer,
    bids: () => renderHistory("bids"),
    points: () => renderHistory("points"),
    deposit: renderDeposit,
    withdraw: renderWithdraw,
    "bank-details": renderBankDetails,
    rates: renderRates,
    notices: renderNotices,
    policy: renderPolicy,
    howto: renderHowTo,
    profile: renderProfile,
    "expert-guessing": renderExpertGuessing,
    "guess-scratch": renderGuessScratch
  };
  const currentViewer = state.page === "webviewer" ? query(".result-webviewer", root) : null;
  if (!currentViewer || currentViewer.dataset.url !== state.webViewerUrl) {
    root.innerHTML = (renderers[state.page] || renderHome)()
      + (state.supportDialogVisible ? renderSupportDialog() : "");
  } else if (state.supportDialogVisible && !query(".support-sheet-backdrop", root)) {
    root.insertAdjacentHTML("beforeend", renderSupportDialog());
  } else if (!state.supportDialogVisible) {
    query(".support-sheet-backdrop", root)?.remove();
  }
  bumpNonHomePageText(root);
  const appView = query("#app-view");
  const authView = query("#auth-view");
  const exitDialog = query("#exit-dialog");
  const maintenanceDialog = query("#maintenance-dialog");
  if (state.maintenance) {
    appView.inert = true;
    authView.inert = true;
    exitDialog.inert = true;
    if (!maintenanceDialog) {
      document.body.insertAdjacentHTML("beforeend", `<div class="maintenance-backdrop"><section id="maintenance-dialog" class="maintenance-dialog" role="dialog" aria-modal="true" aria-labelledby="maintenance-title" tabindex="-1"><div class="maintenance-dialog-icon" aria-hidden="true">!</div><h2 id="maintenance-title">Under Maintenance</h2><p>Game play is temporarily unavailable. Please check back later.</p><strong>We'll be back soon.</strong></section></div>`);
      query("#maintenance-dialog")?.focus({ preventScroll: true });
    }
  } else {
    appView.inert = false;
    authView.inert = false;
    exitDialog.inert = false;
    maintenanceDialog?.closest(".maintenance-backdrop")?.remove();
  }
  updateHeaderNavigation();
  query("#aia-header-balance").textContent = money(state.balance);
  query("#drawer-user-name").textContent = state.user?.name || "Player";
  query("#drawer-user-balance").textContent = money(state.balance);
  queryAll(".mobile-bottom-nav [data-page]").forEach(button => {
    button.classList.toggle("active", button.dataset.page === state.page ||
      (["markets", "betting", "game-select"].includes(state.page) && button.dataset.page === "home"));
  });
  updatePaymentRetryCountdown();
}

function heading(title, description, action = "") {
  return `<div class="page-heading"><div><h1>${safeText(title)}</h1>${description ? `<p>${safeText(description)}</p>` : ""}</div>${action ? `<div class="heading-actions">${action}</div>` : ""}</div>`;
}

function renderWebViewer() {
  if (!state.webViewerUrl) {
    return `${heading("Web viewer", "The requested page could not be opened.")}<div class="empty-state"><strong>No page selected</strong>Choose Results or a market result to load a page here.</div>`;
  }
  try {
    new URL(state.webViewerUrl);
  } catch {
    throw new Error("The configured viewer URL is invalid.");
  }
  return `<section class="webviewer-page">
    <header class="webviewer-toolbar">
      <strong>${safeText(state.webViewerTitle || "Website")}</strong>
      <div class="webviewer-toolbar-actions">
        <button class="webviewer-refresh" type="button" data-action="refresh-webviewer" aria-label="Reload page"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5"/><path d="M5.6 9a7 7 0 0 1 11.7-2L20 12M4 12l2.7 5a7 7 0 0 0 11.7-2"/></svg></button>
        ${["Matka 60", "Matka 30"].includes(state.webViewerTitle) ? "" : `<button class="webviewer-open" type="button" data-action="open-webviewer-external" aria-label="Open website in browser"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9"/><path d="M18 13v5a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h5"/></svg><span>Open</span></button>`}
      </div>
    </header>
    <iframe class="result-webviewer" data-url="${safeText(state.webViewerUrl)}" src="${safeText(state.webViewerUrl)}" title="${safeText(state.webViewerTitle || "Results")} website viewer" referrerpolicy="strict-origin-when-cross-origin" allow="clipboard-read; clipboard-write; fullscreen"></iframe>
  </section>`;
}

function gameTile(game) {
  return `<button class="game-tile ${state.selectedGame === game ? "selected" : ""}" type="button" data-select-game="${safeText(game)}">
    <span class="game-tile-icon" aria-hidden="true">${gameTileIcon(game)}</span>
    <span>${safeText(gameDisplayName(game))}</span>
  </button>`;
}

function gameTileIcon(game) {
  const svg = content => `<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${content}</svg>`;
  if (game === "Red Bracket") return svg(`<text x="5" y="43" fill="currentColor" stroke="none" font-size="42" font-weight="800">{ }</text>`);
  if (["SP DP TP", "SP Motor", "DP Motor", "TP Motor", "Cycle Pana", "Group Jodi"].includes(game)) {
    return svg(`<circle cx="32" cy="32" r="22"/><circle cx="32" cy="32" r="15"/><circle cx="32" cy="32" r="4"/><path d="M32 10v7m0 30v7M10 32h7m30 0h7M16.5 16.5l5 5m21 21 5 5m0-31-5 5m-21 21-5 5"/><circle cx="32" cy="17" r="2"/><circle cx="47" cy="32" r="2"/><circle cx="32" cy="47" r="2"/><circle cx="17" cy="32" r="2"/>`);
  }
  if (game === "Panel") {
    return svg(`<rect x="14" y="13" width="25" height="36" rx="3" transform="rotate(-11 14 13)"/><path d="M27 24c-4 5-7 8-7 12a7 7 0 0 0 14 0c0-4-3-7-7-12Zm0 19v5"/><circle cx="45" cy="44" r="9"/><text x="45" y="47" fill="currentColor" stroke="none" font-size="9" font-weight="800" text-anchor="middle">7</text>`);
  }
  if (/pana/i.test(game)) {
    const count = /triple/i.test(game) ? 3 : /double/i.test(game) ? 2 : 1;
    const cards = Array.from({ length: count }, (_, index) => `<rect x="${14 + index * 7}" y="${16 - index * 2}" width="24" height="33" rx="3" transform="rotate(-10 ${14 + index * 7} 16)"/>`).join("");
    return svg(`${cards}<path d="M31 23c-4 5-7 8-7 12a7 7 0 0 0 14 0c0-4-3-7-7-12Zm0 19v5"/><circle cx="46" cy="44" r="9"/><text x="46" y="47" fill="currentColor" stroke="none" font-size="9" font-weight="800" text-anchor="middle">7</text>`);
  }
  if (/sangam/i.test(game)) {
    return svg(`<circle cx="32" cy="32" r="23"/><circle cx="32" cy="32" r="17"/><path d="M32 21c-5 6-8 10-8 14a8 8 0 0 0 16 0c0-4-3-8-8-14Zm0 22v7M32 9v5m0 41v-5M9 32h5m41 0h-5M16 16l4 4m28 28 4 4m0-36-4 4m-28 28-4 4"/>`);
  }
  if (/jodi|two digit|odd even/i.test(game)) {
    return svg(`<rect x="12" y="12" width="40" height="40" rx="3"/><circle cx="23" cy="23" r="3" fill="currentColor"/><circle cx="32" cy="32" r="3" fill="currentColor"/><circle cx="41" cy="41" r="3" fill="currentColor"/>`);
  }
  return svg(`<rect x="12" y="12" width="40" height="40" rx="3"/><circle cx="32" cy="32" r="4" fill="currentColor"/>`);
}

function isBulkInputGame(game) {
  return ["Single Digit Bulk", "Single Pana Bulk", "Double Pana Bulk"].includes(game);
}

function defaultBetAmount() {
  const maximum = state.maximumEntry > 0 ? state.maximumEntry : 10;
  return String(Math.max(state.minimumEntry, Math.min(10, maximum)));
}

function gameDisplayName(game) {
  const names = {
    Single: "Single Digit",
    "Single Digit Bulk": "Single Digit Bulk",
    Jodi: "Jodi Digits",
    "Bulk Jodi": "Jodi Digits Bulk",
    "Single Pana": "Single Panna",
    "Single Pana Bulk": "Single Panna Bulk",
    "Double Pana": "Double Panna",
    "Double Pana Bulk": "Double Panna Bulk",
    "Triple Pana": "Triple Panna",
    "Panel": "Panel",
    "Cycle Pana": "Cycle Panna",
    "Red Bracket": "Red Braket",
    "Two Digit Panel": "Two Digit Pannel",
    "Odd Even": "Odd Even",
    "Half Sangam A": "Half Sangam A",
    "Half Sangam B": "Half Sangam B"
  };
  return names[game] || game;
}

function legacyGameType(game) {
  if (game === "Single") return "Single Digit";
  if (game === "Jodi") return "Double Digit";
  if (["Single Digit Bulk", "Red Bracket", "Odd Even"].includes(game)) return "Single Digit";
  if (["Bulk Jodi", "Group Jodi", "Digit Based Jodi", "Two Digit Panel"].includes(game)) return "Double Digit";
  if (["Single Pana Bulk", "Cycle Pana"].includes(game)) return "Single Pana";
  if (game === "Double Pana Bulk") return "Double Pana";
  if (["Half Sangam A", "Half Sangam B"].includes(game)) return "Half Sangam";
  if (game === "Panel") return "SP DP TP";
  return game;
}

function marketCards(markets, showAll = false) {
  if (!markets.length) {
    const detail = state.marketLoadError
      ? safeText(state.marketLoadError)
      : "Market data will appear here when it is available.";
    return `<div class="empty-state"><strong>No markets available</strong>${detail}</div>`;
  }
  const visibleMarkets = showAll ? markets : markets.slice(0, 6);
  return `<div class="market-grid">${visibleMarkets.map(market => {
    const isOpen = marketSessions(market).length > 0;
    const isLive = isOpen;
    const resultDate = String(market.resultDate || "").trim();
    const hasCurrentResult = isCurrentMarketResult(resultDate);
    const placeholder = "### - ## - ###";
    const rawResult = hasCurrentResult ? market.result || market.raw?.[6] : "";
    const result = String(rawResult || placeholder).replace(/\s*-\s*/g, " - ");
    const closed = Boolean(state.closedMarket?.id && state.closedMarket.id === market.id);
    const color = /rajdhani/i.test(market.name) ? "red"
      : /sridevi|madhur/i.test(market.name) ? "purple"
        : /time bazar|kalyan/i.test(market.name) ? "orange"
          : /main bazar/i.test(market.name) ? "brown" : "pink";
    return `<article class="market-card aia-market-card market-color-${color} ${isOpen ? "market-open" : "market-closed"}">
      <div class="market-card-info">
        <h3>${safeText(market.name)}</h3>
        <button class="market-result-button" type="button" data-market-result="${safeText(market.id)}" aria-label="View ${safeText(market.name)} result"><span class="market-card-result">${safeText(result)}</span></button>
      </div>
      <div class="market-card-times"><span><b>Open</b> ${safeText(displayMarketTime(market.openTime))}</span><span><b>Close</b> ${safeText(displayMarketTime(market.closeTime))}</span></div>
      <div class="market-card-action">
        ${isLive ? `<span class="market-live"><i></i> LIVE</span>` : ""}
        <button class="market-play ${isOpen ? "open" : "closed"}" type="button" data-open-market="${safeText(market.id)}" aria-label="${isOpen ? `Play ${safeText(market.name)}` : `Show ${safeText(market.name)} closing time`}">${isOpen ? `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.8a1.2 1.2 0 0 1 1.84-1.02l12.4 7.2a1.2 1.2 0 0 1 0 2.04l-12.4 7.2A1.2 1.2 0 0 1 7 19.2z"/></svg><span>PLAY</span>` : "CLOSED"}</button>
        ${isLive ? `<span class="market-countdown" data-market-countdown="${safeText(market.id)}" data-open-time="${safeText(market.openTime || "")}" data-close-time="${safeText(market.closeTime || "")}">${marketCountdownText(market)}</span><small class="market-countdown-caption">left to close</small>` : ""}
      </div>
      <div class="market-card-status ${isOpen ? "open" : "closed"}">${isOpen ? "• Running Now" : "Closed For Today"}</div>
      ${closed ? `<div class="mama-dialog-backdrop dpb-bidding-closed-backdrop" role="presentation"><section class="dpb-bidding-closed-sheet" role="dialog" aria-modal="true" aria-labelledby="closed-market-title">
        <span class="dpb-sheet-handle" aria-hidden="true"></span>
        <button class="dpb-sheet-close" type="button" data-action="dismiss-market-closed" aria-label="Close">×</button>
        <span class="dpb-closed-lock" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span>
        <h2 id="closed-market-title">Bidding Closed</h2>
        <p class="dpb-closed-subtitle">Today's session has been locked</p>
        <strong class="dpb-closed-market-name">${safeText(market.name)}</strong>
        <section class="dpb-closed-session open"><h3>☼ Open Session</h3>
          <p><span>Open Result Time</span><strong>${safeText(displayMarketTime(market.openTime))}</strong></p>
          <p><span>Open Bid Last Time</span><strong>${safeText(displayMarketTime(market.openTime))}</strong></p>
        </section>
        <section class="dpb-closed-session close"><h3>☾ Close Session</h3>
          <p><span>Close Result Time</span><strong>${safeText(displayMarketTime(market.closeTime))}</strong></p>
          <p><span>Close Bid Last Time</span><strong>${safeText(displayMarketTime(market.closeTime))}</strong></p>
        </section>
        <button class="dpb-closed-confirm" type="button" data-action="dismiss-market-closed">Ok</button>
      </section></div>` : ""}
    </article>`;
  }).join("")}</div>`;
}

function marketTimeSeconds(value) {
  const time = String(value || "").trim();
  const twelveHour = time.match(/^(\d{1,2}):(\d{2})(?::(\d{2}))?\s*(AM|PM)$/i);
  const twentyFourHour = time.match(/^([01]?\d|2[0-3]):([0-5]\d)(?::([0-5]\d))?$/);
  const match = twelveHour || twentyFourHour;
  if (!match) return null;
  let hour = Number(match[1]);
  if (twelveHour) {
    hour %= 12;
    if (twelveHour[4].toUpperCase() === "PM") hour += 12;
  }
  return hour * 3600 + Number(match[2]) * 60 + Number(match[3] || 0);
}

function displayMarketTime(value) {
  const seconds = marketTimeSeconds(value);
  if (seconds === null) return value || "—";
  const hour = Math.floor(seconds / 3600);
  const minute = Math.floor(seconds / 60) % 60;
  return `${String(hour % 12 || 12).padStart(2, "0")}:${String(minute).padStart(2, "0")} ${hour < 12 ? "AM" : "PM"}`;
}

function marketCountdownText(market, now = marketNow()) {
  const close = marketTimeSeconds(market.closeTime);
  const open = marketTimeSeconds(market.openTime);
  if (close === null) return "--:--:--";
  const current = now.getHours() * 3600 + now.getMinutes() * 60 + now.getSeconds();
  let remaining = close - current;
  if (open !== null && open > close && current >= open) remaining += 24 * 60 * 60;
  remaining = Math.max(0, remaining);
  const hours = Math.floor(remaining / 3600);
  const minutes = Math.floor(remaining % 3600 / 60);
  const seconds = remaining % 60;
  return `${String(hours).padStart(2, "0")}:${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;
}

function updateMarketCountdowns() {
  redirectClosedBettingPage();
  queryAll("[data-market-countdown]").forEach(element => {
    const market = { openTime: element.dataset.openTime, closeTime: element.dataset.closeTime };
    element.textContent = marketCountdownText(market);
  });
}

function marketDateKey(date = marketNow()) {
  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
}

function isCurrentMarketResult(value) {
  const resultDate = String(value || "").trim();
  if (!resultDate) return false;
  const today = marketDateKey();
  const yearFirst = resultDate.match(/^(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})(?:$|[T\s])/);
  if (yearFirst) {
    return `${yearFirst[1]}-${String(Number(yearFirst[2])).padStart(2, "0")}-${String(Number(yearFirst[3])).padStart(2, "0")}` === today;
  }
  const dayFirst = resultDate.match(/^(\d{1,2})[-/.](\d{1,2})[-/.](\d{4})$/);
  if (dayFirst) {
    return `${dayFirst[3]}-${String(Number(dayFirst[2])).padStart(2, "0")}-${String(Number(dayFirst[1])).padStart(2, "0")}` === today;
  }
  if (/^\d{10}$|^\d{13}$/.test(resultDate)) {
    const timestamp = Number(resultDate) * (resultDate.length === 10 ? 1000 : 1);
    return marketDateKey(new Date(timestamp)) === today;
  }
  const parsedDate = Date.parse(resultDate);
  return Number.isFinite(parsedDate) && marketDateKey(new Date(parsedDate)) === today;
}

function marketResultMarkup(result) {
  const parts = String(result || "").split(/\s*-\s*/).map(part => part.trim());
  const openPanel = /^\d{3}$/.test(parts[0] || "") ? parts[0] : "";
  const jodi = /^(?:\d{2}|\d#|#\d)$/.test(parts[1] || "") ? parts[1] : "";
  const closePanel = /^\d{3}$/.test(parts[2] || "") ? parts[2] : "";
  if (!jodi || (!openPanel && !closePanel)) return `<span class="market-result-value">${safeText(result || "### - ## - ###")}</span>`;
  const openDigit = /^\d/.test(jodi) ? jodi[0] : "#";
  const closeDigit = /\d$/.test(jodi) ? jodi[jodi.length - 1] : "#";
  return `<span class="market-result-parts"><span class="market-result-half"><small>OPEN</small><strong>${safeText(openPanel || "###")} - ${safeText(openDigit)}</strong></span><span class="market-result-half"><small>CLOSE</small><strong>${safeText(closeDigit)} - ${safeText(closePanel || "###")}</strong></span></span>`;
}

function marketSessions(market) {
  if (state.accountBlocked || !market || /closed/i.test(market.status) || marketClockStatus(market) === "closed") return [];
  const available = ["Open", "Close"].filter((session, index) => {
    if (state.maintenance || !(session === "Open" ? state.openBets : state.closeBets)) return false;
    const enabled = market.raw?.[index + 3];
    return enabled === undefined || String(enabled).toUpperCase() === "Y";
  });
  return marketClockStatus(market) === "after_open"
    ? available.filter(session => session === "Close")
    : available;
}

function redirectClosedBettingPage() {
  if (state.page !== "betting") return;
  const market = state.markets.find(item => item.name === state.selectedMarket);
  const requiredSessions = [...new Set(state.betDraft.map(item => item.session || state.selectedSession))];
  if (!requiredSessions.length) requiredSessions.push(state.selectedSession);
  const openSessions = marketSessions(market);
  if (market && requiredSessions.every(session => openSessions.includes(session))) return;
  state.betDraft = [];
  state.selectedGame = "";
  notify("This market session has closed. Returning to the home page.", "error");
  setPage("home", false);
}

function marketClockStatus(market, now = marketNow()) {
  const open = marketTimeSeconds(market.openTime);
  const close = marketTimeSeconds(market.closeTime);
  if (open === null || close === null) return "before_open";
  const current = now.getHours() * 3600 + now.getMinutes() * 60 + now.getSeconds();
  if (open <= close) {
    if (current < open) return "before_open";
    if (current < close) return "after_open";
    return "closed";
  }
  return current >= open || current < close ? "after_open" : "before_open";
}

function activityRows(items, emptyText = "Your recent activity will show here.") {
  if (!items.length) return `<div class="empty-state">${safeText(emptyText)}</div>`;
  return `<div class="activity-list">${items.slice(0, 4).map(item => {
    const amount = Number(item.amount || item.points || item.value || 0);
    const outgoing = /withdraw|bid|debit/i.test(String(item.type || item.status || ""));
    return `<div class="activity-row"><div class="activity-title"><span class="activity-mark">${outgoing ? "↗" : "◈"}</span><span><strong>${safeText(item.title || item.market || item.type || "Points activity")}</strong><small>${safeText(dateText(item.createdAt || item.date || item.timestamp))}</small></span></div><span class="activity-amount ${outgoing ? "out" : ""}">${outgoing ? "−" : "+"}${money(amount)}</span></div>`;
  }).join("")}</div>`;
}

function renderHome() {
  const markets = marketsForCategory(state.category);
  return `${renderHomeOverview()}
    <div class="section-head"><h2>${safeText(marketCategoryLabel(state.category))} markets</h2><button class="text-button" type="button" data-action="refresh">↻ Auto Refresh</button></div>
    ${marketCards(markets, true)}`;
}

function renderHomeOverview() {
  const supportContact = configuredSupportContact();
  const hasTelegram = isConfiguredExternalUrl(state.telegramUrl);
  const hasWhatsApp = Boolean(supportContact);
  return `<section class="aia-home-overview">
    <div class="aia-wallet-overview">
      <div class="aia-wallet-total"><small>TOTAL BALANCE <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z"/><circle cx="12" cy="12" r="2.5"/></svg></span></small><strong>${money(state.balance)}</strong></div>
      <button class="aia-wallet-refresh" type="button" data-action="refresh" aria-label="Refresh balance">↻</button>
      <button class="aia-wallet-image-action" type="button" data-page="deposit" aria-label="Add money. Instant and secure."><img src="add-money-button.png" alt="Add money — Instant &amp; Secure" width="900" height="765"></button>
      <button class="aia-wallet-image-action" type="button" data-page="withdraw" aria-label="Withdraw. Fast and secure."><img src="withdraw-button.png" alt="Withdraw — Fast &amp; Secure" width="900" height="765"></button>
    </div>
    <section class="aia-home-panel">
    <div class="aia-feature-carousel" aria-label="Featured games">
      <button class="aia-feature-card" type="button" data-action="open-feature-markets" data-feature-category="Starline" aria-label="Sridevi Matka Starline: view markets"><img src="logo-sridevi-starline-live.png" alt="Sridevi Starline. Live. Fast and easy. Play now." width="768" height="768"></button>
      <button class="aia-feature-card" type="button" data-action="open-feature-markets" data-feature-category="Gali / Disawar" aria-label="Sridevi Matka Gali Disawar: view markets"><img src="logo-sridevi-gali-disawar-blue.png" alt="Sridevi Gali/Disawar. Live. Fast and easy. Play now." width="768" height="768"></button>
      <button class="aia-feature-card" type="button" data-action="open-matka" data-matka="60" aria-label="Matka 60"><img src="home-matka-60.png" alt="Matka 60" width="872" height="960"></button>
      <button class="aia-feature-card" type="button" data-action="open-matka" data-matka="30" aria-label="Matka 30"><img src="home-matka-30.png" alt="Matka 30" width="872" height="960"></button>
    </div>
    <div class="aia-home-contact-row" aria-label="Contact support">
      <button class="support-number-call support-number-telegram" type="button" data-action="open-telegram" aria-label="Telegram" ${hasTelegram ? "" : "disabled"}><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m21 3-7.2 18-3.7-7.1L3 10.2 21 3Z"/><path d="m10.1 13.9 5.3-5.2"/></svg></span><strong>Telegram</strong></button>
      <button class="support-number-whatsapp" type="button" data-action="open-whatsapp" aria-label="WhatsApp" ${hasWhatsApp ? "" : "disabled"}><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.5L3 20l.9-4.7a8.5 8.5 0 1 1 16.6-3.7Z"/><path d="M8 8.2c.3-.6.6-.6.9-.6h.5c.2 0 .4.1.5.4l.8 1.8c.1.2.1.4 0 .5l-.6.8c-.1.2-.1.4 0 .6.5.9 1.2 1.6 2.1 2.1.2.1.4.1.6-.1l.8-.9c.2-.2.4-.2.6-.1l1.7.8c.2.1.3.3.3.5 0 .4-.2 1-.6 1.3-.4.4-1.1.6-1.7.5-1-.1-2.2-.7-3.4-1.7-1.3-1.1-2.2-2.5-2.5-3.5-.3-.9-.2-1.7.1-2.4Z"/></svg></span><strong>WhatsApp</strong></button>
    </div>
    <div class="aia-home-actions">
      <button type="button" data-page="deposit"><span aria-hidden="true">₹</span>ADD POINTS</button>
      <button type="button" data-page="withdraw"><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 9h18M5 9v9m5-9v9m4-9v9m5-9v9M3 20h18M12 4 3 8h18z"/></svg></span>WITHDRAW</button>
      <button type="button" data-action="open-contact"><span aria-hidden="true">✉</span>CONTACT</button>
    </div>
    ${state.maintenance ? `<div class="notice-strip"><strong>MAINTENANCE</strong><span>Game play is temporarily unavailable. Please check back later.</span></div>` : ""}
    </section>
  </section>`;
}

function availableMarketCategories() {
  const available = MARKET_CATEGORIES.filter(category =>
    category !== "Gali / Disawar" || marketsForCategory(category).length > 0
  );
  if (!available.includes(state.category)) state.category = "Main";
  return available;
}

function marketCategoryLabel(category) {
  return category === "Gali / Disawar" ? "Super Jackpot" : category;
}

function marketsForCategory(category) {
  return state.markets.filter(market => category === "Main"
    ? !/starline|gali|disawar/i.test(market.category)
    : category === "Starline"
      ? /starline/i.test(market.category)
      : /gali|disawar/i.test(market.category))
    .sort((left, right) => left.position - right.position || left.name.localeCompare(right.name));
}

function renderMarkets() {
  if (state.featureMarketPage) {
    return `<section class="feature-market-page">
      <header><h1>${safeText(state.category === "Gali / Disawar" ? "Gali / Disawar" : marketCategoryLabel(state.category))}</h1></header>
      ${marketCards(marketsForCategory(state.category), true)}
    </section>`;
  }
  const allMarkets = marketsForCategory(state.category);
  return `${renderHomeOverview()}
    <div class="section-head"><h2>${safeText(marketCategoryLabel(state.category))} markets</h2><button class="text-button" type="button" data-action="refresh">↻ Auto Refresh</button></div>
    ${marketCards(allMarkets, true)}`;
}

function marketOpenMinute(market) {
  const time = String(market.openTime || "").trim();
  const twelveHour = time.match(/^(\d{1,2}):(\d{2})(?::\d{2})?\s*(AM|PM)$/i);
  if (twelveHour) {
    let hour = Number(twelveHour[1]) % 12;
    if (twelveHour[3].toUpperCase() === "PM") hour += 12;
    return hour * 60 + Number(twelveHour[2]);
  }
  const twentyFourHour = time.match(/^([01]?\d|2[0-3]):([0-5]\d)(?::[0-5]\d)?$/);
  return twentyFourHour ? Number(twentyFourHour[1]) * 60 + Number(twentyFourHour[2]) : null;
}

function guessingMarketPeriod(market) {
  const openMinute = marketOpenMinute(market);
  return openMinute !== null && (openMinute >= 18 * 60 || openMinute < 6 * 60) ? "night" : "day";
}

function expertGuessFor(market) {
  const match = Object.entries(state.expertGuessing).find(([name, guess]) =>
    String(guess.marketName || name).trim().toLocaleLowerCase() === market.name.trim().toLocaleLowerCase()
  );
  if (!match) return null;
  const guess = match[1];
  return {
    ank: String(guess.ank || "").trim().split(/\s*[-,]\s*/).filter(Boolean),
    jodi: String(guess.jodi || "").trim().split(/\s*[-,]\s*/).filter(Boolean),
    panna: String(guess.panna || "").trim().split(/\s*[-,]\s*/).filter(Boolean)
  };
}

function guessRevealKey(market) {
  return `dpboss60.expertGuess:${state.user?.phone || "guest"}:${market.name.trim().toLocaleLowerCase()}`;
}

function legacyGuessRevealKey(market) {
  const now = marketNow();
  const dateKey = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
  return `dpboss60.expertGuess:${state.user?.phone || "guest"}:${dateKey}:${market.name.trim().toLocaleLowerCase()}`;
}

function getRevealedGuess(market) {
  try {
    const saved = JSON.parse(localStorage.getItem(guessRevealKey(market)) || "null");
    const now = Date.now();
    const revealDuration = 24 * 60 * 60 * 1000;
    if (saved && typeof saved === "object" && saved.guess && Number.isFinite(saved.revealedAt)) {
      if (now - saved.revealedAt < revealDuration) return saved.guess;
      localStorage.removeItem(guessRevealKey(market));
    } else if (saved && typeof saved === "object") {
      return saved;
    }

    const legacy = JSON.parse(localStorage.getItem(legacyGuessRevealKey(market)) || "null");
    if (legacy && typeof legacy === "object") {
      localStorage.setItem(guessRevealKey(market), JSON.stringify({ revealedAt: now, guess: legacy }));
      return legacy;
    }
    return null;
  } catch (error) {
    notify(`Could not restore the revealed expert numbers: ${error.message || "Invalid saved data."}`, "error");
    return null;
  }
}

function renderExpertGuessing() {
  const period = state.expertGuessingPeriod;
  const markets = state.markets.filter(market =>
    guessingMarketPeriod(market) === period
  );
  const now = marketNow();
  const date = now.toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" });
  return `<section class="expert-guessing-page">
    <header class="expert-guessing-header"><h1>Free Guessing From Experts</h1></header>
    <div class="expert-guessing-banner"><strong>Daily Expert Lucky Numbers</strong><span>${safeText(date)} · Scratch To Reveal · 24 Hours Same</span></div>
    <div class="expert-period-tabs" role="tablist" aria-label="Market session">
      <button type="button" role="tab" aria-selected="${period === "day"}" class="${period === "day" ? "active" : ""}" data-expert-period="day">☀ Day Markets</button>
      <button type="button" role="tab" aria-selected="${period === "night"}" class="${period === "night" ? "active" : ""}" data-expert-period="night">☾ Night Markets</button>
    </div>
    ${state.expertGuessingLoading ? `<div class="empty-state"><strong>Loading expert numbers</strong>Please wait while the latest market tips are fetched.</div>`
      : state.expertGuessingError ? `<div class="empty-state"><strong>Expert numbers unavailable</strong>${safeText(state.expertGuessingError)}<button type="button" class="button button-secondary" data-action="refresh-expert-guessing">Try again</button></div>`
        : markets.length ? `<div class="expert-market-list">${markets.map(market => {
      const revealed = getRevealedGuess(market);
      const guesses = expertGuessFor(market);
      const hasNumbers = Boolean(guesses && Object.values(guesses).some(values => values.length));
      return `<article class="expert-market-card"><h2>${safeText(market.name)}</h2><div class="expert-market-content">
        ${revealed ? `<div class="expert-number-list">${[["ANK", revealed.ank], ["JODI", revealed.jodi], ["PANNA", revealed.panna]].filter(([, number]) => number).map(([label, number]) => `<div><strong>${label}</strong><b>${safeText(Array.isArray(number) ? number.join(" - ") : number)}</b></div>`).join("")}</div>`
          : `<button type="button" class="expert-unlock-button" data-unlock-guess="${safeText(market.id)}" ${hasNumbers ? "" : "disabled"}><span aria-hidden="true">${hasNumbers ? "♙" : "✦"}</span><strong>${hasNumbers ? "Tap To Unlock" : "Tips Coming Soon"}</strong>${hasNumbers ? "" : "<small>Expert numbers will appear here</small>"}</button>`}
        </div></article>`;
    }).join("")}</div>` : `<div class="empty-state"><strong>No ${period} markets available</strong>Market expert tips will appear here when markets are published.</div>`}
    <p class="expert-disclaimer">For entertainment only. Expert numbers are not a promise of results. Play responsibly.</p>
  </section>`;
}

function renderGuessScratch() {
  const market = state.markets.find(item => item.id === state.selectedGuessMarket);
  const guess = market ? expertGuessFor(market) : null;
  if (!market || !guess || !Object.values(guess).some(values => values.length)) {
    return heading("Scratch to reveal", "Expert numbers are not available for this market.");
  }
  const revealed = getRevealedGuess(market);
  return `<section class="guess-scratch-page"><header><div><small>DAILY EXPERT LUCKY NUMBERS</small><h1>${safeText(market.name)}</h1></div></header>
    <div class="guess-scratch-board">${revealed
      ? `<div class="expert-number-list">${[["ANK", revealed.ank], ["JODI", revealed.jodi], ["PANNA", revealed.panna]].filter(([, number]) => number && (!Array.isArray(number) || number.length)).map(([label, number]) => `<div><strong>${label}</strong><b>${safeText(Array.isArray(number) ? number.join(" - ") : number)}</b></div>`).join("")}</div>`
      : `<div class="guess-scratch-cover"><span aria-hidden="true">✦</span><strong>SCRATCH</strong><small>Reveal Expert Numbers</small><button type="button" data-action="scratch-guess">Scratch to reveal</button></div>`}
    </div><p class="expert-disclaimer">For entertainment only. These numbers do not guarantee a result. Play responsibly.</p>
  </section>`;
}

function renderSupportDialog() {
  return `<div class="support-sheet-backdrop" role="presentation">
    <section class="support-sheet" role="dialog" aria-modal="true" aria-labelledby="support-sheet-title">
      <header><span class="support-sheet-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 13a8 8 0 0 1 16 0v4a2 2 0 0 1-2 2h-2v-6h4M4 13h4v6H6a2 2 0 0 1-2-2z"/><path d="M8 20h5"/></svg></span><h2 id="support-sheet-title">Contact Support</h2><button type="button" data-action="close-support" aria-label="Close support">×</button></header>
      <button class="support-sheet-contact whatsapp" type="button" data-action="open-whatsapp"><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.5L3 20l.9-4.7a8.5 8.5 0 1 1 16.6-3.7Z"/><path d="M8 8.2c.3-.6.6-.6.9-.6h.5c.2 0 .4.1.5.4l.8 1.8c.1.2.1.4 0 .5l-.6.8c-.1.2-.1.4 0 .6.5.9 1.2 1.6 2.1 2.1.2.1.4.1.6-.1l.8-.9c.2-.2.4-.2.6-.1l1.7.8c.2.1.3.3.3.5 0 .4-.2 1-.6 1.3-.4.4-1.1.6-1.7.5-1-.1-2.2-.7-3.4-1.7-1.3-1.1-2.2-2.5-2.5-3.5-.3-.9-.2-1.7.1-2.4Z"/></svg></span>WhatsApp</button>
      <button class="support-sheet-contact telegram" type="button" data-action="open-telegram"><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m21 3-7.2 18-3.7-7.1L3 10.2 21 3Z"/><path d="m10.1 13.9 5.3-5.2"/></svg></span>Telegram</button>
    </section>
  </div>`;
}

function renderSupportPage() {
  const contact = configuredSupportContact();
  const hasWhatsApp = Boolean(contact);
  const hasTelegram = isConfiguredExternalUrl(state.telegramUrl);
  const hasGroup = isConfiguredExternalUrl(state.whatsappGroupUrl);
  const cards = [
    {
      title: "Telegram Support",
      description: "Get instant help from our support team on Telegram.",
      action: "open-telegram",
      icon: "➤",
      color: "telegram",
      button: "JOIN NOW",
      enabled: hasTelegram,
      recommended: true
    },
    {
      title: "WhatsApp Support",
      description: "Chat with our support team on WhatsApp.",
      action: "open-whatsapp",
      icon: "◉",
      color: "whatsapp",
      button: "CHAT NOW",
      enabled: hasWhatsApp
    },
    {
      title: "Live Chat",
      description: "Chat live with our support team.",
      action: "open-whatsapp",
      message: "Hello, I need live support with my Sridevi Matka account.",
      icon: "●",
      color: "live-chat",
      button: "START CHAT",
      enabled: hasWhatsApp
    },
    {
      title: "Call Support",
      description: contact ? "Talk to our support team directly." : "A support phone number has not been configured.",
      href: contact ? `tel:${contact.tel}` : "",
      icon: "☎",
      color: "call",
      button: contact ? contact.local : "NOT CONFIGURED",
      enabled: Boolean(contact)
    },
    {
      title: "WhatsApp Group",
      description: "Join our official WhatsApp group for updates and support.",
      action: "open-whatsapp-group",
      icon: "♧",
      color: "group",
      button: "JOIN GROUP",
      enabled: hasGroup
    }
  ];
  const available = hasWhatsApp || hasTelegram || hasGroup;
  return `<section class="madhur-support-page">
    <header class="madhur-support-header">
      <div class="madhur-support-brand"><img src="a2morning-logo.png" alt="A2 Morning"></div>
      <span class="madhur-support-headset" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 13a8 8 0 0 1 16 0v4a2 2 0 0 1-2 2h-2v-6h4M4 13h4v6H6a2 2 0 0 1-2-2z"/><path d="M8 20h5"/></svg></span>
    </header>
    <div class="madhur-support-content">
      <section class="madhur-support-hero">
        <div><h1>Customer Support <span aria-hidden="true">🛡️</span></h1><p>We're here to help you <strong>when you need us</strong></p><small><span aria-hidden="true">🔒</span> Secure &amp; reliable support</small></div>
        <span class="madhur-support-hero-icon" aria-hidden="true"><svg viewBox="0 0 72 72"><path d="M10 38v-8a26 26 0 0 1 52 0v8"/><rect x="7" y="33" width="12" height="22" rx="6"/><rect x="53" y="33" width="12" height="22" rx="6"/><path d="M59 54c-2 8-11 10-20 10"/><rect x="31" y="58" width="10" height="7" rx="3"/><circle cx="29" cy="31" r="4"/><circle cx="41" cy="31" r="4"/><circle cx="53" cy="31" r="4"/></svg></span>
      </section>
      <section class="madhur-support-contact">
        <div class="madhur-support-contact-heading"><h2>CONTACT US</h2><span class="${available ? "available" : "unavailable"}"><i></i>${available ? "Support channels available" : "Support links not configured"}</span></div>
        <div class="madhur-support-grid">${cards.map(card => {
          const element = card.href && card.enabled ? "a" : "button";
          const attributes = card.href && card.enabled
            ? `href="${safeText(card.href)}"`
            : card.enabled
              ? `data-action="${card.action}"${card.message ? ` data-support-message="${safeText(card.message)}"` : ""}`
              : "disabled";
          return `<article class="madhur-support-card ${card.color} ${card.enabled ? "" : "unavailable"} ${card.recommended ? "recommended" : ""}">
            ${card.recommended ? `<span class="madhur-support-recommended">Recommended</span>` : ""}
            <span class="madhur-support-card-icon" aria-hidden="true">${card.icon}</span>
            <h3>${safeText(card.title)}</h3>
            <p>${safeText(card.description)}</p>
            <${element} class="madhur-support-card-button" ${element === "button" ? `type="button"` : ""} ${attributes}>${safeText(card.button)}</${element}>
          </article>`;
        }).join("")}</div>
      </section>
    </div>
  </section>`;
}

function renderGameSelect() {
  const market = state.markets.find(item => item.name === state.selectedMarket);
  if (!market || !marketSessions(market).includes(state.selectedSession)) {
    return heading("Choose game", "This market is no longer open for the selected session.");
  }
  const sessions = marketSessions(market);
  const isRunning = sessions.includes(state.selectedSession);
  return `<section class="aia-game-select-page">
    <header class="aia-game-select-header">
      <button type="button" class="aia-game-select-back" data-action="game-select-back" aria-label="Back to markets"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6M9 12h12"/></svg></button>
      <button type="button" class="aia-game-select-title" data-action="toggle-game-session" aria-label="Switch market session. ${safeText(market.name)} ${safeText(state.selectedSession)} ${isRunning ? "running" : "closed"}">
        <span>${safeText(market.name.toUpperCase())} &nbsp; ${safeText(state.selectedSession.toUpperCase())} ${isRunning ? "RUNNING" : "CLOSED"}</span>
      </button>
      <button type="button" class="aia-game-select-chart" data-market-result="${safeText(market.id)}" aria-label="View ${safeText(market.name)} result chart"><img src="icon-chart.png" alt=""></button>
    </header>
    <div class="aia-game-grid">${GAME_TYPES.filter(game => game !== "Full Sangam" || state.selectedSession === "Open").map(gameTile).join("")}</div>
  </section>`;
}

function isThreeDigitPanel(value) {
  return /^\d{3}$/.test(value) && SANGAM_PANA_SET.has(value);
}

function getMotorNumbers(game, digit) {
  if (!/^\d$/.test(digit)) return [];
  if (["Bulk Jodi", "Group Jodi"].includes(game)) return BULK_JODI_ROWS[Number(digit)];
  const index = digit === "0" ? 9 : Number(digit) - 1;
  if (index < 0 || index > 9) return [];
  if (["SP Motor", "Single Pana", "Single Pana Bulk", "Cycle Pana"].includes(game)) return SP_MOTOR_ROWS[index];
  if (["DP Motor", "Double Pana", "Double Pana Bulk"].includes(game)) return DP_MOTOR_ROWS[index];
  if (game === "TP Motor") return [TP_MOTOR_DIGITS[index]];
  if (game === "SP DP TP") {
    return [...SP_MOTOR_ROWS[index], ...DP_MOTOR_ROWS[index], TP_MOTOR_DIGITS[index]];
  }
  return null;
}

function getBetGridOptions(game, primary = "") {
  const digits = Array.from({ length: 10 }, (_, digit) => String(digit));
  const panels = [...SANGAM_PANA_SET];
  if (["Half Sangam", "Half Sangam A", "Half Sangam B"].includes(game)) {
    return primary ? digits : panels;
  }
  if (game === "Full Sangam") return panels;
  if (["SP Motor", "DP Motor", "TP Motor", "SP DP TP", "Bulk Jodi", "Group Jodi", "Cycle Pana"].includes(game)) {
    return digits;
  }
  if (["Single", "Red Bracket", "Single Digit Bulk"].includes(game)) return digits;
  if (["Jodi", "Digit Based Jodi", "Two Digit Panel"].includes(game)) {
    return Array.from({ length: 100 }, (_, number) => String(number).padStart(2, "0"));
  }
  if (game === "Single Pana" || game === "Single Pana Bulk") return [...SP_PANA_SET];
  if (game === "Double Pana" || game === "Double Pana Bulk") return [...DP_PANA_SET];
  if (game === "Triple Pana") return [...TP_PANA_SET];
  if (game === "Panel") return panels;
  if (game === "Odd Even") return ["Odd", "Even"];
  return [];
}

function buildBetSelections(game, session, primary, secondary) {
  if (["Half Sangam", "Half Sangam A", "Half Sangam B"].includes(game)) {
    const panel = primary;
    const ank = secondary;
    if (!isThreeDigitPanel(panel)) {
      throw new Error("Enter a valid three-digit Sangam panel.");
    }
    if (!/^\d$/.test(ank)) {
      throw new Error("Enter a single digit for the other session.");
    }
    return [session === "Open" ? `${panel}-${ank}` : `${ank}-${panel}`];
  }
  if (game === "Full Sangam") {
    if (session !== "Open") throw new Error("Full Sangam is available only during the Open session.");
    if (!isThreeDigitPanel(primary) || !isThreeDigitPanel(secondary)) {
      throw new Error("Enter valid three-digit Open and Close panels.");
    }
    const openJodi = String(primary.split("").reduce((sum, value) => sum + Number(value), 0) % 10);
    const closeJodi = String(secondary.split("").reduce((sum, value) => sum + Number(value), 0) % 10);
    return [`${primary}-${openJodi}${closeJodi}-${secondary}`];
  }
  if (["Single Digit Bulk", "Single Pana Bulk", "Double Pana Bulk"].includes(game)) {
    const valid = game === "Single Digit Bulk"
      ? value => /^\d$/.test(value)
      : game === "Single Pana Bulk"
        ? value => SP_PANA_SET.has(value)
        : value => DP_PANA_SET.has(value);
    const selections = primary.split(/[\s,]+/).filter(Boolean);
    if (!selections.length || selections.some(value => !valid(value))) {
      throw new Error("Enter valid numbers separated by commas.");
    }
    return [...new Set(selections)];
  }
  if (["SP Motor", "DP Motor", "TP Motor", "SP DP TP", "Bulk Jodi", "Group Jodi", "Cycle Pana"].includes(game)) {
    const numbers = getMotorNumbers(game, primary);
    if (!numbers?.length) throw new Error("Enter one digit from 0 to 9 to select the numbers.");
    return [...new Set(numbers)];
  }
  if (game === "Odd Even") {
    if (primary === "Odd") return ["1", "3", "5", "7", "9"];
    if (primary === "Even") return ["0", "2", "4", "6", "8"];
    throw new Error("Choose Odd or Even.");
  }
  if (game === "Panel") {
    if (!SANGAM_PANA_SET.has(primary)) throw new Error("Enter a valid three-digit panel.");
    return [primary];
  }
  if (["Single", "Red Bracket"].includes(game) && /^\d$/.test(primary)) return [primary];
  if (["Jodi", "Bulk Jodi", "Digit Based Jodi", "Two Digit Panel"].includes(game) && /^\d{2}$/.test(primary)) return [primary];
  if (game === "Single Pana" && SP_PANA_SET.has(primary)) return [primary];
  if (game === "Double Pana" && DP_PANA_SET.has(primary)) return [primary];
  if (game === "Triple Pana" && TP_PANA_SET.has(primary)) return [primary];
  throw new Error("Enter a valid number for the selected game type.");
}

function mergeBetDraft(draft, selections, amount, session, maximumEntry) {
  const nextDraft = draft.map(item => ({ ...item }));
  for (const selection of [...new Set(selections)]) {
    const index = nextDraft.findIndex(item =>
      item.selection === selection && (item.session || session) === session
    );
    const nextAmount = (index < 0 ? 0 : nextDraft[index].amount) + amount;
    if (maximumEntry > 0 && nextAmount > maximumEntry) {
      throw new Error(`Adding these points would bring ${selection} to ${money(nextAmount)}, above the configured per-number maximum of ${money(maximumEntry)}.`);
    }
    if (index < 0) nextDraft.push({ selection, amount, session });
    else nextDraft[index] = { ...nextDraft[index], amount: nextAmount };
  }
  return nextDraft;
}

function betDraftTotals(draft, balance) {
  const total = draft.reduce((sum, item) => sum + item.amount, 0);
  return {
    count: draft.length,
    total,
    remaining: Math.max(0, balance - total),
    shortfall: Math.max(0, total - balance)
  };
}

function renderBetting() {
  const market = state.markets.find(item => item.name === state.selectedMarket);
  if (!market) {
    return heading("Place bid", "Select a market to continue.");
  }
  const { total, remaining, shortfall: balanceShortfall } = betDraftTotals(state.betDraft, state.balance);
  const maximumBetAmount = state.maximumEntry > 0 ? state.maximumEntry : "";
  const panaGame = /pana|panel/i.test(state.selectedGame);
  const marketAvailableSessions = marketSessions(market);
  const availableSessions = state.selectedGame === "Full Sangam"
    ? marketAvailableSessions.filter(session => session === "Open")
    : marketAvailableSessions;
  if (availableSessions.length && !availableSessions.includes(state.selectedSession)) {
    state.selectedSession = availableSessions[0];
  }
  const sessionOptions = availableSessions.length ? availableSessions : [state.selectedSession];
  const sessionSelector = `<div class="aia-entry-session"><label for="bet-session">Select Session :</label><select id="bet-session" name="session" ${availableSessions.length ? "" : "disabled"}>${sessionOptions.map(session => `<option value="${session}" ${state.selectedSession === session ? "selected" : ""}>${session}</option>`).join("")}</select></div>`;
  const unavailableMessage = state.maintenance
    ? "Game play is temporarily unavailable during maintenance."
    : state.accountBlocked ? "This account is blocked from placing games."
      : !availableSessions.includes(state.selectedSession) ? "The selected market session is currently unavailable." : "";
  const sangam = ["Half Sangam", "Half Sangam A", "Half Sangam B", "Full Sangam"].includes(state.selectedGame);
  const halfSangam = ["Half Sangam", "Half Sangam A", "Half Sangam B"].includes(state.selectedGame);
  const amountInput = `<input id="bet-amount" name="amount" type="number" min="${state.minimumEntry > 0 ? state.minimumEntry : 1}" ${maximumBetAmount ? `max="${maximumBetAmount}"` : ""} step="1" inputmode="numeric" value="${safeText(state.betEntryAmount || defaultBetAmount())}" ${unavailableMessage ? "disabled" : ""}>`;
  const gridOptions = getBetGridOptions(state.selectedGame, state.betGridPrimary);
  const isMotor = ["SP Motor", "DP Motor", "TP Motor", "SP DP TP", "Bulk Jodi", "Group Jodi", "Cycle Pana"].includes(state.selectedGame);
  const gridTitle = sangam
    ? !state.betGridPrimary
      ? state.selectedGame === "Full Sangam" ? "Select Open Panel" : `${state.selectedSession} Panel`
      : halfSangam
        ? state.selectedSession === "Open" ? "Select Close Ank" : "Select Open Ank"
        : "Select Close Panel"
    : isMotor ? "Choose a digit to add its existing motor numbers"
      : state.selectedGame === "Odd Even" ? "Choose Odd or Even"
        : "Choose a number";
  const grid = `<section class="aia-bet-grid-section" aria-label="${safeText(gridTitle)}">
      <div class="aia-bet-grid-heading"><strong>${safeText(gridTitle)}</strong>${state.betGridPrimary ? `<button type="button" data-action="reset-grid-pick">Change first selection</button>` : ""}</div>
      <div class="aia-bet-number-grid ${gridOptions.length > 40 ? "aia-bet-number-grid-dense" : ""}" role="group" aria-label="${safeText(gridTitle)}">
        ${gridOptions.map(value => {
          let selected = false;
          let selectedAmount = 0;
          if (sangam && !state.betGridPrimary) selected = value === state.betGridPrimary;
          else if (!sangam) {
            const generated = buildBetSelections(state.selectedGame, state.selectedSession, value, "");
            selected = generated.every(selection => state.betDraft.some(item =>
              item.selection === selection && (item.session || state.selectedSession) === state.selectedSession
            ));
            selectedAmount = generated.reduce((sum, selection) => sum + state.betDraft
              .filter(item => item.selection === selection && (item.session || state.selectedSession) === state.selectedSession)
              .reduce((itemSum, item) => itemSum + item.amount, 0), 0);
          } else selected = value === state.betGridPrimary;
          return `<button type="button" class="${selected ? "selected" : ""}" data-bet-grid-select="${safeText(value)}" aria-pressed="${selected}" ${unavailableMessage || remaining < (state.minimumEntry || 1) ? "disabled" : ""}>
            <span>${safeText(value)}</span>${selectedAmount ? `<small>${money(selectedAmount)}</small>` : ""}
          </button>`;
        }).join("")}
      </div>
      ${sangam ? `<p class="aia-bet-grid-hint">${state.betGridPrimary ? `${safeText(state.betGridPrimary)} selected. Choose the next value to complete this ${halfSangam ? "Half Sangam" : "Full Sangam"} bid.` : "Choose the first panel to continue."}</p>` : ""}
    </section>`;
  const entryFields = `<div class="aia-entry-fields aia-number-entry-fields">
      ${sessionSelector}
      <label for="bet-amount">Enter Points :</label>${amountInput}
    </div>`;
  const draftRows = state.betDraft.map((item, index) => {
    const selection = `<strong>${safeText(item.selection)}</strong>`;
    const amount = `<strong>${money(item.amount)} <button type="button" data-remove-bet="${index}" aria-label="Remove ${safeText(item.selection)}">×</button></strong>`;
    const session = `<span>${safeText(item.session || state.selectedSession)}</span>`;
    return `<div class="aia-draft-row">${selection}${panaGame ? session + amount : amount + session}</div>`;
  }).join("");
  return `<section class="aia-game-select-page aia-video-bet-page">
    <header class="aia-game-select-header aia-bet-header">
      <button type="button" data-action="bet-back" aria-label="Back to game list"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18 9 12l6-6M9 12h12"/></svg></button>
      <strong class="aia-video-bet-title">${safeText(market.name)} · ${safeText(gameDisplayName(state.selectedGame))}</strong>
      <span class="aia-video-bet-balance">${money(state.balance)}</span>
    </header>
    <section class="aia-bet-heading"><strong>${safeText(market.name)} <span>›</span> ${safeText(state.selectedSession)} <span>›</span> ${safeText(legacyGameType(state.selectedGame))}</strong></section>
    ${unavailableMessage ? `<div class="warning-box">${safeText(unavailableMessage)}</div>` : ""}
    <form id="bid-form" class="aia-bet-form">
      ${entryFields}
      ${grid}
      <section class="aia-draft-card">
        <div class="aia-draft-columns"><span>${panaGame ? "PANNA" : /jodi/i.test(state.selectedGame) ? "JODI" : "DIGIT"}</span><span>${panaGame ? "TYPE" : "POINTS"}</span><span>${panaGame ? "POINTS" : "SESSION"}</span><button type="button" data-action="clear-bet-draft" ${state.betDraft.length ? "" : "disabled"}>Clear</button></div>
        <div class="aia-draft-list">${draftRows || `<div class="aia-draft-empty">No bid added yet</div>`}</div>
        <div class="aia-draft-totals"><span>Total : <strong>${money(total)}</strong></span><span>${balanceShortfall ? "Over wallet :" : "Left Points :"} <strong class="${balanceShortfall ? "aia-bet-over-balance" : ""}">${money(balanceShortfall || remaining)}</strong></span></div>
      </section>
      <div class="aia-video-bet-footer">
        <div class="aia-video-bet-total"><small>Total bid amount · ${state.betDraft.length} bids</small><strong>${money(total)}</strong>${balanceShortfall ? `<small class="aia-bet-balance-warning" role="alert">Over wallet by ${money(balanceShortfall)}; reduce bids to continue.</small>` : ""}</div>
        <button class="aia-yellow-button aia-submit-button" type="submit" ${!state.betDraft.length || unavailableMessage || balanceShortfall ? "disabled" : ""}>PLACE BET</button>
      </div>
    </form>
  </section>`;
}

function renderCharts() {
  return `${heading("Result chart", "Latest market results from the app's market database.")}
    <div class="filter-row">${availableMarketCategories().map(category => `<button type="button" class="filter-chip ${state.category === category ? "active" : ""}" data-category="${safeText(category)}">${safeText(category)}</button>`).join("")}<button type="button" class="text-button" data-action="refresh">↻ Auto Refresh results</button></div>
    ${marketCards(state.markets.filter(market => state.category === "Main"
      ? !/starline|gali|disawar/i.test(market.category)
      : state.category === "Starline" ? /starline/i.test(market.category) : /gali|disawar/i.test(market.category)))}
    <div class="warning-box">Market results are updated automatically.</div>`;
}

function renderChartMarketList() {
  const markets = marketsForCategory(state.category);
  if (!markets.length) {
    const detail = state.marketLoadError || "Market data will appear here when it is available.";
    return `<section class="chart-market-page"><header><h1>Market Result</h1></header><div class="empty-state"><strong>No markets available</strong>${safeText(detail)}</div></section>`;
  }
  return `<section class="chart-market-page">
    <header><h1>Market Result</h1></header>
    <div class="chart-market-list">${markets.map(market => `<article class="chart-market-row">
      <strong>${safeText(market.name)}</strong>
      <button type="button" data-market-result="${safeText(market.id)}" aria-label="View panel result for ${safeText(market.name)}">Panel</button>
    </article>`).join("")}</div>
  </section>`;
}

function panelChartDate(value) {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return null;
  const [year, month, day] = value.split("-").map(Number);
  const date = new Date(year, month - 1, day);
  return date.getFullYear() === year && date.getMonth() === month - 1 && date.getDate() === day
    ? date : null;
}

function panelChartDateKey(date) {
  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
}

function panelChartResultParts(record) {
  const source = typeof record === "string" ? record
    : record && typeof record === "object"
      ? record.closeResult || record.openResult || record.result || "" : "";
  return String(source).split(/\s*-\s*/).map(part => part.trim()).filter(Boolean).slice(0, 3);
}

function renderPanelChart() {
  const records = state.panelResults && typeof state.panelResults === "object" ? state.panelResults : {};
  const validDates = Object.keys(records).filter(date => panelChartDate(date));
  const sortedDates = validDates.map(panelChartDate).sort((left, right) => left - right);
  const today = new Date();
  const start = sortedDates.length ? sortedDates[0] : today;
  const end = sortedDates.length && sortedDates[sortedDates.length - 1] > today
    ? sortedDates[sortedDates.length - 1] : today;
  const firstMonday = new Date(start.getFullYear(), start.getMonth(), start.getDate());
  firstMonday.setDate(firstMonday.getDate() - ((firstMonday.getDay() + 6) % 7));
  const lastMonday = new Date(end.getFullYear(), end.getMonth(), end.getDate());
  lastMonday.setDate(lastMonday.getDate() - ((lastMonday.getDay() + 6) % 7));
  let rows = "";
  for (const week = new Date(firstMonday); week <= lastMonday; week.setDate(week.getDate() + 7)) {
    const weekEnd = new Date(week);
    weekEnd.setDate(weekEnd.getDate() + 6);
    const dates = Array.from({ length: 7 }, (_, index) => {
      const date = new Date(week);
      date.setDate(date.getDate() + index);
      const record = records[panelChartDateKey(date)];
      const parts = panelChartResultParts(record);
      const updated = Boolean(record?.updatedAt
        && new Date(record.updatedAt).toDateString() === new Date().toDateString());
      const value = parts.length ? parts.join(" - ") : "### - ## - ###";
      return `<td><div class="panel-chart-result ${parts.length ? "" : "missing"} ${updated ? "updated" : ""}">${safeText(value)}</div></td>`;
    }).join("");
    rows += `<tr><th scope="row">${String(week.getDate()).padStart(2, "0")}-${String(week.getMonth() + 1).padStart(2, "0")}-${week.getFullYear()}<br>TO<br>${String(weekEnd.getDate()).padStart(2, "0")}-${String(weekEnd.getMonth() + 1).padStart(2, "0")}-${weekEnd.getFullYear()}</th>${dates}</tr>`;
  }
  const status = state.panelResultsLoading
    ? `<p class="panel-chart-status" role="status">Loading panel results from Firebase…</p>`
    : state.panelResultsError
      ? `<p class="panel-chart-status error" role="alert">${safeText(state.panelResultsError)}</p>`
      : !validDates.length
        ? `<p class="panel-chart-status" role="status">No panel results have been published for this market yet.</p>` : "";
  return `<section class="panel-chart-page">
    <header><h1>${safeText(state.selectedPanelMarket)} Panel Chart</h1><button type="button" data-action="refresh-panel-chart" aria-label="Refresh results">↻</button></header>
    ${status}
    ${validDates.length ? `<div class="panel-chart-scroll"><table><thead><tr><th>Date</th><th>MON</th><th>TUE</th><th>WED</th><th>THU</th><th>FRI</th><th>SAT</th><th>SUN</th></tr></thead><tbody>${rows}</tbody></table></div>` : ""}
  </section>`;
}

function pendingRequests() {
  return [...state.depositHistory, ...state.withdrawalHistory].filter(item => /pending/i.test(String(item.status || "pending"))).length;
}

function historyTable(items, kind) {
  if (!items.length) return `<div class="empty-state"><strong>No ${kind} yet</strong>When you ${kind === "bids" ? "submit a bid" : "make a points transaction"}, it will appear here.</div>`;
  const rows = [...items].reverse().map(item => `<tr>
    <td><strong>${safeText(item.title || item.market || item.type || kind)}</strong><br><small>${safeText(item.gameType || item.selection || item.method || "")}</small></td>
    <td>${safeText(dateText(item.createdAt || item.date || item.timestamp))}</td>
    <td>${safeText(item.amount ?? item.points ?? "—")}</td>
    <td><span class="status-pill ${/pending|reject/i.test(item.status || "") ? "closed" : ""}">${safeText(item.status || "Recorded")}</span></td>
  </tr>`).join("");
  return `<div class="table-wrap"><table><thead><tr><th>${kind === "bids" ? "Market / game" : "Activity"}</th><th>Date</th><th>Points</th><th>Status</th></tr></thead><tbody>${rows}</tbody></table></div>`;
}

function renderHistory(kind) {
  const isBids = kind === "bids";
  if (isBids) return renderAiaBidsHistory();
  return renderAiaPointsHistory();
}

function legacyDateLabel(value) {
  const match = String(value || "").match(/^(\d{2})-(\d{2})-(\d{4})$/);
  if (!match) return String(value || "—");
  const date = new Date(Number(match[3]), Number(match[2]) - 1, Number(match[1]));
  return `${match[1]}-${match[2]}-${match[3]} ${date.toLocaleDateString("en-IN", { weekday: "long" })}`;
}

function bidTime(item) {
  const payload = Array.isArray(item.payload) ? item.payload : [];
  const storedTime = String(payload[4] || "");
  return storedTime || String(item.createdAt || "").match(/T(\d{2}:\d{2}:\d{2})/)?.[1] || "—";
}

function renderAiaBidsHistory() {
  if (!state.bids.length) {
    return `${heading("My Biddings", "Your submitted bids appear here.")}<div class="empty-state"><strong>No bids yet</strong>Place a bid from the Games tab to see your history.</div>`;
  }
  const dates = new Map();
  for (const bid of state.bids) {
    if (!dates.has(bid.date)) dates.set(bid.date, new Map());
    const markets = dates.get(bid.date);
    const market = bid.market || bid.title || "Bid";
    if (!markets.has(market)) markets.set(market, []);
    markets.get(market).push(bid);
  }
  return `<section class="aia-history-page"><h1>My Biddings</h1>${[...dates.entries()].sort(([a],[b]) => b.localeCompare(a)).map(([date, markets]) => `
    <div class="aia-date-banner">${safeText(legacyDateLabel(date))}</div>
    ${[...markets.entries()].map(([market, bids]) => `<section class="aia-history-market">
      <h2>${safeText(market)}</h2>
      <div class="aia-history-columns"><span>Time</span><span>Type</span><span>Number</span><span>Points</span></div>
      ${bids.slice().sort((a,b) => String(b.id).localeCompare(String(a.id))).map(bid => `<div class="aia-history-row"><span>${safeText(bidTime(bid))}</span><span>${safeText(bid.session || bid.payload?.[1] || "Open")}</span><span>${safeText(bid.selection || bid.payload?.[2] || "")}</span><span>${safeText(bid.amount ?? bid.payload?.[3] ?? "")}</span></div>`).join("")}
    </section>`).join("")}`).join("")}</section>`;
}

function renderAiaPointsHistory() {
  const bids = state.bids;
  const played = bids.reduce((sum, item) => sum + Number(item.amount || 0), 0);
  const details = [...state.pointsHistory].sort((a, b) => String(b.id || b.createdAt).localeCompare(String(a.id || a.createdAt)));
  return `<section class="aia-history-page"><h1>Points history</h1>
    <div class="aia-points-summary"><p>Total Played : <strong>${money(played)}</strong></p><p>Remaining Points : <strong>${money(state.balance)}</strong></p><p>${bids.length} Numbers Played</p></div>
    ${details.length ? `<div class="aia-point-list">${details.map(item => {
      const isBid = item.type === "Bid" || item.session;
      const gameType = item.gameType || item.payload?.[0] || "";
      return `<article class="aia-point-card"><span class="aia-point-direction ${isBid ? "out" : ""}">${isBid ? "≪" : "≫"}</span><div><p>Points : ${safeText(item.amount ?? item.points ?? 0)}</p>${isBid ? `<p>${safeText(gameType)} <strong>${safeText(item.selection || "")}</strong></p>` : ""}<p>${safeText(legacyDateLabel(item.date || ""))} &nbsp; ${safeText(bidTime(item))}</p><p>${safeText(item.market || item.title || item.type || "Points activity")} &nbsp; - &nbsp; ${safeText(item.session || item.status || "Recorded")}</p>${item.upiAppStatus ? `<p>${safeText(item.upiAppStatus)}</p>` : ""}${item.reference ? `<p>Transaction ID : <strong>${safeText(item.reference)}</strong></p>` : ""}</div></article>`;
    }).join("")}</div>` : `<div class="empty-state"><strong>No points activity yet</strong>Bid and wallet activity will appear here.</div>`}
  </section>`;
}

function renderDirectPayment() {
  const minimum = Math.max(1, state.paymentMinimumDeposit);
  const message = state.paymentMessage
    ? `<div class="direct-payment-message">${safeText(state.paymentMessage)}</div>`
    : `<div class="payment-setting-warning">Payment instructions are not configured in Admin/Admin/Upi Msg. Contact support before paying.</div>`;
  const upiAccount = state.paymentUpiId
    ? `<div class="payment-upi-row"><span><small>PAYING TO</small><strong>${safeText(state.paymentUpiId)}</strong></span><button class="button button-secondary" type="button" data-action="copy-upi">Copy</button></div>`
    : `<div class="payment-setting-warning">UPI ID has not been configured in Firebase (Admin/Admin/upi_id). Direct payment is unavailable.</div>`;
  const headingMarkup = heading("Add points", "");
  const reportedStatus = {
    SUCCESS: ["Payment app reported success", "success"],
    FAILED: ["Payment app reported failure", "failed"],
    CANCELLED: ["Payment app reported cancellation", "pending"],
    PENDING: ["Payment app reported pending", "pending"],
    UNKNOWN: ["Payment app did not return a status", "pending"]
  }[state.directPaymentStatus] || ["Payment status not received", "pending"];

  if (state.directPaymentReturned) {
    if (["FAILED", "CANCELLED"].includes(state.directPaymentStatus)) {
      return `${headingMarkup}<div class="profile-grid deposit-page-grid"><section class="panel deposit-panel direct-payment-panel">
        <div class="panel-heading"><h2>Payment attempt</h2><small>Current balance: ${money(state.balance)}</small></div>
        <div class="direct-payment-result ${reportedStatus[1]}"><strong>${reportedStatus[0]}</strong><p>No points were added. You can return and choose another amount or payment app.</p></div>
        <button class="button button-primary" type="button" data-action="direct-payment-restart">Try another payment</button>
        ${state.directPaymentFailureRecorded ? `<span class="payment-step-label">${state.directPaymentStatus === "FAILED" ? "Failed" : "Cancelled"} attempt recorded in Points history</span>` : ""}
      </section></div>`;
    }
    return `${headingMarkup}<div class="profile-grid deposit-page-grid"><section class="panel deposit-panel direct-payment-panel">
      <div class="panel-heading"><h2>Submit payment for verification</h2><small>Current balance: ${money(state.balance)}</small></div>
      <div class="direct-payment-result ${reportedStatus[1]}"><strong>${reportedStatus[0]}</strong><p>This UPI-app response is not bank-verified. Your wallet will be credited only after admin verification.</p></div>
      <section class="payment-details"><span class="deposit-security-icon" aria-hidden="true">₹</span><h3>Payment details</h3><p>Enter the transaction reference from your UPI app. The deposit request remains pending until an administrator verifies the transfer.</p>${message}${upiAccount}</section>
      <form id="deposit-form" class="form-stack">
        <input type="hidden" name="method" value="UPI Direct">
        <input type="hidden" name="upiAppStatus" value="${state.directPaymentStatus === "SUCCESS" ? "UPI app reported success (unverified)" : ""}">
        <label class="field">Amount (₹)<input name="amount" type="number" min="${minimum}" max="1000000" step="0.01" value="${safeText(state.directPaymentAmount)}" readonly required></label>
        <label class="field">UPI transaction ID<input name="reference" type="text" maxlength="100" autocomplete="off" value="${safeText(state.directPaymentReference)}" required placeholder="Enter the transaction ID from your UPI app"></label>
        <button class="button button-primary" type="submit">Submit for admin verification <span>→</span></button>
        <button class="button button-secondary" type="button" data-action="direct-payment-restart">Payment did not complete? Choose another amount</button>
      </form>
      <div class="warning-box">Your request will stay pending. Do not submit again if you have already sent this payment for verification.</div>
    </section></div>`;
  }

  return `${headingMarkup}<div class="profile-grid deposit-page-grid"><section class="panel deposit-panel direct-payment-panel">
    <div class="panel-heading"><h2>Direct UPI payment</h2><small>Current balance: ${money(state.balance)}</small></div>
    <form id="direct-payment-form" class="form-stack">
      <label class="field direct-payment-amount">Amount (₹)<input name="amount" type="number" inputmode="decimal" min="${minimum}" max="1000000" step="0.01" required placeholder="Enter amount"></label>
      <span class="payment-step-label">Minimum payment: ${money(minimum)}</span>
      <div class="quick-amounts">${[500,1000,2000,5000].map(amount => `<button class="quick-amount" type="button" data-amount="${amount}">₹${amount.toLocaleString("en-IN")}</button>`).join("")}</div>
      ${message}${upiAccount}
      <button class="button button-primary" type="submit" ${state.paymentUpiId ? "" : "disabled"}>Continue to UPI app <span>→</span></button>
    </form>
    ${state.directPaymentLaunched ? `<div class="payment-pending-card"><strong>Complete your payment in the UPI app</strong><p>When you return, the app may report a status. That response is not bank-verified; wallet points are added only after admin approval.</p>${!window.ReactNativeWebView ? `<button class="button button-secondary" type="button" data-action="direct-payment-returned">I have returned from the UPI app</button>` : ""}</div>` : ""}
    ${configuredSupportContact() ? `<button class="button button-secondary deposit-whatsapp-button" type="button" data-action="deposit-whatsapp">Need help? Chat on WhatsApp</button>` : ""}
  </section></div>`;
}

function renderDeposit() {
  if (state.paymentGatewayEnabled && state.paymentApiUrl) {
    let pendingPayment = null;
    try {
      pendingPayment = state.user ? readPendingPayment(state.user.phone) : null;
    } catch (error) {
      notify(error.message || "Could not restore payment status.", "error");
    }
    const lastStatus = pendingPayment?.lastStatus
      ? `Last gateway status: ${safeText(pendingPayment.lastStatus)}${pendingPayment.lastCheckedAt ? ` (${safeText(new Date(pendingPayment.lastCheckedAt).toLocaleString())})` : ""}.`
      : "The gateway has not confirmed this payment yet.";
    const retrySeconds = pendingPayment ? paymentRetrySeconds(pendingPayment) : 0;
    return `${heading("Deposit points", "Pay securely and points are added after the gateway confirms payment.")}
      <div class="profile-grid deposit-page-grid"><section class="panel deposit-panel"><div class="panel-heading"><h2>New payment</h2><small>Current balance: ${money(state.balance)}</small></div>
        <form id="deposit-form" class="form-stack">
          <section class="payment-details"><span class="deposit-security-icon" aria-hidden="true">₹</span><h3>Secure payment</h3><p>Choose an amount to open the payment page. Points are added only after payment is confirmed.</p></section>
          <label class="field">Points amount (₹)<input name="amount" type="number" min="1" max="1000000" step="0.01" required placeholder="Enter amount" ${retrySeconds ? "disabled" : ""}></label>
          <div class="quick-amounts">${[100,200,500,700,900,1500,2000,5000].map(amount => `<button class="quick-amount" type="button" data-amount="${amount}" ${retrySeconds ? "disabled" : ""}>₹${amount.toLocaleString("en-IN")}</button>`).join("")}</div>
          <button class="button button-primary" type="submit" ${retrySeconds ? "disabled" : ""}>Continue to secure payment <span>→</span></button>
        </form>
        ${pendingPayment ? `<div class="payment-pending-card"><strong>Payment pending</strong><span>Order ${safeText(pendingPayment.orderId)}</span><p>${lastStatus} Your pending payment will keep checking automatically.</p><p>${retrySeconds > 0 ? `You can start another payment in ${retrySeconds} seconds.` : "You can start another payment now, but do so only if you did not complete this payment; if both payments succeed, both may be credited."}</p><span class="payment-retry-timer" data-payment-retry-countdown data-created-at="${safeText(pendingPayment.createdAt || "")}">${retrySeconds ? `00:${String(retrySeconds).padStart(2, "0")}` : "Ready"}</span>${pendingPayment.checkoutUrl ? `<button class="button button-secondary" type="button" data-action="reopen-pending-payment">Reopen secure payment</button>` : ""}<button class="button button-secondary" type="button" data-action="check-pending-payment">Check payment status now</button></div>` : ""}
        ${pendingPayment ? "" : `<div class="warning-box">If payment is pending, wait for the gateway status confirmation before starting another payment.</div>`}
      </section></div>`;
  }
  if (state.paymentDirectEnabled) return renderDirectPayment();
  if (!state.paymentQrEnabled) {
    return `${heading("Deposit points", "Choose a payment method to add points to your account.")}
      <div class="profile-grid deposit-page-grid"><section class="panel deposit-panel">
        <div class="payment-setting-warning">Online payments are not currently configured. Please contact support.</div>
        ${configuredSupportContact() ? `<button class="button button-secondary" type="button" data-action="deposit-whatsapp">Contact support on WhatsApp</button>` : ""}
      </section></div>`;
  }
  let qrMarkup;
  try {
    const source = paymentQrSource();
    qrMarkup = `<img class="payment-qr-image" src="${safeText(source)}" alt="Scan this payment QR code">`;
  } catch (error) {
    qrMarkup = `<div class="payment-qr-placeholder"><strong>Payment QR unavailable</strong><span>${safeText(error.message)}</span></div>`;
  }
  const upiMarkup = state.paymentUpiId
    ? `<div class="payment-upi-row"><span><small>UPI ID</small><strong>${safeText(state.paymentUpiId)}</strong></span><button class="button button-secondary" type="button" data-action="copy-upi">Copy</button></div>`
    : `<div class="payment-setting-warning">UPI ID has not been configured in Firebase (Admin/Admin/upi_id).</div>`;
  return `${heading("Deposit points", "Add points using UPI.")}
    <div class="profile-grid deposit-page-grid"><section class="panel deposit-panel">
      <div class="panel-heading"><h2>New deposit request</h2><small>Current balance: ${money(state.balance)}</small></div>
      <form id="deposit-form" class="form-stack">
        <section class="payment-details"><span class="deposit-security-icon" aria-hidden="true">₹</span><h3>Pay using UPI</h3>${qrMarkup}${upiMarkup}<p>Scan or copy UPI, then enter the transaction ID.</p><span class="payment-step-label">Points added after admin approval</span></section>
        <label class="field">Points amount (₹)<input name="amount" type="number" min="1" step="1" required placeholder="Enter amount"></label>
        <div class="quick-amounts">${[500,1000,2000,5000].map(amount => `<button class="quick-amount" type="button" data-amount="${amount}">₹${amount.toLocaleString("en-IN")}</button>`).join("")}</div>
        <label class="field">Transaction ID<input name="reference" type="text" maxlength="100" autocomplete="off" required placeholder="Enter your UPI transaction ID"></label>
        <button class="button button-primary" type="submit">I have paid — submit request <span>→</span></button>
      </form>
    </section></div>`;
}

function timeMinutes(value) {
  const match = String(value || "").match(/^(\d{2}):(\d{2})$/);
  if (!match) return null;
  const hour = Number(match[1]);
  const minute = Number(match[2]);
  return hour <= 23 && minute <= 59 ? hour * 60 + minute : null;
}

function formatTime12(value) {
  const minutes = timeMinutes(value);
  if (minutes === null) return "—";
  const hour24 = Math.floor(minutes / 60);
  const hour = hour24 % 12 || 12;
  return `${String(hour).padStart(2, "0")}:${String(minutes % 60).padStart(2, "0")} ${hour24 >= 12 ? "PM" : "AM"}`;
}

function withdrawalWindowAt(date = marketNow()) {
  const minute = date.getHours() * 60 + date.getMinutes();
  const windows = Object.entries(state.withdrawalWindows).map(([period, window]) => ({
    period,
    open: window.open,
    close: window.close,
    openMinute: timeMinutes(window.open),
    closeMinute: timeMinutes(window.close)
  })).filter(window => window.openMinute !== null && window.closeMinute !== null
    && window.openMinute !== window.closeMinute);
  const active = windows.find(window => window.openMinute < window.closeMinute
    ? minute >= window.openMinute && minute < window.closeMinute
    : minute >= window.openMinute || minute < window.closeMinute);
  const next = active || windows.find(window => window.openMinute > minute) || windows[0] || null;
  return { open: Boolean(active), active, next, windows };
}

function renderWithdrawalTiming(access) {
  const window = access.active || access.next;
  if (!window) return `<p class="withdrawal-balance-hours">Withdrawal hours have not been configured.</p>`;
  return `<div class="withdrawal-balance-hours"><span><small>Open Time:</small>&nbsp;${formatTime12(window.open)}&nbsp;|&nbsp;<small>Close Time:</small>&nbsp;${formatTime12(window.close)}</span></div>`;
}

function renderWithdraw() {
  const saved = savedWithdrawalDetails();
  const access = withdrawalWindowAt();
  const hasSavedDetails = hasWithdrawalDestination(saved);
  const bankAccount = Boolean(saved.holderName && saved.ifsc && saved.accountNumber);
  const destination = bankAccount
    ? `${saved.holderName} · ${saved.accountNumber}`
    : saved.phonePay ? `PhonePe · ${saved.phonePay}` : saved.googlePay ? `Google Pay · ${saved.googlePay}` : "";
  return `<header class="withdraw-page-header"><h1>Withdraw</h1><span></span></header>
    <div class="profile-grid withdraw-page-grid"><section class="panel withdraw-panel"><div class="panel-heading"><h2>New withdrawal request</h2><small>Available: ${money(state.balance)}</small></div>
      <section class="withdrawal-balance-card"><div><small>AVAILABLE BALANCE</small><strong>${money(state.balance)}</strong></div><span class="withdrawal-status-pill ${access.open ? "open" : "closed"}">${access.open ? "OPEN" : "CLOSED"}</span>${renderWithdrawalTiming(access)}</section>
      <form id="withdraw-form" class="form-stack">
        ${hasSavedDetails ? `<input type="hidden" name="holderName" value="${safeText(saved.holderName || "")}"><input type="hidden" name="ifsc" value="${safeText(saved.ifsc || "")}"><input type="hidden" name="accountNumber" value="${safeText(saved.accountNumber || "")}"><input type="hidden" name="phonePay" value="${safeText(saved.phonePay || "")}"><input type="hidden" name="googlePay" value="${safeText(saved.googlePay || "")}">` : ""}
        <section class="withdrawal-saved-destination ${hasSavedDetails ? "saved" : "missing"}">
          <span><strong>${hasSavedDetails ? "Withdrawal account" : "Add withdrawal account"}</strong><small>${hasSavedDetails ? safeText(destination) : "Save your bank or UPI details before requesting a withdrawal."}</small></span>
          <button type="button" data-action="edit-bank-details">${hasSavedDetails ? "EDIT" : "ADD"}</button>
        </section>
        <section class="withdrawal-amount-card"><h2><span aria-hidden="true">₹</span> Withdrawal Amount</h2>
          <label class="field withdrawal-amount-field"><span class="hidden">Amount (₹)</span><input name="amount" type="number" min="1" step="1" value="${safeText(saved.amount || "")}" required placeholder="Enter amount here" ${access.open ? "" : "disabled"}></label>
          <div class="withdrawal-limits"><span>↓ &nbsp;Min: ${state.minimumWithdrawal ? money(state.minimumWithdrawal) : "—"}</span><span>↑ &nbsp;Max: ${money(state.balance)}</span></div>
          <button class="button button-primary withdrawal-submit" type="submit" ${access.open && hasSavedDetails ? "" : "disabled"}><span aria-hidden="true">✥</span> Submit Withdrawal</button>
          <div class="withdrawal-rules"><h3><span aria-hidden="true">☷</span> Withdraw Rules</h3><p><b>• &nbsp;Withdraw Money Rules</b><br>${state.minimumWithdrawal ? `Minimum Withdrawal: At least ${money(state.minimumWithdrawal)} per request.` : "Withdrawal requests must be within your available wallet balance."}${state.withdrawTiming ? `<br><br>${safeText(state.withdrawTiming)}` : ""}</p></div>
        </section>
      </form><div class="withdrawal-security-note"><span aria-hidden="true">⬟</span><b>Saved bank details will be verified before submitting your withdrawal request.</b></div>
      ${state.withdrawalDialogVisible && !access.open ? `<div class="mama-dialog-backdrop withdrawal-dialog-backdrop" role="presentation"><section class="mama-dialog withdrawal-closed-dialog" role="dialog" aria-modal="true" aria-labelledby="withdrawal-closed-title"><div class="withdrawal-info-icon" aria-hidden="true">i</div><div class="mama-dialog-body"><h2 id="withdrawal-closed-title">Cannot withdraw at this time</h2>${access.next ? `<p><strong>Open Time:</strong> ${formatTime12(access.next.open)}<br><strong>Close Time:</strong> ${formatTime12(access.next.close)}</p>` : `<p>Withdrawal times have not been configured.</p>`}<button class="button button-primary" type="button" data-action="dismiss-withdrawal-dialog">OK</button></div></section></div>` : ""}
      ${state.insufficientWithdrawalAmount !== null ? `<div class="mama-dialog-backdrop withdrawal-dialog-backdrop" role="presentation"><section class="mama-dialog insufficient-balance-dialog" role="dialog" aria-modal="true" aria-labelledby="insufficient-balance-title"><div class="insufficient-balance-icon" aria-hidden="true">▣</div><div class="mama-dialog-body"><h2 id="insufficient-balance-title">Insufficient Balance</h2><p>Your wallet balance is lower than the requested withdrawal amount.</p><div class="insufficient-balance-summary"><span>Requested Amount <b>${money(state.insufficientWithdrawalAmount)}</b></span><span>Available Balance <b>${money(state.balance)}</b></span></div><div class="insufficient-balance-actions"><button class="button button-primary" type="button" data-action="add-withdrawal-details">Add withdrawal details</button><button class="button button-secondary" type="button" data-action="dismiss-insufficient-balance">OK</button></div></div></section></div>` : ""}
    </section><section class="panel"><div class="panel-heading"><h2>Recent withdrawal requests</h2></div>${historyTable(state.withdrawalHistory, "withdrawals")}</section></div>`;
}

function renderBankDetails() {
  const saved = savedWithdrawalDetails();
  return `<section class="bank-details-page">
    <header><h1>Bank Details</h1></header>
    <section class="bank-details-card">
      <div class="bank-details-intro"><span aria-hidden="true">▣</span><span><strong>${hasWithdrawalDestination(saved) ? "Withdrawal account details" : "Add withdrawal account details"}</strong><small>Bank account, PhonePe, or Google Pay</small></span><b aria-hidden="true">⌄</b></div>
      <form id="bank-details-form" class="bank-details-form">
        <label class="field">Account holder name<input name="holderName" type="text" maxlength="80" autocomplete="name" value="${safeText(saved.holderName || "")}" placeholder="Name on bank account"></label>
        <label class="field">IFSC code<input name="ifsc" type="text" maxlength="20" autocomplete="off" value="${safeText(saved.ifsc || "")}" placeholder="Required for bank transfer"></label>
        <label class="field">Account number<input name="accountNumber" type="text" maxlength="40" inputmode="numeric" autocomplete="off" value="${safeText(saved.accountNumber || "")}" placeholder="Required for bank transfer"></label>
        <label class="field">PhonePe number<input name="phonePay" type="tel" maxlength="20" inputmode="tel" autocomplete="tel" value="${safeText(saved.phonePay || "")}" placeholder="Optional"></label>
        <label class="field">Google Pay number<input name="googlePay" type="tel" maxlength="20" inputmode="tel" autocomplete="tel" value="${safeText(saved.googlePay || "")}" placeholder="Optional"></label>
        <button class="button button-secondary withdrawal-details-save" type="button" data-action="save-withdrawal-details">Save withdrawal details</button>
      </form>
    </section>
  </section>`;
}

function renderRates() {
  const rateHeading = `<div class="page-heading rate-page-heading"><div><h1>Rate Chart</h1><p>Current payout rates per ₹10, as configured by the administrator.</p></div></div>`;
  if (!state.rates) return `${rateHeading}<div class="empty-state"><strong>No rate chart available</strong>Rate information will show here when it is published to the exported Rate Chart tree.</div>`;
  const rows = toRecords(state.rates).filter(row => row.id !== "x");
  if (!rows.length) return `${rateHeading}<pre class="panel" style="white-space:pre-wrap;overflow-wrap:anywhere;font-size:11px">${safeText(JSON.stringify(state.rates, null, 2))}</pre>`;
  const labels = ["Single Digit", "Double Digit", "Single Pana", "Double Pana", "Triple Pana", "Half Sangam", "Full Sangam"];
  return `${rateHeading}<div class="rate-chart-grid">${rows.map(row => {
    const label = row.name || row.game || labels[Number(row.id) - 1] || `Rate ${row.id}`;
    const rate = row.rate ?? row.value ?? "—";
    return `<article class="rate-chart-card"><strong>${safeText(label)}</strong><span>₹10 <i>=</i> ₹${safeText(rate)}</span></article>`;
  }).join("")}</div>`;
}

function withdrawalCacheKey() {
  return `dpboss60Withdrawal:${state.user?.phone || ""}`;
}

function withdrawalDetailsPath(phone = state.user?.phone) {
  if (!phone || !/^\d{10}$/.test(phone)) throw new Error("Sign in again before saving withdrawal details.");
  return `${DATABASE_ROOTS.users}/${phonePath(phone)}/AD`;
}

function normalizeWithdrawalDetails(value) {
  const decoded = decodeFirebaseValue(value);
  if (decoded === null || decoded === undefined) return null;
  if (!decoded || typeof decoded !== "object" || Array.isArray(decoded)) {
    throw new Error("Saved withdrawal details have an unexpected format. Re-save your account details.");
  }
  return Object.fromEntries(
    ["holderName", "ifsc", "accountNumber", "phonePay", "googlePay"]
      .map(name => [name, String(decoded[name] || "").trim()])
  );
}

function savedWithdrawalDetails() {
  try {
    const stored = localStorage.getItem(withdrawalCacheKey());
    if (stored) {
      const saved = JSON.parse(stored);
      return saved && typeof saved === "object" && !Array.isArray(saved) ? saved : {};
    }
    const legacy = sessionStorage.getItem(withdrawalCacheKey());
    if (!legacy) return {};
    const saved = JSON.parse(legacy);
    if (!saved || typeof saved !== "object" || Array.isArray(saved)) return {};
    localStorage.setItem(withdrawalCacheKey(), JSON.stringify(saved));
    return saved;
  } catch (error) {
    notify(`Could not restore saved withdrawal details: ${error.message || "Invalid cached data."}`, "error");
    return {};
  }
}

function hasWithdrawalDestination(details) {
  return Boolean((details.holderName && details.ifsc && details.accountNumber)
    || details.phonePay || details.googlePay);
}

function writeWithdrawalDetails(details) {
  try {
    localStorage.setItem(withdrawalCacheKey(), JSON.stringify(details));
    return true;
  } catch (error) {
    notify(`Withdrawal details could not be saved: ${error.message || "Browser storage is unavailable."}`, "error");
    return false;
  }
}

async function loadWithdrawalDetailsFromAccount(phone = state.user?.phone) {
  const path = withdrawalDetailsPath(phone);
  const cached = savedWithdrawalDetails();
  const remote = normalizeWithdrawalDetails(await dbGet(path));
  if (state.user?.phone !== phone) return;

  if (remote && hasWithdrawalDestination(remote)) {
    writeWithdrawalDetails({ ...remote, amount: String(cached.amount || "") });
    return;
  }
  const localDetails = normalizeWithdrawalDetails(cached);
  if (!localDetails || !hasWithdrawalDestination(localDetails)) return;
  await dbPutAndVerify(path, localDetails);
}

function cacheWithdrawalDetails(form) {
  const values = new FormData(form);
  const previous = savedWithdrawalDetails();
  const saved = Object.fromEntries(
    ["holderName", "ifsc", "accountNumber", "phonePay", "googlePay", "amount"]
      .map(name => [name, String(values.get(name) || previous[name] || "").trim()])
  );
  writeWithdrawalDetails(saved);
}

async function saveWithdrawalDetails(form) {
  const values = new FormData(form);
  const previous = savedWithdrawalDetails();
  const details = Object.fromEntries(
    ["holderName", "ifsc", "accountNumber", "phonePay", "googlePay"]
      .map(name => [name, String(values.get(name) || "").trim()])
  );
  const hasBankFields = Boolean(details.holderName || details.ifsc || details.accountNumber);
  const completeBankDetails = Boolean(details.holderName && details.ifsc && details.accountNumber);
  const hasUpiNumber = Boolean(details.phonePay || details.googlePay);
  if (hasBankFields && !completeBankDetails) {
    notify("For bank transfer, enter the account holder name, IFSC code, and account number.", "error");
    return false;
  }
  if (!completeBankDetails && !hasUpiNumber) {
    notify("Enter complete bank details or a PhonePe/Google Pay number before saving.", "error");
    return false;
  }
  await dbPutAndVerify(withdrawalDetailsPath(), details);
  if (!writeWithdrawalDetails({ ...details, amount: String(previous.amount || "") })) {
    throw new Error("Withdrawal details were saved to your account, but could not be cached on this device.");
  }
  return true;
}

function renderNotices() {
  if (!state.notices.length) return `${heading("Notices", "Important updates and information.")}<div class="empty-state"><strong>No notices right now</strong>New notices will appear here when published.</div>`;
  return `${heading("Notices", "Important updates and information.")}<section class="panel">${[...state.notices].reverse().map(item => `<article class="notice-card"><h3>${safeText(item.title || item.heading || "Notice")}</h3><p>${safeText(item.message || item.text || item.value || "")}</p><time>${safeText(dateText(item.createdAt || item.date || item.timestamp))}</time></article>`).join("")}</section>`;
}

function renderPolicy() {
  const paragraphs = state.policy.split(/\n{2,}/).map(item => item.trim()).filter(Boolean);
  return `<section class="policy-page"><header class="policy-page-heading"><p>ACCOUNT INFORMATION</p><h1>Privacy &amp; policy</h1><span>Privacy information published for Sridevi Matka.</span></header>${paragraphs.length
    ? `<section class="panel policy-content">${paragraphs.map(paragraph => `<p>${safeText(paragraph)}</p>`).join("")}</section>`
    : `<div class="empty-state"><strong>Policy is not available</strong>The administrator has not published privacy information yet.</div>`}</section>`;
}

function renderHowTo() {
  return `${heading("How to play", "A quick guide to the market and points flow.")}
    <div class="two-column">
      <section class="panel"><div class="panel-heading"><h2>Place a bid</h2></div>
        <div class="activity-list">
          ${[
            ["01", "Choose a market category", "Open Markets and choose Main, Starline or Super Jackpot."],
            ["02", "Select an open market", "Tap its play button. Closed markets cannot be selected."],
            ["03", "Choose a game type", "Select Single Digit, Double Digit or another available game type."],
            ["04", "Enter your selection and points", "Add a number and points, then submit your bid."]
          ].map(([number, title, description]) => `<div class="activity-row"><div class="activity-title"><span class="activity-mark">${number}</span><span><strong>${title}</strong><small>${description}</small></span></div></div>`).join("")}
        </div>
      </section>
      <section class="panel"><div class="panel-heading"><h2>Game types</h2></div>
        <div class="game-list">${GAME_TYPES.map(game => `<span class="game-chip">${safeText(legacyGameType(game))}</span>`).join("")}</div>
        <div class="warning-box">Confirm market timings and rules with the operator before submitting. This website does not calculate or guarantee results or winnings.</div>
      </section>
    </div>`;
}

