function showComingSoonDialog(name) {
  query(".app-message-backdrop")?.remove();
  document.body.insertAdjacentHTML("beforeend", `
    <div class="app-message-backdrop">
      <section class="app-message-dialog coming-soon-dialog" role="alertdialog" aria-modal="true"
        aria-labelledby="coming-soon-title" aria-describedby="coming-soon-copy">
        <span class="app-message-icon coming-soon-icon" aria-hidden="true">✦</span>
        <div class="app-message-content">
          <p class="app-message-kicker">Sridevi Matka · NEW GAME</p>
          <h2 id="coming-soon-title">${safeText(name)} is coming soon</h2>
          <p id="coming-soon-copy">We’re getting this experience ready for you. Please check back soon.</p>
          <button class="button button-primary" type="button" data-action="dismiss-app-message">Got it</button>
        </div>
      </section>
    </div>`);
  query(".coming-soon-dialog button")?.focus({ preventScroll: true });
}

