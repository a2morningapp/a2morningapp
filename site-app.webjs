  };
  return `<svg viewBox="0 0 24 24" focusable="false">${paths[name] || paths.home}</svg>`;
}

function openProfileLanguageDialog() {
  const previousLanguage = state.language;
  const options = SUPPORTED_LANGUAGES.map(([code, nativeName, englishName]) => `
    <button class="profile-language-option ${code === state.language ? "selected" : ""}" type="button"
      role="radio" aria-checked="${code === state.language}" data-action="profile-language-select" data-language="${safeText(code)}">
      <span>${safeText(nativeName)}</span><small>${safeText(englishName)}</small>
    </button>`).join("");
  document.body.insertAdjacentHTML("beforeend", `<div class="app-message-backdrop profile-language-backdrop" data-previous-language="${safeText(previousLanguage)}" role="presentation">
    <section class="profile-language-dialog" role="dialog" aria-modal="true" aria-labelledby="profile-language-title">
      <header><h2 id="profile-language-title">Change Language</h2><button type="button" data-action="profile-language-close" aria-label="Close">×</button></header>
      <div class="profile-language-options" role="radiogroup" aria-labelledby="profile-language-title">${options}</div>
      <footer><button type="button" data-action="profile-language-close">CANCEL</button><button type="button" data-action="profile-language-save">SAVE</button></footer>
    </section>
  </div>`);
}

function closeProfileLanguageDialog(restorePreviousLanguage) {
  const dialog = query(".profile-language-backdrop");
  if (!dialog) return;
  if (restorePreviousLanguage) {
    applyLanguage(dialog.dataset.previousLanguage || "en");
  }
  dialog.remove();
}

function renderTimeTable() {
  const markets = [...state.markets].sort((left, right) =>
    left.position - right.position || left.name.localeCompare(right.name));
  if (!markets.length) {
    const detail = state.marketLoadError || "Market timings will appear here when available.";
    return `<section class="time-table-page"><h1>Time Table</h1><div class="empty-state"><strong>No market timings available</strong>${safeText(detail)}</div></section>`;
  }
  return `<section class="time-table-page">
    <div class="time-table-scroll"><table>
      <thead><tr><th>Game Name</th><th>Open<br>Time</th><th>Close<br>Time</th></tr></thead>
      <tbody>${markets.map(market => `<tr><th scope="row">${safeText(market.name)}</th><td>${safeText(displayMarketTime(market.openTime))}</td><td>${safeText(displayMarketTime(market.closeTime))}</td></tr>`).join("")}</tbody>
    </table></div>
  </section>`;
}

function dbKey(value) {
  return String(value).replace(/[.#$\[\]/]/g, "_");
}

async function submitBid() {
  const form = query("#bid-form");
  if (!form) return;
  if (state.accountBlocked) {
    notify("This account is blocked from placing games. Contact support for help.", "error");
    return;
  }
  if (state.maintenance) {
    notify("Bidding is unavailable during maintenance.", "error");
    return;
  }
  let market = state.markets.find(item => item.name === state.selectedMarket);
  if (state.betDraft.some(item => !Number.isFinite(item.amount)
    || item.amount <= 0
    || (state.minimumEntry > 0 && item.amount < state.minimumEntry)
    || (state.maximumEntry > 0 && item.amount > state.maximumEntry))) {
    notify("One or more bid amounts are outside the current per-number limits.", "error");
    return;
  }
  const amountsByNumber = new Map();
  for (const item of state.betDraft) {
    const key = `${item.session || state.selectedSession}\u0000${item.selection}`;
    amountsByNumber.set(key, (amountsByNumber.get(key) || 0) + item.amount);
  }
  if (state.maximumEntry > 0 && [...amountsByNumber.values()].some(amount => amount > state.maximumEntry)) {
    notify("One or more accumulated number amounts exceed the current per-number maximum.", "error");
    return;
  }
  const sessions = [...new Set(state.betDraft.map(item => item.session || state.selectedSession))];
  for (const session of sessions) {
    if (state.selectedGame === "Full Sangam" && session !== "Open") {
      notify("Full Sangam is available only during the Open session.", "error");
      return;
    }
    if (!(session === "Open" ? state.openBets : state.closeBets)) {
      notify(`The ${session.toLowerCase()} session is currently unavailable.`, "error");
      return;
    }
  }
  const total = state.betDraft.reduce((sum, item) => sum + item.amount, 0);
  if (!state.betDraft.length || total <= 0) {
    notify("Add at least one valid number before submitting.", "error");
    return;
  }
  if (total > state.balance) {
    showAppDialog(`This amount is greater than your remaining wallet balance of ${money(state.balance)}.`);
    return;
  }
  if (state.bidSubmitting) return;
  state.bidSubmitting = true;
  const button = form.querySelector('button[type="submit"]');
  setBusy(button, true, "Submitting bid…");
  try {
    const bucket = state.marketBucket || marketBucketForToday(marketNow());
    const latestMarkets = normalizeMarkets(await dbGet(bucket));
    state.marketBucket = bucket;
    state.markets = latestMarkets;
    market = latestMarkets.find(item => item.name === state.selectedMarket);
    if (!market || sessions.some(session => !marketSessions(market).includes(session))) {
      state.betDraft = [];
      state.selectedGame = "";
      notify("This market session has closed. Your bid was not submitted.", "error");
      setPage("home", false);
      return;
    }
    const current = await dbGet(state.balancePath);
    const currentBalance = Number(decodeFirebaseValue(current) || 0);
    if (total > currentBalance) {
      showAppDialog(`This amount is greater than your remaining wallet balance of ${money(currentBalance)}.`);
      return;
    }
    const nextBalance = currentBalance - total;
    const now = marketNow();
    const createdAt = now.toISOString();
    const date = `${String(now.getDate()).padStart(2, "0")}-${String(now.getMonth() + 1).padStart(2, "0")}-${now.getFullYear()}`;
    const hour12 = now.getHours() % 12 || 12;
    const time = `${String(hour12).padStart(2, "0")}:${String(now.getMinutes()).padStart(2, "0")}:${String(now.getSeconds()).padStart(2, "0")}`;
    const meridiem = now.getHours() >= 12 ? "PM" : "AM";
    const time12 = `${time} ${meridiem}`;
    const updates = { [state.balancePath]: nextBalance };
    const createdBids = state.betDraft.map((draft, index) => {
      const session = draft.session || state.selectedSession;
      const randomReference = Math.floor(100 + Math.random() * 900);
      const tag = `${date}&${time}&${draft.selection}&${randomReference + index}&${market.name}`;
      const recordKey = dbKey(tag);
      const bidValue = JSON.stringify([legacyGameType(state.selectedGame), session, draft.selection, String(draft.amount), time12]);
      const historyValue = `${date} ${time}:${draft.amount.toFixed(1)}:"${draft.selection}"`;
      const historyKey = dbKey(`${Date.now()}_${index}_${Math.random().toString(36).slice(2, 8)}`);
      updates[`${DATABASE_ROOTS.bidRecords}/${phonePath(state.user.phone)}/${date}/${recordKey}`] = bidValue;
      updates[`${DATABASE_ROOTS.bidHistory}/${phonePath(state.user.phone)}/${date}/${historyKey}`] = historyValue;
      return {
        id: `${date}/${historyKey}`,
        date,
        tag: historyValue,
        payload: JSON.parse(bidValue),
        title: market.name,
        market: market.name,
        category: state.category,
        gameType: legacyGameType(state.selectedGame),
        session,
        selection: draft.selection,
        amount: draft.amount,
        status: "Submitted",
        createdAt
      };
    });
    await dbPatchAndVerify(updates);
    state.balance = nextBalance;
    state.bids.push(...createdBids);
    state.pointsHistory.push(...createdBids.map(entry => ({ ...entry, type: "Bid" })));
    state.betDraft = [];
    state.betGridPrimary = "";
    notify(`${createdBids.length} bid${createdBids.length === 1 ? "" : "s"} submitted successfully.`);
    state.selectedGame = "";
    setPage("game-select");
  } catch (error) {
    notify(error.message || "Unable to submit the bid.", "error");
  } finally {
    state.bidSubmitting = false;
    setBusy(button, false);
  }
}

function addBetDraft(primarySelection, secondarySelection) {
  const selectionField = query("#bet-selection");
  const secondarySelectionField = query("#bet-selection-secondary");
  const amountField = query("#bet-amount");
  const selection = String(primarySelection ?? selectionField?.value ?? "").trim();
  const secondary = String(secondarySelection ?? secondarySelectionField?.value ?? "").trim();
  const amount = Number(amountField?.value);
  const total = state.betDraft.reduce((sum, item) => sum + item.amount, 0);
  const market = state.markets.find(item => item.name === state.selectedMarket);
  if (!market || !marketSessions(market).includes(state.selectedSession)) {
    notify("The selected market session is no longer available.", "error");
    renderPage();
    return false;
  }
  if (state.selectedGame === "Full Sangam" && state.selectedSession !== "Open") {
    notify("Full Sangam is available only during the Open session.", "error");
    renderPage();
    return false;
  }
  if (!Number.isFinite(amount) || amount <= 0) {
    notify("Enter a number and valid points amount.", "error");
    return false;
  }
  let selections;
  try {
    selections = buildBetSelections(state.selectedGame, state.selectedSession, selection, secondary);
    selections = [...new Set(selections)];
  } catch (error) {
    notify(error.message || "Enter a valid number for the selected game type.", "error");
    selectionField?.focus();
    return false;
  }
  if (state.minimumEntry > 0 && amount < state.minimumEntry) {
    showAppDialog(`Minimum points per number: ${state.minimumEntry}${state.maximumEntry > 0 ? `\nMaximum points per number: ${state.maximumEntry}` : ""}`);
    return false;
  }
  if (state.maximumEntry > 0 && amount > state.maximumEntry) {
    showAppDialog(`Maximum points per number: ${state.maximumEntry}${state.minimumEntry > 0 ? `\nMinimum points per number: ${state.minimumEntry}` : ""}`);
    return false;
  }
  const requiredPoints = amount * selections.length;
  if (requiredPoints > state.balance - total) {
    showAppDialog(`This amount is greater than your remaining wallet balance of ${money(state.balance - total)}.`);
    return false;
  }
  const previousAmounts = new Map(selections.map(number => [
    number,
    state.betDraft
      .filter(item => item.selection === number && (item.session || state.selectedSession) === state.selectedSession)
      .reduce((sum, item) => sum + item.amount, 0)
  ]));
  try {
    state.betDraft = mergeBetDraft(state.betDraft, selections, amount, state.selectedSession, state.maximumEntry);
  } catch (error) {
    showAppDialog(error.message || "The per-number maximum would be exceeded.");
    return false;
  }
  state.betGridPrimary = "";
  const accumulated = [...previousAmounts].filter(([, previous]) => previous > 0);
  if (accumulated.length === 1) {
    const [number, previous] = accumulated[0];
    notify(`Added ${money(amount)} to ${number}. Its per-number total is now ${money(previous + amount)}.`);
  } else if (accumulated.length > 1) {
    notify(`${money(amount)} added to each of ${accumulated.length} existing numbers. Their updated amounts are shown in the bid list.`);
  } else if (selections.length > 1) {
    notify(`${selections.length} numbers added. Total stake: ${money(requiredPoints)}.`);
  }
  renderPage();
  return true;
}

async function submitRequest(event, type) {
  event.preventDefault();
  const form = event.target;
  const values = new FormData(form);
  const amount = Number(values.get("amount"));
  const isDeposit = type === "deposit";
  if (!isDeposit && !withdrawalWindowAt().open) {
    state.withdrawalDialogVisible = true;
    await renderPage();
    return;
  }
  const destination = isDeposit
    ? String(values.get("method") || (state.paymentDirectEnabled ? "UPI Direct" : "UPI QR")).trim()
    : String(values.get("method") || "").trim();
  const transactionId = String(values.get("reference") || "").trim();
  const upiAppStatus = isDeposit && destination === "UPI Direct"
    ? String(values.get("upiAppStatus") || "").trim()
    : "";
  const holderName = String(values.get("holderName") || "").trim();
  const ifsc = String(values.get("ifsc") || "").trim();
  const accountNumber = String(values.get("accountNumber") || "").trim();
  const phonePay = String(values.get("phonePay") || "").trim();
  const googlePay = String(values.get("googlePay") || "").trim();
  if (!Number.isFinite(amount) || amount <= 0) {
    notify("Complete the required fields with a valid amount.", "error");
    return;
  }
  if (isDeposit && state.paymentDirectEnabled && amount < Math.max(1, state.paymentMinimumDeposit)) {
    notify(`The minimum direct UPI payment is ${money(Math.max(1, state.paymentMinimumDeposit))}.`, "error");
    return;
  }
  if (isDeposit && !transactionId) {
    notify("Enter the UPI transaction ID before submitting your deposit request.", "error");
    form.querySelector("[name=reference]")?.focus();
    return;
  }
  if (!isDeposit) cacheWithdrawalDetails(form);
  const button = form.querySelector("button[type=submit]");
  setBusy(button, true, "Sending request…");
  try {
    const now = new Date();
    const timestamp = now.toISOString().replace("T", " ").split(".")[0];
    const key = `${timestamp} ${state.user.phone}`;
    const currentBalance = Number(decodeFirebaseValue(await dbGet(state.balancePath)) || 0);
    const updates = {};
    let requestValue;
    if (isDeposit) {
      const depositFields = [
        state.user.phone,
        destination,
        transactionId,
        amount,
        currentBalance,
        ""
      ];
      if (upiAppStatus) depositFields.splice(5, 0, upiAppStatus);
      requestValue = JSON.stringify(depositFields);
      updates[`${DATABASE_ROOTS.deposits}/${key}`] = requestValue;
    } else {
      if (amount > currentBalance) {
        state.balance = currentBalance;
        state.insufficientWithdrawalAmount = amount;
        await renderPage();
        return;
      }
      const minimum = Number(decodeFirebaseValue(await dbGet(`${DATABASE_ROOTS.settings}/MW`)) || 0);
      state.minimumWithdrawal = Number.isFinite(minimum) ? Math.max(0, minimum) : 0;
      state.balance = currentBalance;
      if (state.minimumWithdrawal && amount < state.minimumWithdrawal) {
        throw new Error(`Minimum withdrawal amount is ₹${state.minimumWithdrawal}.`);
      }
      if (!holderName && !phonePay && !googlePay) {
        setPage("bank-details");
        notify("Save your withdrawal account details before continuing.");
        return;
      }
      if (holderName && (!ifsc || !accountNumber)) {
        setPage("bank-details");
        notify("Enter the IFSC code and account number for bank withdrawals.", "error");
        return;
      }
      if (!withdrawalWindowAt().open) {
        state.withdrawalDialogVisible = true;
        await renderPage();
        return;
      }
      const nextBalance = currentBalance - amount;
      requestValue = JSON.stringify([
        state.user.phone,
        holderName,
        accountNumber,
        holderName,
        ifsc,
        phonePay,
        googlePay,
        amount,
        nextBalance,
        ""
      ]);
      updates[`${DATABASE_ROOTS.withdrawals}/${key}`] = requestValue;
      updates[state.balancePath] = nextBalance;
    }
    await dbPatchAndVerify(updates);
    const entry = {
      id: key,
      title: isDeposit ? "Deposit request" : "Withdrawal request",
      type: isDeposit ? "Deposit" : "Withdraw",
      amount,
      method: destination,
      destination: isDeposit ? transactionId : phonePay || googlePay || accountNumber,
      reference: isDeposit ? transactionId : "",
      status: "Pending",
      createdAt: now.toISOString()
    };
    if (isDeposit) state.depositHistory.push(entry);
    else {
      state.balance = currentBalance - amount;
      state.withdrawalHistory.push(entry);
    }
    state.pointsHistory.push(entry);
    if (isDeposit && destination === "UPI Direct") {
      state.directPaymentAmount = "";
      state.directPaymentLaunched = false;
      state.directPaymentReturned = false;
      state.directPaymentStatus = "";
      state.directPaymentReference = "";
      state.directPaymentFailureRecorded = false;
    }
    notify(isDeposit
      ? "Payment request sent. Points are added after admin approval."
      : "Withdrawal request sent.");
    await renderPage();
  } catch (error) {
    notify(error.message || "Unable to send your request.", "error");
  } finally {
    setBusy(button, false);
  }
}

function createRandomUpiTxnId() {
  const random = new Uint32Array(4);
  if (window.crypto?.getRandomValues) window.crypto.getRandomValues(random);
  else random.forEach((_, index) => { random[index] = Math.floor(Math.random() * 0x100000000); });
  return `MH${Date.now()}${Array.from(random, value => value.toString(36)).join("").slice(0, 10)}`.toUpperCase();
}

function directPaymentUri(amount) {
  const txnId = createRandomUpiTxnId();
  if (state.paymentUpiTemplate) {
    let paymentUrl;
    try {
      paymentUrl = new URL(state.paymentUpiTemplate.replace(/###/g, encodeURIComponent(amount)));
    } catch {
      throw new Error("The Admin Upi payment link is invalid. Update it in Firebase Admin settings.");
    }
    if (paymentUrl.protocol !== "upi:" || paymentUrl.hostname !== "pay"
        || !paymentUrl.searchParams.get("pa")) {
      throw new Error("The Admin Upi payment link must be a valid upi://pay link with a payee ID.");
    }
    paymentUrl.hash = "";
    paymentUrl.searchParams.set("am", amount);
    paymentUrl.searchParams.set("cu", "INR");
    paymentUrl.searchParams.set("tr", txnId);
    if (!paymentUrl.searchParams.get("tn")) paymentUrl.searchParams.set("tn", "Deposit");
    state.directPaymentReference = txnId;
    return paymentUrl.href;
  }
  const upiId = state.paymentUpiId.trim();
  if (!/^[A-Za-z0-9._-]{2,256}@[A-Za-z0-9.-]{2,64}$/.test(upiId)) {
    throw new Error("A valid UPI ID must be configured at Admin/Admin/upi_id before direct payments can be used.");
  }
  const parameters = new URLSearchParams({
    pa: upiId,
    pn: "Sridevi Matka",
    mc: "4411",
    am: amount,
    cu: "INR",
    tr: txnId,
    tn: "Deposit",
    mode: "02",
    purpose: "00"
  });
  state.directPaymentReference = txnId;
  return `upi://pay?${parameters.toString()}`;
}

async function startDirectPayment(event) {
  event.preventDefault();
  if (!state.user || !/^\d{10}$/.test(state.user.phone)) {
    notify("Sign in before starting a payment.", "error");
    return;
  }
  const amountText = String(new FormData(event.target).get("amount") || "").trim();
  const amount = Number(amountText);
  const minimum = Math.max(1, state.paymentMinimumDeposit);
  if (!/^\d+(?:\.\d{1,2})?$/.test(amountText) || !Number.isFinite(amount) ||
      amount < minimum || amount > 1000000) {
    notify(`Enter an amount from ${money(minimum)} to ₹10,00,000 with at most two decimals.`, "error");
    return;
  }
  let upiUrl;
  try {
    upiUrl = directPaymentUri(amountText);
  } catch (error) {
    notify(error.message || "The configured UPI payment details are invalid.", "error");
    return;
  }
  const button = event.target.querySelector("button[type=submit]");
  state.directPaymentAmount = amountText;
  state.directPaymentLaunched = false;
  state.directPaymentReturned = false;
  state.directPaymentStatus = "";
  state.directPaymentReference = "";
  state.directPaymentFailureRecorded = false;
  setBusy(button, true, "Opening UPI app…");
  try {
    if (window.ReactNativeWebView) {
      state.directPaymentLaunched = true;
      void renderPage();
      paymentHostMessage({ type: "open-upi-payment", upiUrl });
    } else {
      const opened = window.open(upiUrl, "_blank");
      if (!opened) throw new Error("The UPI app could not be opened. Allow pop-ups or open this page in the Sridevi Matka app.");
      window.__madhur555UpiPaymentLaunchResult(true);
    }
  } catch (error) {
    state.directPaymentAmount = "";
    state.directPaymentLaunched = false;
    notify(error.message || "Could not open a UPI payment app.", "error");
  } finally {
    setBusy(button, false);
  }
}

async function startPayment(event) {
  event.preventDefault();
  if (!state.user || !/^\d{10}$/.test(state.user.phone)) {
    notify("Sign in before starting a payment.", "error");
    return;
  }
  let pending;
  try {
    pending = readPendingPayment(state.user.phone);
  } catch (error) {
    notify(error.message || "Could not read the pending payment.", "error");
    return;
  }
  if (pending && paymentRetrySeconds(pending) > 0) {
    notify(`You can start another payment in ${paymentRetrySeconds(pending)} seconds.`, "error");
    return;
  }
  const phone = state.user.phone;
  const amountText = String(new FormData(event.target).get("amount") || "").trim();
  const amount = Number(amountText);
  if (!/^\d+(?:\.\d{1,2})?$/.test(amountText) || !Number.isFinite(amount) ||
      amount < 1 || amount > 1000000) {
    notify("Enter an amount from ₹1 to ₹10,00,000 with at most two decimals.", "error");
    return;
  }
  const button = event.target.querySelector("button[type=submit]");
  setBusy(button, true, "Creating secure payment…");
  try {
    const result = await paymentApiRequest({ action: "create", phone, amount: amountText });
    let checkout;
    try {
      checkout = new URL(result.checkoutUrl);
    } catch {
      throw new Error("The payment service returned an invalid checkout link.");
    }
    if (checkout.protocol !== "https:" || !result.orderId || !result.pollToken) {
      throw new Error("The payment service returned incomplete or insecure order details.");
    }
    const order = {
      phone,
      orderId: String(result.orderId),
      pollToken: String(result.pollToken),
      checkoutUrl: checkout.href,
      amount,
      createdAt: new Date().toISOString()
    };
    savePendingPayment(order);
    startPaymentStatusPolling(order, true);
    notify("Secure payment opened in the app. Your points will be added after confirmation.");
  } catch (error) {
    notify(error.message || "Could not start the payment.", "error");
  } finally {
    setBusy(button, false);
  }
}

function retryPendingPayment(order) {
  const seconds = paymentRetrySeconds(order);
  if (seconds > 0) {
    notify(`You can retry the secure payment in ${seconds} seconds.`, "error");
    return;
  }
  const form = query("#deposit-form");
  const amount = query('#deposit-form input[name="amount"]');
  if (!form || !amount) {
    notify("Open Deposit points to start a new payment.", "error");
    return;
  }
  amount.value = String(order.amount);
  if (typeof form.requestSubmit === "function") form.requestSubmit();
  else form.dispatchEvent(new Event("submit", { bubbles: true, cancelable: true }));
}

async function saveProfile(event) {
  event.preventDefault();
  const form = event.target;
  const name = String(new FormData(form).get("name") || "").trim();
  if (name.length < 2) {
    setInlineMessage("profile-message", "Enter a name with at least 2 characters.");
    return;
  }
  try {
    const phone = phonePath(state.user.phone);
    await dbPutAndVerify(`${DATABASE_ROOTS.users}/${phone}/name`, JSON.stringify(name));
    state.user.name = name;
    localStorage.setItem("madhur555User", JSON.stringify(state.user));
    query("#header-name").textContent = name;
    query("#header-avatar").textContent = name.charAt(0).toUpperCase();
    setInlineMessage("profile-message", "Your details were updated.", true);
    await renderPage();
    notify("Profile updated.");
  } catch (error) {
    setInlineMessage("profile-message", error.message || "Unable to save profile details.");
  }
}

async function refreshAll() {
  const refreshes = [refreshUserData(), loadGlobalData()];
  if (state.page === "points" || state.page === "deposit" || state.page === "withdraw") {
    refreshes.push(loadWalletRequests(state.page));
  }
  const outcomes = await Promise.allSettled(refreshes);
  await renderPage();
  const failures = outcomes.filter(outcome => outcome.status === "rejected");
  if (failures.length) {
    failures.forEach(outcome => notify(outcome.reason?.message || "Could not refresh data.", "error"));
  } else {
    notify("Data refreshed.");
  }
}

function handleClick(event) {
  const target = event.target.closest("[data-page], [data-auth-mode], [data-language-select], [data-select-game], [data-select-digit], [data-bet-grid-select], [data-category], [data-action], [data-amount], [data-open-market], [data-market-result], [data-drawer-toggle], [data-session], [data-remove-bet], [data-expert-period], [data-unlock-guess], #language-continue, .support-sheet-backdrop, .auth-policy-backdrop, .app-message-backdrop, .mama-dialog-backdrop");
  if (!target) return;
  if (target.dataset.betGridSelect !== undefined) {
    const value = target.dataset.betGridSelect;
    const halfSangam = ["Half Sangam", "Half Sangam A", "Half Sangam B"].includes(state.selectedGame);
    const sangam = halfSangam || state.selectedGame === "Full Sangam";
    if (sangam && !state.betGridPrimary) {
      state.betGridPrimary = value;
      renderPage();
    } else if (sangam) {
      addBetDraft(state.betGridPrimary, value);
    } else {
      addBetDraft(value);
    }
    return;
  }
  if (target.dataset.selectDigit !== undefined) {
    const selectionField = query("#bet-selection");
    if (!selectionField) return;
    selectionField.value = target.dataset.selectDigit;
    selectionField.dispatchEvent(new Event("input", { bubbles: true }));
    target.parentElement.querySelectorAll("[data-select-digit]").forEach(button => {
      button.setAttribute("aria-selected", String(button === target));
    });
    return;
  }
  if (target.classList.contains("auth-policy-backdrop")) {
    if (event.target === target) target.remove();
    return;
  }
  if (target.classList.contains("profile-language-backdrop")) {
    if (event.target === target) closeProfileLanguageDialog(true);
    return;
  }
  if (target.classList.contains("app-message-backdrop")) {
    if (event.target === target) target.remove();
    return;
  }
  if (target.classList.contains("support-sheet-backdrop") && event.target !== target) return;
  if (target.classList.contains("support-sheet-backdrop") && event.target === target) {
    state.supportDialogVisible = false;
    renderPage();
    return;
  }
  if (target.classList.contains("mama-dialog-backdrop") && event.target === target) {
    if (target.classList.contains("dpb-bidding-closed-backdrop")) {
      state.closedMarket = null;
    } else if (target.classList.contains("withdrawal-dialog-backdrop")) {
      if (target.querySelector(".withdrawal-closed-dialog")) state.withdrawalDialogVisible = false;
      else state.insufficientWithdrawalAmount = null;
    }
    renderPage();
    return;
  }
  if (target.hasAttribute("data-drawer-toggle")) {
    if (state.page === "home") {
      setPage("profile");
    } else {
      handleAppBack();
    }
    return;
  }
  if (target.dataset.authMode) {
    showAuth(target.dataset.authMode);
    return;
  }
  if (target.dataset.languageSelect) {
    applyLanguage(target.dataset.languageSelect);
    return;
  }
  if (target.id === "language-continue") {
    void completeLanguageSetup().catch(error => notify(error.message || "Unable to continue.", "error"));
    return;
  }
  if (target.dataset.action === "open-auth-policy") {
    openAuthPolicy();
    return;
  }
  if (target.dataset.action === "forgot-password") {
    const phone = query("#auth-phone").value.replace(/\D/g, "");
    if (!/^\d{10}$/.test(phone)) {
      notify("Enter your 10-digit phone number first.", "error");
      query("#auth-phone").focus();
      return;
    }
    try {
      openWhatsApp(`I need help resetting the password for +91 ${phone}.`);
    } catch (error) {
      notify(error.message || "Unable to open password recovery support.", "error");
    }
    return;
  }
  if (target.dataset.action === "close-auth-policy") {
    query(".auth-policy-backdrop")?.remove();
    return;
  }
  if (target.dataset.action === "close-support") {
    state.supportDialogVisible = false;
    renderPage();
    return;
  }
  if (target.dataset.action === "dismiss-app-message") {
    query(".app-message-backdrop")?.remove();
    return;
  }
  if (target.dataset.action === "cancel-bet-submit") {
    query(".aia-bet-confirm-backdrop")?.remove();
    return;
  }
  if (target.dataset.action === "clear-bet-draft") {
    state.betDraft = [];
    state.betGridPrimary = "";
    renderPage();
    return;
  }
  if (target.dataset.action === "reset-grid-pick") {
    state.betGridPrimary = "";
    renderPage();
    return;
  }
  if (target.dataset.action === "confirm-bet-submit") {
    query(".aia-bet-confirm-backdrop")?.remove();
    void submitBid();
    return;
  }
  if (target.dataset.action === "profile-back") {
    handleAppBack();
    return;
  }
  if (target.dataset.action === "profile-chart-main"
    || target.dataset.action === "profile-chart-starline"
    || target.dataset.action === "profile-chart-jackpot") {
    state.category = target.dataset.action === "profile-chart-starline"
      ? "Starline"
      : target.dataset.action === "profile-chart-jackpot" ? "Gali / Disawar" : "Main";
    setPage("chart-markets");
    return;
  }
  if (target.dataset.action === "profile-bank-details" || target.dataset.action === "edit-bank-details") {
    setPage("bank-details");
    return;
  }
  if (target.dataset.action === "profile-time-table") {
    setPage("time-table");
    return;
  }
  if (target.dataset.action === "profile-change-password") {
    document.body.insertAdjacentHTML("beforeend", `<div class="app-message-backdrop" role="presentation"><section class="app-message-dialog profile-info-dialog" role="dialog" aria-modal="true" aria-labelledby="profile-password-title"><span class="app-message-icon" aria-hidden="true">⌑</span><div class="app-message-content"><p class="app-message-kicker">ACCOUNT SECURITY</p><h2 id="profile-password-title">Change password</h2><form id="profile-password-form" class="form-stack"><label class="field">Current password<input name="currentPassword" type="password" autocomplete="current-password" required></label><label class="field">New password<input name="newPassword" type="password" minlength="8" autocomplete="new-password" required></label><label class="field">Confirm new password<input name="confirmPassword" type="password" minlength="8" autocomplete="new-password" required></label><p class="auth-note" id="profile-password-message" aria-live="polite"></p><button class="button button-primary" type="submit">Update password</button></form><button class="button button-secondary" type="button" data-action="dismiss-app-message">Cancel</button></div></section></div>`);
    return;
  }
  if (target.dataset.action === "profile-change-language") {
    openProfileLanguageDialog();
    return;
  }
  if (target.dataset.action === "profile-share-app") {
    const shareData = { title: "Sridevi Matka", text: "Open Sridevi Matka", url: window.location.href };
    if (navigator.share) {
      navigator.share(shareData).catch(error => {
        if (error?.name !== "AbortError") notify(error.message || "Unable to share the app.", "error");
      });
    } else {
      void copyTextToClipboard(window.location.href)
        .then(() => notify("App link copied."))
        .catch(error => notify(error.message || "Unable to copy the app link.", "error"));
    }
    return;
  }
  if (target.dataset.action === "profile-logout") {
    logout();
    return;
  }
  if (target.dataset.action === "profile-language-select") {
    applyLanguage(target.dataset.language);
    queryAll(".profile-language-option").forEach(option => {
      const selected = option.dataset.language === state.language;
      option.classList.toggle("selected", selected);
      option.setAttribute("aria-checked", String(selected));
    });
    return;
  }
  if (target.dataset.action === "profile-language-save") {
    localStorage.setItem("madhur555Language", state.language);
    closeProfileLanguageDialog(false);
    notify("Language preference saved.");
    return;
  }
  if (target.dataset.action === "profile-language-close") {
    closeProfileLanguageDialog(true);
    return;
  }
  if (target.dataset.action === "profile-add-bank") {
    setPage("bank-details");
    return;
  }
  if (target.dataset.action === "save-withdrawal-details") {
    const form = query("#bank-details-form");
    if (!form) {
      notify("Open Bank Details to save your account information.", "error");
      return;
    }
    setBusy(target, true, "Saving...");
    void saveWithdrawalDetails(form)
      .then(saved => {
        if (!saved) return;
        notify("Withdrawal details saved to your account and this device.");
        void renderPage();
      })
      .catch(error => notify(error.message || "Could not save withdrawal details.", "error"))
      .finally(() => {
        if (target.isConnected) setBusy(target, false);
      });
    return;
  }
  if (target.dataset.action === "open-feature-markets") {
    state.category = target.dataset.featureCategory;
    state.featureMarketPage = true;
    setPage("markets");
    return;
  }
  if (target.dataset.action === "open-matka") {
    const matka = target.dataset.matka === "30"
      ? { name: "Matka 30", url: state.matka30Url }
      : { name: "Matka 60", url: state.matka60Url };
    if (!matka.url) {
      showComingSoonDialog(matka.name);
      return;
    }
    try {
      openMatkaViewer(matka.name, matka.url);
    } catch (error) {
      notify(error.message || `Unable to open ${matka.name}.`, "error");
    }
    return;
  }
  if (target.dataset.action === "webviewer-back") {
    handleAppBack();
    return;
  }
  if (target.dataset.action === "toggle-game-session") {
    const market = state.markets.find(item => item.name === state.selectedMarket);
    const nextSession = marketSessions(market || {}).find(session => session !== state.selectedSession);
    if (!nextSession) {
      notify("No other session is currently open for this market.");
      return;
    }
    state.selectedSession = nextSession;
    renderPage();
    return;
  }
  if (target.dataset.action === "open-expert-guessing") {
    state.expertGuessingPeriod = "day";
    const loading = loadExpertGuessing(true);
    setPage("expert-guessing");
    void loading.then(renderPage).catch(error => {
      notify(error.message || "Could not load expert numbers.", "error");
      renderPage();
    });
    return;
  }
  if (target.dataset.action === "refresh-expert-guessing") {
    const loading = loadExpertGuessing(true);
    renderPage();
    void loading.then(renderPage).catch(error => {
      notify(error.message || "Could not load expert numbers.", "error");
      renderPage();
    });
    return;
  }
  if (target.dataset.action === "expert-back") {
    handleAppBack();
    return;
  }
  if (target.dataset.action === "dismiss-market-closed") {
    state.closedMarket = null;
    renderPage();
    return;
  }
  if (target.dataset.action === "dismiss-withdrawal-dialog") {
    state.withdrawalDialogVisible = false;
    renderPage();
    return;
  }
  if (target.dataset.action === "withdraw-back") {
    handleAppBack();
    return;
  }
  if (target.dataset.action === "dismiss-insufficient-balance") {
    state.insufficientWithdrawalAmount = null;
    renderPage();
    return;
  }
  if (target.dataset.action === "add-withdrawal-details") {
    state.insufficientWithdrawalAmount = null;
    setPage("bank-details");
    return;
  }
  if (target.dataset.expertPeriod) {
    state.expertGuessingPeriod = target.dataset.expertPeriod;
    renderPage();
    return;
  }
  if (target.dataset.unlockGuess) {
    const market = state.markets.find(item => item.id === target.dataset.unlockGuess);
    if (!market) {
      notify("This market is no longer available. Refresh and try again.", "error");
      return;
    }
    const guess = expertGuessFor(market);
    if (!guess || !Object.values(guess).some(values => values.length)) {
      notify("Expert numbers have not been published for this market yet.", "error");
      return;
    }
    state.selectedGuessMarket = market.id;
    state.revealedGuess = getRevealedGuess(market);
    setPage("guess-scratch");
    return;
  }
  if (target.dataset.action === "scratch-guess") {
    const market = state.markets.find(item => item.id === state.selectedGuessMarket);
    const guess = market ? expertGuessFor(market) : null;
    if (!market || !guess || !Object.values(guess).some(values => values.length)) {
      notify("Expert numbers are no longer available for this market.", "error");
      return;
    }
    try {
      localStorage.setItem(guessRevealKey(market), JSON.stringify({ revealedAt: Date.now(), guess }));
      state.revealedGuess = guess;
      renderPage();
    } catch (error) {
      notify(`Could not save the revealed numbers: ${error.message || "Storage is unavailable."}`, "error");
    }
    return;
  }
  if (target.dataset.page) {
    if (target.dataset.page === "support") {
      state.supportDialogVisible = true;
      query("#sidebar").classList.remove("open");
      query("#drawer-scrim").classList.remove("visible");
      void renderPage();
      return;
    }
    setPage(target.dataset.page);
    if (target.dataset.action === "refresh") void refreshAll();
    return;
  }
  if (target.dataset.action === "exit-dialog-close" || target.dataset.action === "exit-dialog-cancel") {
    closeExitDialog();
    return;
  }
  if (target.dataset.action === "exit-dialog-confirm") {
    closeExitDialog();
    if (window.ReactNativeWebView) {
      window.ReactNativeWebView.postMessage(JSON.stringify({ type: "exit-app" }));
    } else {
      notify("You can close this browser tab to exit the preview.");
    }
    return;
  }
  if (target.dataset.selectGame) {
    const market = state.markets.find(item => item.name === state.selectedMarket);
    if (!market || !marketSessions(market).includes(state.selectedSession)) {
      notify("This market session is no longer open for bidding.", "error");
      setPage("markets");
      return;
    }
    if (target.dataset.selectGame === "Full Sangam" && state.selectedSession !== "Open") {
      notify("Full Sangam is available only during the Open session.", "error");
      return;
    }
    state.selectedGame = target.dataset.selectGame;
    state.betDraft = [];
    state.betGridPrimary = "";
    state.betEntryAmount = defaultBetAmount();
    setPage("betting");
    return;
  }
  if (target.dataset.action === "bet-back") {
    handleAppBack();
    return;
  }
  if (target.dataset.action === "game-select-back") {
    handleAppBack();
    return;
  }
  if (target.dataset.session) {
    state.selectedSession = target.dataset.session;
    state.betGridPrimary = "";
    renderPage();
    return;
  }
  if (target.dataset.removeBet !== undefined) {
    state.betDraft.splice(Number(target.dataset.removeBet), 1);
    renderPage();
    return;
  }
  if (target.dataset.category) {
    state.category = target.dataset.category;
    renderPage();
    return;
  }
  if (target.dataset.amount) {
    const amountField = query('input[name="amount"]', target.closest("section"));
    if (amountField) amountField.value = target.dataset.amount;
    return;
  }
  if (target.dataset.action === "refresh") {
    refreshAll();
    return;
  }
  if (target.dataset.action === "refresh-webviewer") {
    const frame = query(".result-webviewer");
    if (frame) frame.src = state.webViewerUrl;
    return;
  }
  if (target.dataset.action === "open-webviewer-external") {
    try {
      openExternalUrl(state.webViewerUrl, state.webViewerTitle || "website");
    } catch (error) {
      notify(error.message || "Unable to open the website.", "error");
    }
    return;
  }
  if (target.dataset.action === "refresh-panel-chart") {
    if (state.selectedPanelMarket) void loadPanelChartResults(state.selectedPanelMarket);
    return;
  }
  if (target.dataset.action === "copy-upi") {
    void copyTextToClipboard(state.paymentUpiId)
      .then(() => notify("UPI ID copied."))
      .catch(error => notify(error.message || "Could not copy the UPI ID.", "error"));
    return;
  }
  if (target.dataset.action === "direct-payment-returned") {
    if (!state.directPaymentLaunched || !state.directPaymentAmount) {
      notify("Start a direct payment before continuing.", "error");
      return;
    }
    state.directPaymentReturned = true;
    void renderPage();
    notify("Enter your UPI transaction ID to submit the payment for admin verification.");
    return;
  }
  if (target.dataset.action === "direct-payment-restart") {
    state.directPaymentAmount = "";
    state.directPaymentLaunched = false;
    state.directPaymentReturned = false;
    state.directPaymentStatus = "";
    state.directPaymentReference = "";
    state.directPaymentFailureRecorded = false;
    void renderPage();
    return;
  }
  if (target.dataset.action === "check-pending-payment") {
    try {
      const order = readPendingPayment(state.user?.phone || "");
      if (!order) {
        notify("There is no pending payment to check.", "error");
        return;
      }
      startPaymentStatusPolling(order, false);
      notify("Checking payment status with the gateway.");
    } catch (error) {
      notify(error.message || "Could not check payment status.", "error");
    }
    return;
  }
  if (target.dataset.action === "reopen-pending-payment") {
    try {
      const order = readPendingPayment(state.user?.phone || "");
      if (!order?.checkoutUrl) {
        notify("There is no saved secure payment page to reopen.", "error");
        return;
      }
      startPaymentStatusPolling(order, true);
    } catch (error) {
      notify(error.message || "Could not reopen the secure payment.", "error");
    }
    return;
  }
  if (target.dataset.action === "close-payment-viewer") {
    const viewer = query("#payment-viewer");
    const orderId = viewer?.dataset.orderId;
    hidePaymentViewer(orderId);
    if (orderId) notify("Payment window closed. Payment status will continue to be checked.");
    return;
  }
  if (target.dataset.action === "deposit-whatsapp") {
    try {
      openWhatsApp(`Hello, I submitted a payment request for ${query('#deposit-form input[name="amount"]')?.value || "points"} points. My phone number is ${state.user?.phone || ""}. The points have not been added yet. I will attach my payment screenshot here.`);
    } catch (error) {
      notify(error.message || "Unable to open WhatsApp.", "error");
    }
    return;
  }
  if (target.dataset.action === "auth-whatsapp" || target.dataset.action === "open-whatsapp") {
    try {
      state.supportDialogVisible = false;
      void renderPage();
      openWhatsApp(target.dataset.supportMessage || "Hello, I need help with my Sridevi Matka account.");
    } catch (error) {
      notify(error.message || "Unable to open WhatsApp.", "error");
    }
    return;
  }
  if (target.dataset.action === "open-contact") {
    query("#sidebar").classList.remove("open");
    query("#drawer-scrim").classList.remove("visible");
    if (target.classList.contains("auth-help-link")) {
      try {
        openWhatsApp("Hello Sir, Can you help me.");
      } catch (error) {
        notify(error.message || "Unable to open WhatsApp.", "error");
      }
      return;
    }
    setPage("support");
    return;
  }
  if (target.dataset.action === "support-back") {
    handleAppBack();
    return;
  }
  if (target.dataset.action === "open-telegram") {
    try {
      state.supportDialogVisible = false;
      void renderPage();
      openExternalUrl(state.telegramUrl, "Telegram");
    } catch (error) {
      notify(error.message || "Unable to open Telegram.", "error");
    }
    return;
  }
  if (target.dataset.action === "open-whatsapp-group") {
    try {
      openExternalUrl(state.whatsappGroupUrl, "WhatsApp group");
    } catch (error) {
      notify(error.message || "Unable to open WhatsApp group.", "error");
    }
    return;
  }
  if (target.dataset.action === "open-results-website" || target.dataset.action === "open-website") {
    query("#sidebar").classList.remove("open");
    query("#drawer-scrim").classList.remove("visible");
    try {
      openResultsWebsite();
    } catch (error) {
      notify(error.message || "Unable to open the configured website.", "error");
    }
    return;
  }
  if (target.dataset.marketResult) {
    const market = state.markets.find(item => item.id === target.dataset.marketResult);
    if (!market) {
      notify("Market information is no longer available. Refresh and try again.", "error");
      return;
    }
    try {
      openMarketResult(market.name);
    } catch (error) {
      notify(error.message || "Unable to open this market result.", "error");
    }
    return;
  }
  if (target.dataset.action === "retry-pending-payment") {
    try {
      const order = readPendingPayment(state.user?.phone || "");
      if (!order) {
        notify("There is no pending payment to retry.", "error");
        return;
      }
      retryPendingPayment(order);
    } catch (error) {
      notify(error.message || "Could not reopen the pending payment.", "error");
    }
    return;
  }
  if (target.dataset.openMarket) {
    const market = state.markets.find(item => item.id === target.dataset.openMarket);
    if (market) state.category = /starline/i.test(market.category) ? "Starline" : /gali|disawar/i.test(market.category) ? "Gali / Disawar" : "Main";
    if (market) {
      const sessions = marketSessions(market);
      if (!sessions.length) {
        state.closedMarket = market;
        renderPage();
        return;
      }
      state.closedMarket = null;
      state.selectedMarket = market.name;
      state.betGridPrimary = "";
      if (!sessions.includes(state.selectedSession)) state.selectedSession = sessions[0];
      state.selectedGame = "";
      state.betDraft = [];
      setPage("game-select");
    }
    return;
  }
  if (target.dataset.action === "add-bet") addBetDraft();
}

document.addEventListener("input", event => {
  const input = event.target;
  if (!(input instanceof HTMLInputElement)) return;
  if (input.id === "bet-amount") {
    state.betEntryAmount = input.value;
    return;
  }
  if (!["selection", "selectionSecondary"].includes(input.name)) return;
  const maximumLength = Number(input.maxLength);
  if (input.name === "selection" && isBulkInputGame(state.selectedGame)) {
    input.value = input.value.replace(/[^\d,\s]/g, "").slice(0, maximumLength);
  } else if (input.name === "selection" && state.selectedGame === "Odd Even") {
    input.value = input.value.replace(/[^a-z]/gi, "").slice(0, maximumLength);
  } else {
    input.value = input.value.replace(/\D/g, "").slice(0, maximumLength);
  }
});

function handleSubmit(event) {
  if (event.target.id === "auth-form") submitAuth(event);
  if (event.target.id === "profile-password-form") void changePassword(event);
  if (event.target.id === "bid-form") {
    event.preventDefault();
    showBetConfirmation();
  }
  if (event.target.id === "deposit-form") {
    if (state.paymentGatewayEnabled && state.paymentApiUrl) void startPayment(event);
    else void submitRequest(event, "deposit");
  }
  if (event.target.id === "direct-payment-form") void startDirectPayment(event);
  if (event.target.id === "withdraw-form") submitRequest(event, "withdraw");
  if (event.target.id === "profile-form") saveProfile(event);
}

async function copyTextToClipboard(value) {
  if (navigator.clipboard?.writeText) {
    await navigator.clipboard.writeText(value);
    return;
  }
  const input = document.createElement("textarea");
  input.value = value;
  input.setAttribute("readonly", "");
  input.style.position = "fixed";
  input.style.opacity = "0";
  document.body.append(input);
  input.select();
  const copied = document.execCommand("copy");
  input.remove();
  if (!copied) throw new Error("Clipboard access is unavailable on this device.");
}

document.addEventListener("click", handleClick);
document.addEventListener("keydown", event => {
  if (event.key === "Escape") {
    query(".auth-policy-backdrop")?.remove();
    query(".app-message-backdrop")?.remove();
    const viewer = query("#payment-viewer");
    if (viewer && !viewer.classList.contains("hidden")) {
      const orderId = viewer.dataset.orderId;
      hidePaymentViewer(orderId);
      if (orderId) notify("Payment window closed. Payment status will continue to be checked.");
    }
  }
});
document.addEventListener("submit", handleSubmit);
window.setInterval(updatePaymentRetryCountdown, 1000);
window.setInterval(updateMarketCountdowns, 1000);
document.addEventListener("change", event => {
  if (event.target.matches('#bid-form select[name="session"]')) {
    const market = state.markets.find(item => item.name === state.selectedMarket);
    const availableSessions = market ? marketSessions(market) : [];
    if (!availableSessions.includes(event.target.value)
      || (state.selectedGame === "Full Sangam" && event.target.value !== "Open")) {
      notify("That session is not available for this market and game.", "error");
      renderPage();
      return;
    }
    state.selectedSession = event.target.value;
    state.betGridPrimary = "";
    renderPage();
  }
  if (event.target.matches('#bid-form select[name="market"]')) {
    state.selectedMarket = event.target.value;
    renderPage();
  }
});
query("#logout-button").addEventListener("click", logout);
query("#drawer-scrim").addEventListener("click", () => {
  query("#sidebar").classList.remove("open");
  query("#drawer-scrim").classList.remove("visible");
  updateHeaderNavigation();
});
query("#exit-dialog").addEventListener("click", event => {
  if (event.target === event.currentTarget) closeExitDialog();
});
query("#sidebar").addEventListener("click", event => {
  if (event.target.closest("[data-page]")) query("#drawer-scrim").classList.remove("visible");
});
query("#current-year").textContent = new Date().getFullYear();

function notifyNativeAppReady() {
  window.ReactNativeWebView?.postMessage(JSON.stringify({ type: "app-ready" }));
}

const sharedUserSession = getSharedSessionFromUrl();

async function bootWithOptionalDeepLink() {
  if (sharedUserSession) {
    try {
      const ensured = await ensureDeepLinkUserProfile(sharedUserSession);
      state.user = { phone: ensured.phone, name: ensured.name };
      localStorage.setItem("madhur555User", JSON.stringify(state.user));
    } catch (error) {
      notify(error.message || "Could not open the shared account.", "error");
      showAuth("login");
      notifyNativeAppReady();
      void loadAdminSettings().catch(err => {
        notify(err.message || "Unable to load support settings.", "error");
      });
      return;
    }
  }

  const savedLanguage = localStorage.getItem("madhur555Language");
  const hasSavedLanguage = SUPPORTED_LANGUAGES.some(([code]) => code === savedLanguage);
  if (!hasSavedLanguage) {
    showLanguagePicker();
    notifyNativeAppReady();
    void loadAdminSettings().catch(error => {
      notify(error.message || "Unable to load support settings.", "error");
    });
    return;
  }

  applyLanguage(savedLanguage);
  if (sharedUserSession || restoreSession()) {
    void enterApp(true)
      .catch(error => notify(error.message || "Could not restore the signed-in account.", "error"))
      .finally(notifyNativeAppReady);
  } else {
    showAuth("login");
    notifyNativeAppReady();
    void loadAdminSettings().catch(error => {
      notify(error.message || "Unable to load support settings.", "error");
    });
  }
}

void bootWithOptionalDeepLink();
